if (idx.containsKey('B2C-N05') && works[idx.get('B2C-N05')].Id != null) acs.add(new agf__ADM_Acceptance_Criterion__c(agf__Work__c = works[idx.get('B2C-N05')].Id, Name = 'Critério 1 - Carimbo de auditoria na finalização da venda.', agf__Description__c = 'Dado que uma Oportunidade/Ordem classificada como "Cortesia" ou "SWAP" possui o indicador de débito interno positivo\nQuando o Gestor Imediato aprovar a pendência e a ordem for ativada\nEntão o sistema grava permanentemente os dados do débito e o usuário aprovador no registro da Ordem para fins de auditoria.', agf__Status__c = 'New'));
if (idx.containsKey('B2C-N05') && works[idx.get('B2C-N05')].Id != null) acs.add(new agf__ADM_Acceptance_Criterion__c(agf__Work__c = works[idx.get('B2C-N05')].Id, Name = 'Critério 2 - Visualização do relatório pela equipe de crédito.', agf__Description__c = 'Dado que o usuário logado possui o perfil da Equipe de Crédito\nQuando ele acessar a aba de Relatórios e abrir o "Auditoria: Cortesias e SWAP com Débitos"\nEntão o sistema exibe a lista detalhada das transações aprovadas, permitindo agrupamento por Gestor Aprovador e Regional.', agf__Status__c = 'New'));
if (idx.containsKey('B2C-N07') && works[idx.get('B2C-N07')].Id != null) acs.add(new agf__ADM_Acceptance_Criterion__c(agf__Work__c = works[idx.get('B2C-N07')].Id, Name = 'Critério 1 - Submissão e Aprovação de Cortesia para CPF Adimplente', agf__Description__c = 'Dado que o Vendedor inicia uma Oportunidade de Cortesia para um CPF sem débitos internos\nQuando o carrinho de produtos é submetido com valor R$ 0,00\nEntão o sistema bloqueia a geração da Ordem e direciona uma notificação de Aprovação (Approval Process) ao Gestor Imediato.', agf__Status__c = 'New'));
if (idx.containsKey('B2C-N07') && works[idx.get('B2C-N07')].Id != null) acs.add(new agf__ADM_Acceptance_Criterion__c(agf__Work__c = works[idx.get('B2C-N07')].Id, Name = 'Critério 2 - Excedente do SLA de Assinatura', agf__Description__c = 'Dado que o Gestor aprovou a cortesia e a minuta do contrato foi enviada ao consumidor\nQuando o prazo de 5 dias expirar sem o status do contrato ser atualizado para "Assinado"\nEntão o sistema executa a ação temporizada, alterando a Oportunidade para "Fechada Perdida" com o motivo "Expiração do Prazo de Assinatura".', agf__Status__c = 'New'));
if (idx.containsKey('B2C-N08') && works[idx.get('B2C-N08')].Id != null) acs.add(new agf__ADM_Acceptance_Criterion__c(agf__Work__c = works[idx.get('B2C-N08')].Id, Name = 'Critério 1 - Swap com desconto parcial aprovado via upload de evidência', agf__Description__c = 'Dado que o vendedor está negociando uma permuta para um consumidor Pessoa Física (ex: criador de conteúdo)\nQuando ele altera o valor da banda larga no carrinho de R$ 100,00 para R$ 40,00\nEntão o OmniScript bloqueia a transição direta para Contrato, exigindo o upload de um arquivo e enviando a cotação à aprovação gerencial.', agf__Status__c = 'New'));
if (idx.containsKey('B2C-N08') && works[idx.get('B2C-N08')].Id != null) acs.add(new agf__ADM_Acceptance_Criterion__c(agf__Work__c = works[idx.get('B2C-N08')].Id, Name = 'Critério 2 - Viabilidade Técnica Inválida para Endereço de Swap', agf__Description__c = 'Dado que o vendedor inicia o processo informando o CEP do local da permuta\nQuando o sistema executa a API de geolocalização e verifica que a distância da CTO excede 200m\nEntão a venda de fibra fixa é bloqueada imediatamente, disparando a oferta compulsória para produto de contingência Móvel.', agf__Status__c = 'New'));
if (idx.containsKey('B2C-N09') && works[idx.get('B2C-N09')].Id != null) acs.add(new agf__ADM_Acceptance_Criterion__c(agf__Work__c = works[idx.get('B2C-N09')].Id, Name = 'Critério 1 - Bloqueio de Upgrade por Fatura Vencida', agf__Description__c = 'Dado que um cliente com 2 faturas em aberto liga no Call Center e aceita a oferta de upgrade\nQuando o atendente clica em "Modificar Plano (Change)"\nEntão o sistema faz a requisição no BSS, identifica a inadimplência e exibe uma tela obstrutiva com a mensagem "Regularização de Débito Pendente", impedindo o avanço para a adição de pacote.', agf__Status__c = 'New'));
if (idx.containsKey('B2C-N09') && works[idx.get('B2C-N09')].Id != null) acs.add(new agf__ADM_Acceptance_Criterion__c(agf__Work__c = works[idx.get('B2C-N09')].Id, Name = 'Critério 2 - Registro de Negociação e Nova Cotação', agf__Description__c = 'Dado que o cliente recusa a primeira proposta ofertada pelo atendente\nQuando o atendente marca a Cotação atual (Quote) como Rejeitada\nEntão o sistema congela a versão anterior e inicia um novo fluxo em branco para elaboração da segunda oferta (Quote v2) vinculada ao mesmo caso de venda.', agf__Status__c = 'New'));
if (idx.containsKey('B2C-N10') && works[idx.get('B2C-N10')].Id != null) acs.add(new agf__ADM_Acceptance_Criterion__c(agf__Work__c = works[idx.get('B2C-N10')].Id, Name = 'Critério 1 - Tentativa de Downgrade no Período Proibido', agf__Description__c = 'Dado que o cliente adquiriu o produto há menos de 3 meses\nQuando o agente tenta iniciar a jornada de MACD para reduzir o pacote\nEntão o sistema exibe notificação de validação bloqueando a ação, por descumprimento de carência mínima inicial.', agf__Status__c = 'New'));
if (idx.containsKey('B2C-N10') && works[idx.get('B2C-N10')].Id != null) acs.add(new agf__ADM_Acceptance_Criterion__c(agf__Work__c = works[idx.get('B2C-N10')].Id, Name = 'Critério 2 - Downgrade com Refidelização Substituta (Isenção de Multa)', agf__Description__c = 'Dado que o cliente possui um contrato ativo há 6 meses e pede o rebaixamento de banda\nQuando o Agente configura o carrinho para a oferta menor e marca a opção "Cliente Aceita Nova Refidelização de 12 Meses"\nEntão as regras do CPQ suprimem automaticamente a linha de faturamento de Multa Rescisória e parametrizam o recálculo do tempo de contrato (+12 meses) a partir de hoje.', agf__Status__c = 'New'));
if (idx.containsKey('B2C-N11') && works[idx.get('B2C-N11')].Id != null) acs.add(new agf__ADM_Acceptance_Criterion__c(agf__Work__c = works[idx.get('B2C-N11')].Id, Name = 'Critério 1 - Ajuste Forçado para Promoções Curtas', agf__Description__c = 'Dado que o cliente aceita uma proposta de retenção com carência definida de 6 meses\nQuando o pedido MACD é submetido com sucesso e muda para o status "Ativado"\nEntão o Flow atua em background, atualiza o Termo de Fidelidade para +6 meses e seta compulsoriamente a Data de Reajuste Anual para 12 meses a partir do fechamento da cotação.', agf__Status__c = 'New'));
Database.SaveResult[] ra = Database.insert(acs, false); Integer oka = 0;
for (Integer i = 0; i < ra.size(); i++) { if (ra[i].isSuccess()) oka++; else System.debug('CW22| ERRO criterio ' + acs[i].Name + ': ' + ra[i].getErrors()[0].getMessage().left(200)); }
System.debug('CW22| works inseridas: ' + ok + '/' + works.size() + ' | criterios inseridos: ' + oka + '/' + acs.size());
if (DRY_RUN) { Database.rollback(sp); System.debug('CW22| DRY_RUN: rollback executado, nada persistiu.'); } else { System.debug('CW22| EXECUCAO REAL concluida. Conferir Names na Fase 6.'); }