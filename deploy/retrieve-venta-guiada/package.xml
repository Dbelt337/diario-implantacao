    </types>
    <types>
        <members>*</members>
        <name>GlobalValueSet</name>
    </types>

    <!-- ================= PERMISSOES E INTEGRACAO ================= -->

    <types>
        <members>*</members>
        <name>PermissionSet</name>
    </types>
