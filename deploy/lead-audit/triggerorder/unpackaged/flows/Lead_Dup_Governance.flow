<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <customErrors>
        <name>Bloquear_Creacion</name>
        <label>Bloquear Creacion</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Este cliente ya es un cliente potencial activo de otro consultor. No es posible crear un registro duplicado durante el periodo de exclusividad. El propietario actual ha sido notificado de su intento de contacto.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Debe_Evaluar</name>
        <label>Debe Evaluar</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Bypass (sin llave)</defaultConnectorLabel>
        <rules>
            <name>Evaluar</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>temBypass</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Phone</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Duplicado</targetReference>
            </connector>
            <label>Evaluar</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dup_Es_mio</name>
        <label>Dup Es mio</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Propietario_Duplicado</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>De otro usuario</defaultConnectorLabel>
        <rules>
            <name>Es_mio</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Duplicado.OwnerId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$User.Id</elementReference>
                </rightValue>
            </conditions>
            <label>Es mio (criterio 1 - permite)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Evalua_fecha_y_responsable</name>
        <label>Evalúa fecha y responsable</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Evalua_rol_creador</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Dentro de plazo</defaultConnectorLabel>
        <rules>
            <name>No_es_el_usuario</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Propietario_Duplicado</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>El propietario no es el usuario (cola)</label>
        </rules>
        <rules>
            <name>Fuera_Dd_Plazo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>expirou</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Fuera de Plazo (expiro)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Evalua_rol_creador</name>
        <label>Evalúa el rol de creador</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Publicar_Evento</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Creador online (bloquea)</defaultConnectorLabel>
        <rules>
            <name>Creador_Showroom</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>criadorOnline</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Registrar_Transferencia</targetReference>
            </connector>
            <label>Creador showroom (permite + transfiere)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Hay_duplicado</name>
        <label>Hay duplicado</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Sin duplicado (permite)</defaultConnectorLabel>
        <rules>
            <name>Existe_Dup</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Duplicado</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Dup_Es_mio</targetReference>
            </connector>
            <label>Existe duplicado</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>criadorOnline</name>
        <dataType>Boolean</dataType>
        <expression>{!$User.VendedorOnline__c}</expression>
    </formulas>
    <formulas>
        <name>expirou</name>
        <dataType>Boolean</dataType>
        <expression>TODAY() &gt; ADDMONTHS(
IF(ISBLANK({!Get_Duplicado.LastActivityDate}), DATEVALUE({!Get_Duplicado.CreatedDate}), {!Get_Duplicado.LastActivityDate}),
IF({!Propietario_Duplicado.VendedorOnline__c}, 6, 3))</expression>
    </formulas>
    <formulas>
        <name>nomeLead</name>
        <dataType>String</dataType>
        <expression>TRIM(BLANKVALUE({!$Record.FirstName}, &quot;&quot;) &amp; &quot; &quot; &amp; BLANKVALUE({!$Record.LastName}, &quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>temBypass</name>
        <dataType>Boolean</dataType>
        <expression>{!$Permission.BypassLeadDupGovernance}</expression>
    </formulas>
    <interviewLabel>Lead_Dup_Governance {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead_Dup_Governance</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Log_Falla</name>
        <label>Log Falla</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Fallo de gobernanza de duplicados de clientes potenciales (US-009) – cliente potencial permitido por la seguridad</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>Publicar_Evento</name>
        <label>Publicar Evento</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Bloquear_Creacion</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Falla</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>AttemptedByUserId__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ExistingLeadId__c</field>
            <value>
                <elementReference>Get_Duplicado.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ExistingOwnerId__c</field>
            <value>
                <elementReference>Get_Duplicado.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LeadEmail__c</field>
            <value>
                <elementReference>$Record.Email</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LeadName__c</field>
            <value>
                <elementReference>nomeLead</elementReference>
            </value>
        </inputAssignments>
        <object>LeadContactAttempt__e</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Duplicado</name>
        <label>Get Duplicado</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Hay_duplicado</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Falla</targetReference>
        </faultConnector>
        <filterLogic>1 AND 2 AND 3 AND 4 AND ((5 AND 6) OR (7 AND 8))</filterLogic>
        <filters>
            <field>CompanyCode__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CompanyCode__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Brand__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Brand__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Brand__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Email</elementReference>
            </value>
        </filters>
        <filters>
            <field>Email</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Phone</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Phone</elementReference>
            </value>
        </filters>
        <filters>
            <field>Phone</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Propietario_Duplicado</name>
        <label>Propietario Duplicado</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Evalua_fecha_y_responsable</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Falla</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Duplicado.OwnerId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Registrar_Transferencia</name>
        <label>Registrar Transferencia</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Log_Falla</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>DuplicateLead__c</field>
            <value>
                <elementReference>Get_Duplicado.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>TransferDate__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>TransferredFromOnlineConsultant__c</field>
            <value>
                <elementReference>Get_Duplicado.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Debe_Evaluar</targetReference>
        </connector>
        <object>Lead</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <triggerOrder>10</triggerOrder>
    <status>Active</status>
</Flow>
