<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <constants>
        <name>PrefijoCola</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Queue_Vendedores_</stringValue>
        </value>
    </constants>
    <constants>
        <name>VentanaDias</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>5.0</numberValue>
        </value>
    </constants>
    <decisions>
        <name>Asset_Encontrado</name>
        <label>Asset Encontrado</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Lead_Anterior</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Hay_Asset</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Asset</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Log_Asset</targetReference>
            </connector>
            <label>Hay Asset</label>
        </rules>
    </decisions>
    <decisions>
        <name>Avalia_Unificacion</name>
        <label>Avalia Unificacion</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No es candidato</defaultConnectorLabel>
        <rules>
            <name>Candidato</name>
            <conditionLogic>1 AND 2 AND 3</conditionLogic>
            <conditions>
                <leftValueReference>Get_LineItem_Prev</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_LineItem_New.ProductId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_LineItem_Prev.ProductId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>dentroJanela</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Marcar_Candidato</targetReference>
            </connector>
            <label>Misma pieza dentro de la ventana</label>
        </rules>
    </decisions>
    <decisions>
        <name>Cola_Encontrada</name>
        <label>Cola Encontrada</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Tiene_VIN</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sin cola (no asigna)</defaultConnectorLabel>
        <rules>
            <name>Hay_Cola</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Cola_Pais</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asignar_Cola</targetReference>
            </connector>
            <label>Hay cola</label>
        </rules>
    </decisions>
    <decisions>
        <name>Es_Repuestos</name>
        <label>Es Repuestos</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No es Repuestos/PA</defaultConnectorLabel>
        <rules>
            <name>Es_Parte_o_Accesorio</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>Get_LineItem_New.ItemType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Part</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_LineItem_New.ItemType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accessory</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sin_Brand</targetReference>
            </connector>
            <label>Es Parte o Accesorio</label>
        </rules>
    </decisions>
    <decisions>
        <name>Sin_Brand</name>
        <label>Sin Brand</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Tiene_VIN</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Con marca (rutea Omni)</defaultConnectorLabel>
        <rules>
            <name>Sin_Marca</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Brand__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Cola_Pais</targetReference>
            </connector>
            <label>Sin marca (fallback por Sociedad)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tem_Anterior</name>
        <label>Tem Anterior</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Sin lead anterior</defaultConnectorLabel>
        <rules>
            <name>Existe_Anterior</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead_Anterior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_LineItem_Prev</targetReference>
            </connector>
            <label>Existe anterior</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tiene_LineItem</name>
        <label>Tiene LineItem</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Sin LineItem</defaultConnectorLabel>
        <rules>
            <name>Hay_LineItem</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_LineItem_New</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Es_Repuestos</targetReference>
            </connector>
            <label>Hay LineItem</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tiene_VIN</name>
        <label>Tiene VIN</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Lead_Anterior</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sin VIN</defaultConnectorLabel>
        <rules>
            <name>Hay_VIN</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_LineItem_New.AssetIdentificationNumber</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Vehicle</targetReference>
            </connector>
            <label>Hay VIN</label>
        </rules>
    </decisions>
    <decisions>
        <name>Vehiculo_Encontrado</name>
        <label>Vehiculo Encontrado</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Asset</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No (intenta Asset)</defaultConnectorLabel>
        <rules>
            <name>Hay_Vehiculo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Vehicle</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Log_Vehiculo</targetReference>
            </connector>
            <label>Hay Vehiculo</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>dentroJanela</name>
        <dataType>Boolean</dataType>
        <expression>(TODAY() - DATEVALUE({!Get_Lead_Anterior.CreatedDate})) &lt; {!VentanaDias}</expression>
    </formulas>
    <formulas>
        <name>descAsset</name>
        <dataType>String</dataType>
        <expression>&quot;Cotizacion vinculada a Asset &quot; &amp; {!Get_Asset.Id} &amp; &quot; por coincidencia de VIN/Serial &quot; &amp; {!Get_LineItem_New.AssetIdentificationNumber}</expression>
    </formulas>
    <formulas>
        <name>descVehiculo</name>
        <dataType>String</dataType>
        <expression>&quot;Cotizacion vinculada a Vehicle &quot; &amp; {!Get_Vehicle.Id} &amp; &quot; por coincidencia de VIN &quot; &amp; {!Get_LineItem_New.AssetIdentificationNumber}</expression>
    </formulas>
    <formulas>
        <name>queueDevName</name>
        <dataType>String</dataType>
        <expression>{!PrefijoCola} &amp; CASE(LEFT(TEXT({!$Record.CompanyCode__c}), 1), &quot;C&quot;, &quot;CR&quot;, &quot;G&quot;, &quot;GT&quot;, &quot;H&quot;, &quot;HN&quot;, &quot;N&quot;, &quot;NI&quot;, &quot;P&quot;, &quot;PA&quot;, &quot;S&quot;, &quot;SV&quot;, &quot;&quot;)</expression>
    </formulas>
    <interviewLabel>GQ_Lead_Repuestos_Reasignacion_y_Cotizacion {!$Flow.CurrentDateTime}</interviewLabel>
    <label>GQ_Lead_Repuestos_Reasignacion_y_Cotizacion</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Log_Asset</name>
        <label>Log Asset</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Lead_Anterior</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Get_Lead_Anterior</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>descAsset</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Cotizacion vinculada a Asset por VIN</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>Log_Falha</name>
        <label>Log Falha</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Falha em GQ_Lead_Repuestos_Reasignacion_y_Cotizacion (US-005) - lead mantido</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>Log_Vehiculo</name>
        <label>Log Vehiculo</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Lead_Anterior</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Get_Lead_Anterior</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>descVehiculo</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Cotizacion vinculada a Vehicle por VIN</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Asset</name>
        <label>Get Asset</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Asset_Encontrado</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Get_Lead_Anterior</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SerialNumber</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_LineItem_New.AssetIdentificationNumber</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Asset</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Cola_Pais</name>
        <label>Get Cola Pais</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Cola_Encontrada</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Tiene_VIN</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>queueDevName</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Lead_Anterior</name>
        <label>Get Lead Anterior</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Tem_Anterior</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>1 AND ((2 AND 3) OR (4 AND 5))</filterLogic>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Email</elementReference>
            </value>
        </filters>
        <filters>
            <field>Email</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>MobilePhone</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.MobilePhone</elementReference>
            </value>
        </filters>
        <filters>
            <field>MobilePhone</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_LineItem_New</name>
        <label>Get LineItem New</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Tiene_LineItem</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LeadId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>LeadLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_LineItem_Prev</name>
        <label>Get LineItem Prev</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Avalia_Unificacion</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LeadId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Lead_Anterior.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>LeadLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Vehicle</name>
        <label>Get Vehicle</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Vehiculo_Encontrado</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Get_Lead_Anterior</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>VehicleIdentificationNumber</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_LineItem_New.AssetIdentificationNumber</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vehicle</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Asignar_Cola</name>
        <label>Asignar Cola</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Tiene_VIN</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Tiene_VIN</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Get_Cola_Pais.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Marcar_Candidato</name>
        <label>Marcar Candidato</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>UnifiedFromLeadId__c</field>
            <value>
                <elementReference>Get_Lead_Anterior.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <object>Lead</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Get_LineItem_New</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <triggerOrder>20</triggerOrder>
    <status>Active</status>
</Flow>
