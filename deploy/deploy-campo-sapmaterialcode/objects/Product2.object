<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>SapMaterialCode__c</fullName>
        <label>SAP Material Code</label>
        <type>Text</type>
        <length>18</length>
        <unique>true</unique>
        <caseSensitive>false</caseSensitive>
        <externalId>true</externalId>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <description>All countries. SAP material number (MATNR). Unique External ID: the database guarantees a single Product2 per material, and Database/REST upsert on this field is atomic — concurrent creations converge on the same record. Upsert key for the MuleSoft catalog replication (SAP to Salesforce) and for the in-flow material creation (US-021). Also used as the parent reference key when creating PricebookEntry records from the replication.</description>
        <inlineHelpText>Material number in SAP (MATNR). Populated by the integration; do not edit manually.</inlineHelpText>
    </fields>
</CustomObject>
