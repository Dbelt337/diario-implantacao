<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>SapMaterialCode__c</fullName>
        <label>Código de material SAP</label>
        <type>Text</type>
        <length>18</length>
        <unique>true</unique>
        <caseSensitive>false</caseSensitive>
        <externalId>true</externalId>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <description>MATNR de SAP. Único + External ID: la base de datos garantiza un solo Product2 por material (Database.upsert por este campo es atómico — dos creaciones simultáneas convergen en el mismo registro). Clave de la réplica de catálogo MuleSoft y de la creación US-021.</description>
        <inlineHelpText>Código del material en SAP (MATNR). Lo llena la integración; no editar a mano.</inlineHelpText>
    </fields>
</CustomObject>
