<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <decisions>
        <name>OpportunityFound</name>
        <label>Activity linked to an Opportunity?</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <defaultConnectorLabel>No Opportunity (exit)</defaultConnectorLabel>
        <rules>
            <name>YesOpportunity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetOpportunity.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetBranchGroup</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>BranchGroupFound</name>
        <label>Branch public group exists?</label>
        <locationX>176</locationX>
        <locationY>384</locationY>
        <defaultConnector>
            <targetReference>LogMissingBranchGroup</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Missing (log and continue)</defaultConnectorLabel>
        <rules>
            <name>YesGroup</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetBranchGroup.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CreateOpportunityShare</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>AdvisorAlreadyStamped</name>
        <label>OriginatingDigitalAdvisor already stamped?</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <defaultConnector>
            <targetReference>StampAdvisorAndPending</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Blank (first time: stamp advisor)</defaultConnectorLabel>
        <rules>
            <name>YesStamped</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetOpportunity.OriginatingDigitalAdvisor__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetPendingReception</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>GQ.AUT.HU009.B v3 (EN naming per GRPQM conventions): when an in-person activity linked to an Opportunity gets a BranchCode, shares the Opp with the branch public group (GRP_Sucursal_[code], code = Event.BranchCode__c per canonical table), access Read, RowCause Manual — the Manual share is NATIVELY deleted when the Owner changes (Recibir Cliente), which is the automatic cleanup required by the refinement. Also stamps OriginatingDigitalAdvisor__c (current Owner, first time only, immutable afterwards) and sets HandOffStatus__c = Pendiente Recepcion. Missing group => log Task and continue. HandOffDate__c is NOT set here: Recibir Cliente (Part C) sets it. TECHNICAL NOTE: $Record formulas do not resolve custom activity fields (Activity entity) in Event-triggered flows — entry uses plain filters (StartsWith 006) and the group name is built with a text template, not a formula.</description>
    <environments>Default</environments>
    <interviewLabel>Event_AfterSave_ShareBranchHandOff {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Event_AfterSave_ShareBranchHandOff</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>CreateOpportunityShare</name>
        <label>Share Opp with the branch group</label>
        <locationX>176</locationX>
        <locationY>492</locationY>
        <connector>
            <targetReference>AdvisorAlreadyStamped</targetReference>
        </connector>
        <faultConnector>
            <targetReference>LogShareFault</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>OpportunityId</field>
            <value>
                <elementReference>GetOpportunity.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>UserOrGroupId</field>
            <value>
                <elementReference>GetBranchGroup.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OpportunityAccessLevel</field>
            <value>
                <stringValue>Read</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RowCause</field>
            <value>
                <stringValue>Manual</stringValue>
            </value>
        </inputAssignments>
        <object>OpportunityShare</object>
    </recordCreates>
    <recordCreates>
        <name>LogMissingBranchGroup</name>
        <label>Log: branch group missing</label>
        <locationX>440</locationX>
        <locationY>492</locationY>
        <connector>
            <targetReference>AdvisorAlreadyStamped</targetReference>
        </connector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>HU-009: branch public group missing (create GRP_Sucursal_[code])</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>groupDevName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>GetOpportunity.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>LogShareFault</name>
        <label>Log: share creation failed</label>
        <locationX>440</locationX>
        <locationY>600</locationY>
        <connector>
            <targetReference>AdvisorAlreadyStamped</targetReference>
        </connector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>HU-009: sharing the Opportunity with the branch failed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>GetOpportunity.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>GetOpportunity</name>
        <label>Get Opportunity</label>
        <locationX>176</locationX>
        <locationY>60</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>OpportunityFound</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhatId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>OwnerId</queriedFields>
        <queriedFields>OriginatingDigitalAdvisor__c</queriedFields>
        <queriedFields>HandOffStatus__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetBranchGroup</name>
        <label>Get branch public group</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>BranchGroupFound</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>groupDevName</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Regular</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>StampAdvisorAndPending</name>
        <label>Stamp digital advisor + Pendiente Recepción</label>
        <locationX>50</locationX>
        <locationY>708</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GetOpportunity.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>OriginatingDigitalAdvisor__c</field>
            <value>
                <elementReference>GetOpportunity.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>HandOffStatus__c</field>
            <value>
                <stringValue>Pendiente Recepción</stringValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>SetPendingReception</name>
        <label>Pendiente Recepción (advisor already stamped)</label>
        <locationX>300</locationX>
        <locationY>708</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GetOpportunity.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>HandOffStatus__c</field>
            <value>
                <stringValue>Pendiente Recepción</stringValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetOpportunity</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>BranchCode__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>WhatId</field>
            <operator>StartsWith</operator>
            <value>
                <stringValue>006</stringValue>
            </value>
        </filters>
        <object>Event</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>groupDevName</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>GRP_Sucursal_{!$Record.BranchCode__c}</text>
    </textTemplates>
    <triggerOrder>10</triggerOrder>
</Flow>
