<?xml version="1.0" encoding="UTF-8"?>
<!-- US-006a: bloqueia SO edicao direta de datos sensibles por quem nao tem bypass.
     Exceto: circuito (status->Completed), CanEditSensitiveAccountFields, Bypass_Gates_Automacao (integracoes/automacoes). -->
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>Bloquear_Edicion_Datos_Sensibles</fullName>
        <active>true</active>
        <description>Bloquea edicion DIRECTA de Nombre/Documento/Email por usuarios sin bypass. Exento: apply (status Completed), CanEditSensitiveAccountFields, Bypass_Gates_Automacao (integraciones/otros flows).</description>
        <errorConditionFormula>AND(
  OR(
    ISCHANGED(Name),
    ISCHANGED(DocumentType__c),
    ISCHANGED(DocumentNumber__c),
    ISCHANGED(ElectronicBillingEmail__c)
  ),
  NOT( AND( ISCHANGED(SensitiveChangeStatus__c), ISPICKVAL(SensitiveChangeStatus__c, "Completed") ) ),
  NOT( $Permission.CanEditSensitiveAccountFields ),
  NOT( $Permission.Bypass_Gates_Automacao )
)</errorConditionFormula>
        <errorMessage>Los datos sensibles (Nombre / Tipo y Número de Documento / Correo de factura electrónica) solo pueden modificarse mediante el flujo &quot;Modificar Datos Sensibles&quot; con aprobación. No es posible editarlos directamente.</errorMessage>
    </validationRules>
</CustomObject>
