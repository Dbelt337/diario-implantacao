<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>MDG Datos Sensibles - Acceso Flow</label>
    <description>Vendedor: edita campos STAGING (propoe cambio) + le reales/credito. NAO edita campos reales (governanca). NAO incluye CanEditSensitiveAccountFields.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <!-- STAGING: edit (o screen flow grava em contexto de usuario) -->
    <fieldPermissions><field>Account.ProposedName__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Account.ProposedDocumentType__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Account.ProposedDocumentNumber__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Account.ProposedElectronicBillingEmail__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Account.SensitiveChangeStatus__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Account.SensitiveChangeReason__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Account.SensitiveChangeRequestedBy__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Account.SensitiveChangeRequestedDate__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Account.SensitiveChangeApprover__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <!-- REALES + credito/sociedad: read-only (governanca: nao edita direto) -->
    <fieldPermissions><field>Account.DocumentType__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Account.DocumentNumber__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Account.ElectronicBillingEmail__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Account.CreditScenario__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Account.Sociedad__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
</PermissionSet>
