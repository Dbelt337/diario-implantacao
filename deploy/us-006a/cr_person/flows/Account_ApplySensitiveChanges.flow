<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Aplica los cambios de datos sensibles aprobados. Business -> Name; Person Account -> FirstName/LastName (parte el ProposedName). Doc/email compartidos.</description>
    <interviewLabel>Account_ApplySensitiveChanges {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - Aplicar Cambios Sensibles Aprobados</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <environments>Default</environments>
    <formulas>
        <name>fApplyName</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.ProposedName__c}), {!$Record.Name}, {!$Record.ProposedName__c})</expression>
    </formulas>
    <formulas>
        <name>fApplyDocType</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK(TEXT({!$Record.ProposedDocumentType__c})), TEXT({!$Record.DocumentType__c}), TEXT({!$Record.ProposedDocumentType__c}))</expression>
    </formulas>
    <formulas>
        <name>fApplyDocNumber</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.ProposedDocumentNumber__c}), {!$Record.DocumentNumber__c}, {!$Record.ProposedDocumentNumber__c})</expression>
    </formulas>
    <formulas>
        <name>fApplyBillingEmail</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.ProposedElectronicBillingEmail__c}), {!$Record.ElectronicBillingEmail__c}, {!$Record.ProposedElectronicBillingEmail__c})</expression>
    </formulas>
    <formulas>
        <name>fApplyFirstName</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.ProposedName__c}), {!$Record.FirstName},
IF(FIND(&quot; &quot;, {!$Record.ProposedName__c}) &gt; 0, LEFT({!$Record.ProposedName__c}, FIND(&quot; &quot;, {!$Record.ProposedName__c}) - 1), &quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>fApplyLastName</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.ProposedName__c}), {!$Record.LastName},
IF(FIND(&quot; &quot;, {!$Record.ProposedName__c}) &gt; 0, TRIM(MID({!$Record.ProposedName__c}, FIND(&quot; &quot;, {!$Record.ProposedName__c}) + 1, 255)), {!$Record.ProposedName__c}))</expression>
    </formulas>
    <start>
        <locationX>0</locationX><locationY>0</locationY>
        <connector><targetReference>Es_Person_Account</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SensitiveChangeStatus__c</field>
            <operator>EqualTo</operator>
            <value><stringValue>Approved</stringValue></value>
        </filters>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <decisions>
        <name>Es_Person_Account</name>
        <label>Es Person Account?</label>
        <locationX>0</locationX><locationY>0</locationY>
        <defaultConnector><targetReference>Aplicar_Cambios</targetReference></defaultConnector>
        <defaultConnectorLabel>Business (Name)</defaultConnectorLabel>
        <rules>
            <name>Es_Person</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IsPersonAccount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Aplicar_Person</targetReference></connector>
            <label>Person (First/Last)</label>
        </rules>
    </decisions>
    <assignments>
        <name>Aplicar_Cambios</name>
        <label>Aplicar (Business - Name)</label>
        <locationX>0</locationX><locationY>0</locationY>
        <connector><targetReference>Limpiar_Staging</targetReference></connector>
        <assignmentItems><assignToReference>$Record.Name</assignToReference><operator>Assign</operator><value><elementReference>fApplyName</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>$Record.DocumentType__c</assignToReference><operator>Assign</operator><value><elementReference>fApplyDocType</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>$Record.DocumentNumber__c</assignToReference><operator>Assign</operator><value><elementReference>fApplyDocNumber</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>$Record.ElectronicBillingEmail__c</assignToReference><operator>Assign</operator><value><elementReference>fApplyBillingEmail</elementReference></value></assignmentItems>
    </assignments>
    <assignments>
        <name>Aplicar_Person</name>
        <label>Aplicar (Person - First/Last)</label>
        <locationX>0</locationX><locationY>0</locationY>
        <connector><targetReference>Limpiar_Staging</targetReference></connector>
        <assignmentItems><assignToReference>$Record.FirstName</assignToReference><operator>Assign</operator><value><elementReference>fApplyFirstName</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>$Record.LastName</assignToReference><operator>Assign</operator><value><elementReference>fApplyLastName</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>$Record.DocumentType__c</assignToReference><operator>Assign</operator><value><elementReference>fApplyDocType</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>$Record.DocumentNumber__c</assignToReference><operator>Assign</operator><value><elementReference>fApplyDocNumber</elementReference></value></assignmentItems>
        <assignmentItems><assignToReference>$Record.ElectronicBillingEmail__c</assignToReference><operator>Assign</operator><value><elementReference>fApplyBillingEmail</elementReference></value></assignmentItems>
    </assignments>
    <assignments>
        <name>Limpiar_Staging</name>
        <label>Limpiar staging + Completed</label>
        <locationX>0</locationX><locationY>0</locationY>
        <assignmentItems><assignToReference>$Record.ProposedName__c</assignToReference><operator>Assign</operator><value><stringValue></stringValue></value></assignmentItems>
        <assignmentItems><assignToReference>$Record.ProposedDocumentType__c</assignToReference><operator>Assign</operator><value><stringValue></stringValue></value></assignmentItems>
        <assignmentItems><assignToReference>$Record.ProposedDocumentNumber__c</assignToReference><operator>Assign</operator><value><stringValue></stringValue></value></assignmentItems>
        <assignmentItems><assignToReference>$Record.ProposedElectronicBillingEmail__c</assignToReference><operator>Assign</operator><value><stringValue></stringValue></value></assignmentItems>
        <assignmentItems><assignToReference>$Record.SensitiveChangeStatus__c</assignToReference><operator>Assign</operator><value><stringValue>Completed</stringValue></value></assignmentItems>
    </assignments>
</Flow>
