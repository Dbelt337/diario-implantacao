<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <description>GQ.AUT.US025.H2.ADM: before-save de Opportunity (banda 10) que estampa el RecordType por linea en el CREATE, cubriendo conversion de Lead, SFCC checkout, creacion manual y API (reemplaza el enfoque Lead_AS_EstampaRTOpp, que solo cubria conversion y generaba segundo save). Derivacion: TipoAutoQueVende__c del OWNER (no $User) = Motos -&gt; GQOpportunitiesMotos; default -&gt; GQOpportunitiesAutos (nunca no-op). DevNames tomados de la evidencia del org (flow activo actual), mapeo con la spec: GQOpportunitiesAutos=Venda_Veiculo, GQOpportunitiesMotos=Venda_Moto. Sin guard de RT explicito: el RT default del perfil ya es un GQOpportunities*, indistinguible de una eleccion manual. PENDIENTES MARCADOS (no construidos): brazo Venta_Mayorista por criterio B2B-revendedor (campo-criterio sin confirmar) y brazo Frota (criterio sin confirmar); brazo Repuestos EXCLUIDO por D-REP-01. RT no encontrado -&gt; sale sin estampar (null-check). Desactivar Lead_AS_EstampaRTOpp tras validar este flow.</description>
    <environments>Default</environments>
    <formulas>
        <name>RT_DevName</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!Get_Owner.TipoAutoQueVende__c}) = &quot;Motos&quot;,
  &quot;GQOpportunitiesMotos&quot;,
  &quot;GQOpportunitiesAutos&quot;)</expression>
    </formulas>
    <interviewLabel>Opp_BS_EstampaRT {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opp_BS_EstampaRT</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <assignments>
        <name>Estampar_RT</name>
        <label>Estampar RecordType</label>
        <locationX>176</locationX>
        <locationY>492</locationY>
        <assignmentItems>
            <assignToReference>$Record.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_RecordType.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>RT_Encontrado</name>
        <label>¿RecordType encontrado?</label>
        <locationX>176</locationX>
        <locationY>384</locationY>
        <defaultConnectorLabel>No encontrado (salir sin estampar)</defaultConnectorLabel>
        <rules>
            <name>Si_encontrado</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_RecordType.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Estampar_RT</targetReference>
            </connector>
            <label>Sí</label>
        </rules>
    </decisions>
    <recordLookups>
        <name>Get_Owner</name>
        <label>Obtener owner (TipoAutoQueVende)</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_RecordType</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>TipoAutoQueVende__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_RecordType</name>
        <label>Obtener RecordType destino</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>RT_Encontrado</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Opportunity</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>RT_DevName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Owner</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>10</triggerOrder>
</Flow>
