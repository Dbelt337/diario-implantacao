<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>PendingVisitFound</name>
        <label>Pending visit exists?</label>
        <locationX>176</locationX>
        <locationY>492</locationY>
        <defaultConnector>
            <targetReference>ConfirmationScreen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No visit (walk-in / Escenario 10)</defaultConnectorLabel>
        <rules>
            <name>YesVisit</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetPendingVisit.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>MarkVisitAttended</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>GQ.AUT.HU009.C v1.2 (v1.1 + cierre del Event y fault path): al recibir, la visita se CIERRA por completo — VisitStatus=Atendida + OwnerId del Event pasa al asesor presencial (la visita cae en SU calendario; el Event no tiene "closed" nativo como Task, el cierre del proceso es Atendida y la hora real del hand-off queda en HandOffDate__c de la Opp). DML con faultConnector a pantalla de error amigable (asesor inactivo, VR, etc.). Base v1.1: Recibir Cliente. Screen flow (quick action on Opportunity) run by the Recepcionista/Host when the customer physically arrives: picks the in-person advisor, the flow changes the Opportunity Owner, stamps HandOffDate and HandOffStatus=Recibido, and marks the pending visit Event as Atendida (if one exists - a spontaneous walk-in has none, Escenario 10). Runs in SYSTEM MODE WITHOUT SHARING on purpose: covers Escenario 10 (no prior share exists for a walk-in) and lets the recepcionista transfer ownership without Transfer Records permission. The native deletion of the Manual share on Owner change is the automatic access cleanup (Parte B contract). OriginatingDigitalAdvisor__c is NOT touched (immutable, commission traceability).</description>
    <environments>Default</environments>
    <interviewLabel>Recibir Cliente {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Recibir Cliente</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>GetPendingVisit</name>
        <label>Get pending visit Event</label>
        <locationX>176</locationX>
        <locationY>384</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>PendingVisitFound</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhatId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>VisitStatus__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pendiente</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Event</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>MarkVisitAttended</name>
        <label>Close visit: Atendida + transfer to in-person advisor</label>
        <locationX>50</locationX>
        <locationY>600</locationY>
        <connector>
            <targetReference>ConfirmationScreen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>ErrorScreen</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GetPendingVisit.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>PickAdvisor.recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>VisitStatus__c</field>
            <value>
                <stringValue>Atendida</stringValue>
            </value>
        </inputAssignments>
        <object>Event</object>
    </recordUpdates>
    <recordUpdates>
        <name>ReceiveCustomer</name>
        <label>Transfer Opp + stamp hand-off</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <connector>
            <targetReference>GetPendingVisit</targetReference>
        </connector>
        <faultConnector>
            <targetReference>ErrorScreen</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>HandOffDate__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>HandOffStatus__c</field>
            <value>
                <stringValue>Recibido</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>PickAdvisor.recordId</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <screens>
        <name>ConfirmationScreen</name>
        <label>Cliente recibido</label>
        <locationX>176</locationX>
        <locationY>708</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>DoneText</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Cliente recibido.&lt;/b&gt; La oportunidad fue transferida al asesor presencial y el hand-off quedó registrado (fecha y estado Recibido). Si existía una visita pendiente, quedó marcada como Atendida.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>ErrorScreen</name>
        <label>No se pudo recibir al cliente</label>
        <locationX>440</locationX>
        <locationY>384</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>ErrorText</name>
            <fieldText>&lt;p&gt;&lt;b&gt;No se pudo completar la recepción.&lt;/b&gt; Verificá que el asesor seleccionado esté activo y volvé a intentar. Si el problema persiste, avisá al administrador con este detalle:&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>PickAdvisorScreen</name>
        <label>Recibir Cliente</label>
        <locationX>176</locationX>
        <locationY>60</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>ReceiveCustomer</targetReference>
        </connector>
        <fields>
            <name>IntroText</name>
            <fieldText>&lt;p&gt;El cliente llegó a la sucursal. Selecciona el &lt;b&gt;asesor presencial&lt;/b&gt; que lo atenderá: la oportunidad pasará a ser suya y el acceso temporal de la sucursal se limpiará automáticamente.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>PickAdvisor</name>
            <extensionName>flowruntime:lookup</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>fieldApiName</name>
                <value>
                    <stringValue>OwnerId</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>label</name>
                <value>
                    <stringValue>Asesor presencial</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>objectApiName</name>
                <value>
                    <stringValue>Opportunity</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>required</name>
                <value>
                    <booleanValue>true</booleanValue>
                </value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>PickAdvisorScreen</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
