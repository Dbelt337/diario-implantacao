<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>HU009_Visita_Requiere_Sucursal</fullName>
        <active>true</active>
        <description>GQ.AUT.HU009: Event vinculado a Opportunity es una visita del hand-off y requiere Sucursal (BranchCode__c) para compartir la Opp con el grupo de la sucursal. Cubre creación por calendario/API, donde el layout de la action no protege.</description>
        <errorConditionFormula>AND(
  LEFT(WhatId, 3) = &quot;006&quot;,
  ISBLANK(TEXT(BranchCode__c))
)</errorConditionFormula>
        <errorDisplayField>BranchCode__c</errorDisplayField>
        <errorMessage>Seleccioná la Sucursal de la visita: sin ella la sucursal no ve el hand-off y la recepción no puede recibir al cliente (HU-009).</errorMessage>
    </validationRules>
</CustomObject>
