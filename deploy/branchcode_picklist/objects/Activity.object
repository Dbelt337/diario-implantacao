    <fields>
        <fullName>BranchCode__c</fullName>
        <label>Sucursal</label>
        <type>Picklist</type>
        <description>HU-009 (all countries): canonical branch of the in-person activity (VENTAS branches only, see sucursales_canonicas). API value = canonical code, matching the public group GRP_Sucursal_[code] - the sharing flow contract. Advisor PICKS the branch (restricted picklist, no typing); for Test Drive the mirror flow sets it from the ServiceTerritory. New branch = new value here + new public group (governance gate).</description>
        <required>false</required>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
