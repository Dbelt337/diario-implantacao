<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">

    <!--
        Upsert key for the MuleSoft price integration.

        Salesforce already guarantees one PricebookEntry per product, price
        book and currency, so this field does not create the uniqueness: it
        exposes it as a single addressable value so the integration can push a
        price change over an existing entry without querying first.

        Value, built by the integration and never by hand:
            SapMaterialCode__c + '|' + PricebookCode__c + '|' + CurrencyIsoCode

        Two deliberate choices behind that shape.

        Anchored on SapMaterialCode__c and NOT on ProductCode, because
        ProductCode is not unique in Salesforce: two products can share the
        same code, which would make the key ambiguous exactly in the case the
        integration needs to cover.

        Built on the price book CODE and not on Pricebook2Id, because a
        Salesforce Id differs per org. A key carrying an Id cannot be promoted
        from INT to production without recomputation; this one is identical
        everywhere.
    -->

    <fields>
        <fullName>PriceKey__c</fullName>
        <label>Price Key</label>
        <type>Text</type>
        <length>80</length>
        <unique>true</unique>
        <caseSensitive>false</caseSensitive>
        <externalId>true</externalId>
        <required>false</required>
        <description>All countries. Upsert key for the price integration: SAP material code, price book code and currency, pipe separated. Contains no Salesforce Id, so the same payload runs in every environment. Populated by the integration only. Makes the price load idempotent and re-runnable.</description>
        <inlineHelpText>Integration key. Do not edit manually.</inlineHelpText>
    </fields>

</CustomObject>
