<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">

    <!--
        Upsert key for the MuleSoft price integration.

        Salesforce already guarantees one PricebookEntry per product, price
        book and currency, so this field does not create the uniqueness: it
        exposes it as a single addressable value so the integration can push
        prices repeatedly without querying first.

        Value, built by the integration and never by hand:
            SapMaterialCode__c + '|' + Pricebook2Id + '|' + CurrencyIsoCode

        Anchored on SapMaterialCode__c and NOT on ProductCode, because
        ProductCode is not unique in Salesforce: two products can share the
        same code, which would make the key ambiguous. SapMaterialCode__c is
        unique and External Id, so the anchor is safe.
    -->

    <fields>
        <fullName>PriceKey__c</fullName>
        <label>Price Key</label>
        <type>Text</type>
        <length>80</length>
        <unique>true</unique>
        <caseSensitive>false</caseSensitive>
        <externalId>true</externalId>
        <required>false</required>
        <description>All countries. Upsert key for the price integration: SAP material code, price book Id and currency, pipe separated. Populated by the integration only. Lets MuleSoft push a price change over an existing entry without a prior query, and makes the load idempotent and re-runnable.</description>
        <inlineHelpText>Integration key. Do not edit manually.</inlineHelpText>
    </fields>

</CustomObject>
