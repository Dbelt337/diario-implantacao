<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>SendNotification</name>
        <label>Notificar al asesor</label>
        <locationX>176</locationX>
        <locationY>756</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value><elementReference>GetNotifType.Id</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value><elementReference>coll_Recipients</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value><elementReference>f_Title</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value><elementReference>f_Body</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
    </actionCalls>
    <apiVersion>63.0</apiVersion>
    <assignments>
        <name>BuildRecipients</name>
        <label>Destinatario = owner de la Opp</label>
        <locationX>176</locationX>
        <locationY>648</locationY>
        <assignmentItems>
            <assignToReference>coll_Recipients</assignToReference>
            <operator>Add</operator>
            <value><elementReference>GetOpp.OwnerId</elementReference></value>
        </assignmentItems>
        <connector><targetReference>SendNotification</targetReference></connector>
    </assignments>
    <decisions>
        <name>HasQuote</name>
        <label>Order enlazado a Quote?</label>
        <locationX>176</locationX>
        <locationY>216</locationY>
        <defaultConnectorLabel>Sin quote (pedido manual) - fin</defaultConnectorLabel>
        <rules>
            <name>YesLinkedQuote</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Quote__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>GetQuote</targetReference></connector>
            <label>Si</label>
        </rules>
    </decisions>
    <description>GQ.AUT.COCKPIT 4.2: retorno SAP. Cuando el Mule (L73) graba SAP_FacturaRef__c en un Order en Draft: activa el pedido (Status=Activated), marca SAP_SyncStatus=Confirmado y envia Custom Notification al owner de la Opportunity (via Quote__c) con el numero del pedido y la factura. Guard: solo dispara cuando la factura pasa de vacia a llena y el Order sigue Draft. Este flow NO envia nada a SAP.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_Title</name>
        <dataType>String</dataType>
        <expression>"Pedido activado: " &amp; {!$Record.OrderNumber}</expression>
    </formulas>
    <formulas>
        <name>f_Body</name>
        <dataType>String</dataType>
        <expression>"SAP confirmó la factura " &amp; {!$Record.SAP_FacturaRef__c} &amp; ". El pedido " &amp; {!$Record.OrderNumber} &amp; " de la oportunidad " &amp; {!GetOpp.Name} &amp; " quedó Activated."</expression>
    </formulas>
    <interviewLabel>ActivarPorFactura {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Order_AS_ActivarPorFactura</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>TaskFault</name>
        <label>Task: fallo al activar</label>
        <locationX>440</locationX>
        <locationY>216</locationY>
        <inputAssignments>
            <field>OwnerId</field>
            <value><elementReference>$Record.OwnerId</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value><stringValue>ERROR al activar pedido por factura SAP — revisar</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value><elementReference>$Flow.FaultMessage</elementReference></value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>GetQuote</name>
        <label>Get Quote</label>
        <locationX>176</locationX>
        <locationY>324</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>GetOpp</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Quote__c</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>OpportunityId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetOpp</name>
        <label>Get Opportunity</label>
        <locationX>176</locationX>
        <locationY>432</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>GetNotifType</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>GetQuote.OpportunityId</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>OwnerId</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetNotifType</name>
        <label>Get Custom Notification Type</label>
        <locationX>176</locationX>
        <locationY>540</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>BuildRecipients</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value><stringValue>GQ_Order_Activated</stringValue></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>ActivateOrder</name>
        <label>Activar pedido</label>
        <locationX>176</locationX>
        <locationY>108</locationY>
        <connector><targetReference>HasQuote</targetReference></connector>
        <faultConnector><targetReference>TaskFault</targetReference></faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Id</elementReference></value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value><stringValue>Activated</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>SAP_SyncStatus__c</field>
            <value><stringValue>Confirmado</stringValue></value>
        </inputAssignments>
        <object>Order</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>ActivateOrder</targetReference></connector>
        <object>Order</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SAP_FacturaRef__c</field>
            <operator>IsNull</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value><stringValue>Draft</stringValue></value>
        </filters>
    </start>
    <status>Active</status>
    <variables>
        <name>coll_Recipients</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
