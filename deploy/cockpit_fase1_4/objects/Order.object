<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>SAP_OrderNumber__c</fullName>
        <label>Número de Pedido SAP</label>
        <type>Text</type>
        <length>20</length>
        <externalId>true</externalId>
        <unique>false</unique>
        <required>false</required>
        <description>GQ.AUT.COCKPIT 1.1: numero del pedido devuelto por SAP (L34). Escrito solo por integracion (PS_Api).</description>
    </fields>
    <fields>
        <fullName>SAP_FacturaRef__c</fullName>
        <label>Referencia de Factura SAP</label>
        <type>Text</type>
        <length>30</length>
        <externalId>false</externalId>
        <unique>false</unique>
        <required>false</required>
        <description>GQ.AUT.COCKPIT 1.1: referencia de factura SAP grabada por el Mule (L73). Su llenado dispara Order_AS_ActivarPorFactura.</description>
    </fields>
    <fields>
        <fullName>SAP_SyncStatus__c</fullName>
        <label>Estado Sincronización SAP</label>
        <type>Picklist</type>
        <description>GQ.AUT.COCKPIT 1.1: estado del envio del pedido a SAP.</description>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>Pendiente</fullName><default>true</default><label>Pendiente</label></value>
                <value><fullName>Enviado</fullName><default>false</default><label>Enviado</label></value>
                <value><fullName>Confirmado</fullName><default>false</default><label>Confirmado</label></value>
                <value><fullName>Error</fullName><default>false</default><label>Error</label></value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Quote__c</fullName>
        <label>Cotización</label>
        <type>Lookup</type>
        <referenceTo>Quote</referenceTo>
        <relationshipLabel>Pedidos</relationshipLabel>
        <relationshipName>Orders_GQ</relationshipName>
        <deleteConstraint>SetNull</deleteConstraint>
        <required>false</required>
        <description>GQ.AUT.COCKPIT 1.1: la org no expone QuoteId estandar en Order (divergencia vs spec — org vence). Enlace del pedido a la cotizacion aceptada que lo origino.</description>
    </fields>
</CustomObject>
