<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lead_TriggerOmniRouting - Record-Triggered Flow (CORRIGIDO + sem Id hardcoded)
  ----------------------------------------------------------------------------
  Dispara o roteamento Omni-Channel do Lead chamando o Omni-Channel Flow
  LeadRouting_OmniFlow (Route Work: Lead_Channel + SkillsBased + RunSBRRules).

  >>> SEM Id de fila/config hardcoded <<<
  O routingConfigId e' resolvido EM RUNTIME: faz Get Records no Group (Queue)
  pela DeveloperName 'Queue_Vendedores_CR' (estavel entre ambientes) e pega o
  campo QueueRoutingConfigId. Esse Id e' passado pro LeadRouting_OmniFlow como
  variavel (routingConfigId). Assim nada de Id muda entre dev/UAT/prod.

  Logica:
    Start (Create/Update, async after commit)
      entry: Marca__c preenchido E IsConverted=false E Sociedad CR (C101/C105)
      anti-redisparo: doesRequireRecordChangedToMeetCriteria=true
        -> Get_Queue_CR (Group WHERE DeveloperName='Queue_Vendedores_CR')
           -> Check_Config (QueueRoutingConfigId != null?)
               SIM -> Invocar_OmniRouting (subflow LeadRouting_OmniFlow,
                        recordId + routingConfigId) -- fault -> Log_Falha_Roteamento
               NAO -> Log_Falha_Config (Task avisando que a fila nao tem config)

  ESCOPO: Costa Rica (Sociedad C101/C105 + fila Queue_Vendedores_CR).
  Para outros paises: trocar a Sociedad da entry criteria e a DeveloperName da
  fila no Get_Queue_CR (ou um Decision por prefixo de Sociedad escolhendo a fila).
  Nada de Id muda - so DeveloperName.
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Config</name>
        <label>Check Config</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Log_Falha_Config</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sem Config</defaultConnectorLabel>
        <rules>
            <name>Tem_Config</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Queue_CR.QueueRoutingConfigId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invocar_OmniRouting</targetReference>
            </connector>
            <label>Tem Config</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Lead_TriggerOmniRouting {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead_TriggerOmniRouting</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Log_Falha_Config</name>
        <label>Log Falha Config</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>A fila Queue_Vendedores_CR nao tem Routing Configuration (QueueRoutingConfigId vazio). Lead nao roteado.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Lead nao roteado: fila sem Routing Configuration</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>Log_Falha_Roteamento</name>
        <label>Log Falha Roteamento</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Falha no roteamento Omni-Channel do Lead</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Queue_CR</name>
        <label>Get Queue CR</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Config</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha_Roteamento</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue_Vendedores_CR</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>1 AND 2 AND (3 OR 4)</filterLogic>
        <filters>
            <field>Marca__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Sociedad__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>C101</stringValue>
            </value>
        </filters>
        <filters>
            <field>Sociedad__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>C105</stringValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Get_Queue_CR</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Invocar_OmniRouting</name>
        <label>Invocar OmniRouting</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Log_Falha_Roteamento</targetReference>
        </faultConnector>
        <flowName>LeadRouting_OmniFlow</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>routingConfigId</name>
            <value>
                <elementReference>Get_Queue_CR.QueueRoutingConfigId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
