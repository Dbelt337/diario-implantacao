<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Loss_Reason__c</fullName>
        <description>All countries. Reason an opportunity is closed as lost, required by HU-024 for the six business lines: Autos, Usados, Motos, Flotas, Mayorista and Repuestos y PA. Set manually on close, and by the scheduled inactivity closure driven by InactivityPolicy__mdt. Values are stored in English and displayed in Spanish through Translation Workbench. This field comes from the Salesforce sample Path setup, which is why the API name carries an underscore and does not follow the GRPQM PascalCase convention.</description>
        <label>Motivo de Cierre</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Lost to Competitor</fullName>
                    <default>false</default>
                    <label>Compró en la competencia</label>
                </value>
                <value>
                    <fullName>No Budget / Lost Funding</fullName>
                    <default>false</default>
                    <label>Precio no Competitivo</label>
                </value>
                <value>
                    <fullName>No Decision / Non-Responsive</fullName>
                    <default>false</default>
                    <label>Cliente desistio de la compra</label>
                </value>
                <value>
                    <fullName>No Customer Response</fullName>
                    <default>false</default>
                    <label>Sin Respuesta del Cliente</label>
                </value>
                <value>
                    <fullName>Other</fullName>
                    <default>false</default>
                    <label>Otro</label>
                </value>
                <value>
                    <fullName>Product Not Available</fullName>
                    <default>false</default>
                    <label>Producto no disponible</label>
                </value>
                <value>
                    <fullName>Delivery Time Not Accepted</fullName>
                    <default>false</default>
                    <label>Tiempo de entrega no aceptado</label>
                </value>
                <value>
                    <fullName>Purchase Postponed</fullName>
                    <default>false</default>
                    <label>Compra postergada</label>
                </value>
                <value>
                    <fullName>Duplicate Opportunity</fullName>
                    <default>false</default>
                    <label>Oportunidad duplicada</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
