<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>HU-014 v1: crea una Cotizacion (Quote) nativa. Sirve para Cuenta (Persona Natural o Business) y para Oportunidad. Detecta el contexto por el prefijo del Id: 001 Cuenta -> Quote.AccountId directo; 006 Oportunidad -> Quote.OpportunityId (AccountId derivado). Requiere Quotes Settings > Create Quotes Without a Related Opportunity = ON.</description>
    <interviewLabel>GrupoQ Crear Cotizacion {!$Flow.CurrentDateTime}</interviewLabel>
    <label>GrupoQ Crear Cotizacion</label>
    <processType>Flow</processType>
    <status>Active</status>

    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Ctx_Tipo</targetReference>
        </connector>
    </start>

    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <formulas>
        <name>fPrefix</name>
        <dataType>String</dataType>
        <expression>LEFT({!recordId}, 3)</expression>
    </formulas>
    <formulas>
        <name>fQuoteName</name>
        <dataType>String</dataType>
        <expression>"Cotizacion " + TEXT({!$Flow.CurrentDate})</expression>
    </formulas>
    <formulas>
        <name>fExpiration</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 30</expression>
    </formulas>

    <decisions>
        <name>Ctx_Tipo</name>
        <label>Contexto (Cuenta u Oportunidad)</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Create_Quote_Acc</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Cuenta (001)</defaultConnectorLabel>
        <rules>
            <name>Es_Oportunidad</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fPrefix</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>006</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Quote_Opp</targetReference>
            </connector>
            <label>Oportunidad (006)</label>
        </rules>
    </decisions>

    <recordCreates>
        <name>Create_Quote_Acc</name>
        <label>Create Quote (Cuenta)</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <connector>
            <targetReference>Scr_Done</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Scr_Error</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>fQuoteName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ExpirationDate</field>
            <value>
                <elementReference>fExpiration</elementReference>
            </value>
        </inputAssignments>
        <object>Quote</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>

    <recordCreates>
        <name>Create_Quote_Opp</name>
        <label>Create Quote (Oportunidad)</label>
        <locationX>440</locationX>
        <locationY>278</locationY>
        <connector>
            <targetReference>Scr_Done</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Scr_Error</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>fQuoteName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OpportunityId</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ExpirationDate</field>
            <value>
                <elementReference>fExpiration</elementReference>
            </value>
        </inputAssignments>
        <object>Quote</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>

    <screens>
        <name>Scr_Done</name>
        <label>Cotizacion creada</label>
        <locationX>176</locationX>
        <locationY>398</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Msg_Done</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Cotizacion creada&lt;/b&gt; en estado Borrador (Draft).&lt;/p&gt;&lt;p&gt;Aparece en la lista relacionada de Cotizaciones del registro.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <screens>
        <name>Scr_Error</name>
        <label>No se pudo crear</label>
        <locationX>704</locationX>
        <locationY>398</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Msg_Error</name>
            <fieldText>&lt;p&gt;&lt;b&gt;No se pudo crear la cotizacion.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Detalle: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
</Flow>
