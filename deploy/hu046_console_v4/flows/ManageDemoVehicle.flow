<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>NotifyFloorManagerDesignation</name>
        <label>Action: Send Designation Alert</label>
        <locationX>200</locationX><locationY>800</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <connector><targetReference>ConfirmationScreen</targetReference></connector>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value><elementReference>GetNotificationType.Id</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value><elementReference>recipientIds</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value><elementReference>GetVehicle.Id</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value><stringValue>Nueva solicitud de designación Demo/Exhibición</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value><elementReference>resultMessage</elementReference></value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
    </actionCalls>
    <actionCalls>
        <name>NotifyFloorManagerRelease</name>
        <label>Action: Send Release Alert</label>
        <locationX>800</locationX><locationY>600</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <connector><targetReference>ConfirmationScreen</targetReference></connector>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value><elementReference>GetNotificationTypeRelease.Id</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value><elementReference>recipientIds</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value><elementReference>GetVehicle.Id</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value><stringValue>Solicitud de liberación para venta</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value><stringValue>Hay una nueva solicitud de liberación de unidad Demo/Exhibición pendiente de ejecución.</stringValue></value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>AddUniqueBrand</name>
        <label>Assignment: Add Unique Brand</label>
        <locationX>0</locationX><locationY>450</locationY>
        <assignmentItems>
            <assignToReference>seenBrands</assignToReference>
            <operator>Add</operator>
            <value><stringValue>|</stringValue></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>seenBrands</assignToReference>
            <operator>Add</operator>
            <value><elementReference>BrandLoop.Brand__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>uniqueBrandRecs</assignToReference>
            <operator>Add</operator>
            <value><elementReference>BrandLoop</elementReference></value>
        </assignmentItems>
        <connector><targetReference>BrandLoop</targetReference></connector>
    </assignments>
    <assignments>
        <name>CountUnitsInUse</name>
        <label>Assignment: Set Current Unit Count</label>
        <locationX>200</locationX><locationY>500</locationY>
        <assignmentItems>
            <assignToReference>currentUnitCount</assignToReference>
            <operator>AssignCount</operator>
            <value><elementReference>GetUnitsInTargetStatus</elementReference></value>
        </assignmentItems>
        <connector><targetReference>ValidateQuota</targetReference></connector>
    </assignments>
    <assignments>
        <name>SetDesignationRecipients</name>
        <label>Assignment: Set Designation Recipients</label>
        <locationX>200</locationX><locationY>700</locationY>
        <assignmentItems>
            <assignToReference>recipientIds</assignToReference>
            <operator>Add</operator>
            <value><elementReference>EncargadoPick</elementReference></value>
        </assignmentItems>
        <connector><targetReference>GetNotificationType</targetReference></connector>
    </assignments>
    <assignments>
        <name>SetReleaseRecipients</name>
        <label>Assignment: Set Release Recipients</label>
        <locationX>800</locationX><locationY>500</locationY>
        <assignmentItems>
            <assignToReference>recipientIds</assignToReference>
            <operator>Add</operator>
            <value><elementReference>EncargadoPick</elementReference></value>
        </assignmentItems>
        <connector><targetReference>GetNotificationTypeRelease</targetReference></connector>
    </assignments>
    <choices>
        <name>ActionAssign</name>
        <choiceText>Asignar / reasignar a asesor (ventana de 8h hábiles)</choiceText>
        <dataType>String</dataType>
        <value><stringValue>ASSIGN</stringValue></value>
    </choices>
    <choices>
        <name>ActionCancel</name>
        <choiceText>Cancelar asignación excepcional (nada cambia de estado/ubicación)</choiceText>
        <dataType>String</dataType>
        <value><stringValue>CANCEL</stringValue></value>
    </choices>
    <choices>
        <name>ActionRelease</name>
        <choiceText>Liberar para venta (solicitud al encargado)</choiceText>
        <dataType>String</dataType>
        <value><stringValue>RELEASE</stringValue></value>
    </choices>
    <choices>
        <name>ActionRequest</name>
        <choiceText>Solicitar designación Demo / Exhibición</choiceText>
        <dataType>String</dataType>
        <value><stringValue>REQUEST</stringValue></value>
    </choices>
    <choices>
        <name>TypeDemo</name>
        <choiceText>Demo</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Demo</stringValue></value>
    </choices>
    <choices>
        <name>TypeExhibition</name>
        <choiceText>Exhibición</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Exhibicion</stringValue></value>
    </choices>
    <decisions>
        <name>IsBrandSeen</name>
        <label>Decision: Brand Already Seen?</label>
        <locationX>0</locationX><locationY>400</locationY>
        <defaultConnector><targetReference>AddUniqueBrand</targetReference></defaultConnector>
        <defaultConnectorLabel>New brand</defaultConnectorLabel>
        <rules>
            <name>BrandSeen</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>seenBrands</leftValueReference>
                <operator>Contains</operator>
                <rightValue><elementReference>BrandLoop.Brand__c</elementReference></rightValue>
            </conditions>
            <connector><targetReference>BrandLoop</targetReference></connector>
            <label>Seen</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsUnitEligible</name>
        <label>Decision: Unit Eligible for Designation?</label>
        <locationX>100</locationX><locationY>280</locationY>
        <defaultConnector><targetReference>NotEligibleScreen</targetReference></defaultConnector>
        <defaultConnectorLabel>Not eligible</defaultConnectorLabel>
        <rules>
            <name>UnitEligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetVehicle.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>En ubicación de concesionario</stringValue></rightValue>
            </conditions>
            <connector><targetReference>GetQuotaBrands</targetReference></connector>
            <label>Eligible (available at dealer)</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsQuotaOk</name>
        <label>Decision: Quota Available?</label>
        <locationX>200</locationX><locationY>600</locationY>
        <defaultConnector><targetReference>QuotaFullScreen</targetReference></defaultConnector>
        <defaultConnectorLabel>Quota full</defaultConnectorLabel>
        <rules>
            <name>QuotaOk</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isQuotaAvailable</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>LogDesignationRequest</targetReference></connector>
            <label>Available</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsUnitFound</name>
        <label>Decision: Unit Found?</label>
        <locationX>200</locationX><locationY>200</locationY>
        <defaultConnector><targetReference>UnitNotFoundScreen</targetReference></defaultConnector>
        <defaultConnectorLabel>Not found</defaultConnectorLabel>
        <rules>
            <name>UnitFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetVehicle</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>WhichAction</targetReference></connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>WhichAction</name>
        <label>Decision: Which Action?</label>
        <locationX>400</locationX><locationY>300</locationY>
        <defaultConnector><targetReference>CancelScreen</targetReference></defaultConnector>
        <defaultConnectorLabel>Cancel</defaultConnectorLabel>
        <rules>
            <name>DoRequest</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RequestedAction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>REQUEST</stringValue></rightValue>
            </conditions>
            <connector><targetReference>IsUnitEligible</targetReference></connector>
            <label>Request designation</label>
        </rules>
        <rules>
            <name>DoAssign</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RequestedAction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>ASSIGN</stringValue></rightValue>
            </conditions>
            <connector><targetReference>AssignScreen</targetReference></connector>
            <label>Assign to advisor</label>
        </rules>
        <rules>
            <name>DoRelease</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RequestedAction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>RELEASE</stringValue></rightValue>
            </conditions>
            <connector><targetReference>LogReleaseRequest</targetReference></connector>
            <label>Release for sale</label>
        </rules>
    </decisions>
    <description>Management screen for the demo vehicle lifecycle (HU-046, RN-3/4/5/6/8/9). All countries. One screen with four branches: request designation (validates quota, creates floor manager Task + alert), assign/REASSIGN advisor (Esc.6: assigning first CLOSES any prior open assignment Task of the unit, then creates the new advisor-owned Task - single active assignment at a time; Task-based: the open [Demo] Asignacion Task owned by the ADVISOR is the assignment marker; NO record owner changes - the vehicle belongs to GrupoQ: Asset.AccountId = sociedad, Vehicle.CurrentOwnerId = dealer, both untouched), release for sale (request Task + alert), cancel exceptional assignment (closes the open assignment Task, nothing else changes). Entry restricted by the RequestDemoVehicle custom permission (component visibility). ELIGIBILITY v2 (07/08): the request branch only accepts units whose Vehicle.Status = "En ubicación de concesionario" (available at dealer - the SAP-load arrival state); any other status shows the Not Eligible screen with the current state. To widen the eligible set, add values to the IsUnitEligible decision. UX 07/08: brand/branch are now cascading dropdowns fed by the CR quota CMDT records (unique brands via dedupe loop; branches filtered by selected brand) - impossible to request a combination without a quota row. TODO-DAVI: (1) unit selected by typed VIN - evolve to CBSF search (T01); (2) brand/branch typed - derive from the Vehicle record; (3) GetUnitsInTargetStatus filters only by Status - add brand and branch filters; (4) RESOLVED 06/08: floor manager is now a required User dropdown (EncargadoPick) on the menu screen - evolve later to a per-branch GRP_Sucursal_* default; (5) RESOLVED 06/08: AdvisorId is a User dropdown (ActiveUserChoices, IsActive=true sorted by Name) - refine the filter later (e.g., sales profile/role or branch) if the user list grows. Picklist API values verbatim from the org: En demostración (accented), En exhibicion (NOT accented). DESIGN FIX 06/08: SerializedProduct leg REMOVED (legacy of the old HU premises) - unit identity is the Vehicle (VehicleIdentificationNumber), per the Automotive Cloud model; DESIGN FIX 2 (same day, Diego): NO owner write at all - the vehicle belongs to GrupoQ; the assignment lives in the advisor-owned open Task, closed on cancel/expiry. Search matches VIN OR Name (filterLogic or).</description>
    <dynamicChoiceSets>
        <name>ActiveUserChoices</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value><booleanValue>true</booleanValue></value>
        </filters>
        <object>User</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>BranchChoices</name>
        <dataType>String</dataType>
        <displayField>BranchName__c</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Country__c</field>
            <operator>EqualTo</operator>
            <value><stringValue>CR</stringValue></value>
        </filters>
        <filters>
            <field>Brand__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>BrandPick</elementReference></value>
        </filters>
        <object>DemoCapacityConfig__mdt</object>
        <sortField>BranchName__c</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>BranchName__c</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>UniqueBrandChoices</name>
        <collectionReference>uniqueBrandRecs</collectionReference>
        <dataType>String</dataType>
        <displayField>Brand__c</displayField>
        <object>DemoCapacityConfig__mdt</object>
        <valueField>Brand__c</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>targetStatus</name>
        <dataType>String</dataType>
        <expression>IF({!DesignationType} = 'Demo', 'En demostración', 'En exhibicion')</expression>
    </formulas>
    <interviewLabel>Manage Demo Vehicle {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Screen Flow: Manage Demo Vehicle</label>
    <loops>
        <name>BrandLoop</name>
        <label>Loop: Unique Brands</label>
        <locationX>0</locationX><locationY>350</locationY>
        <collectionReference>GetQuotaBrands</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector><targetReference>IsBrandSeen</targetReference></nextValueConnector>
        <noMoreValuesConnector><targetReference>RequestScreen</targetReference></noMoreValuesConnector>
    </loops>
    <processType>Flow</processType>
    <recordLookups>
        <name>GetQuotaBrands</name>
        <label>Get Records: Get CR Quota Records</label>
        <locationX>0</locationX><locationY>300</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>BrandLoop</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Country__c</field>
            <operator>EqualTo</operator>
            <value><stringValue>CR</stringValue></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>DemoCapacityConfig__mdt</object>
        <sortField>Brand__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetNotificationType</name>
        <label>Get Records: Get Notification Type</label>
        <locationX>200</locationX><locationY>750</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>NotifyFloorManagerDesignation</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value><stringValue>DemoDesignationAlert</stringValue></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetNotificationTypeRelease</name>
        <label>Get Records: Get Notification Type (Release)</label>
        <locationX>800</locationX><locationY>550</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>NotifyFloorManagerRelease</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value><stringValue>DemoDesignationAlert</stringValue></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetUnitsInTargetStatus</name>
        <label>Get Records: Get Units in Target Status</label>
        <locationX>200</locationX><locationY>450</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>CountUnitsInUse</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value><elementReference>targetStatus</elementReference></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Vehicle</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetVehicle</name>
        <label>Get Records: Get Vehicle</label>
        <locationX>200</locationX><locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>IsUnitFound</targetReference></connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>recordId</elementReference></value>
        </filters>
        <filters>
            <field>VehicleIdentificationNumber</field>
            <operator>EqualTo</operator>
            <value><elementReference>VehicleSerial</elementReference></value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value><elementReference>VehicleSerial</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vehicle</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>CloseBeforeReassign</name>
        <label>Update Records: Close Prior Open Assignment (Reassign)</label>
        <locationX>600</locationX><locationY>380</locationY>
        <connector><targetReference>LogAssignment</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhatId</field>
            <operator>EqualTo</operator>
            <value><elementReference>GetVehicle.Id</elementReference></value>
        </filters>
        <filters>
            <field>Subject</field>
            <operator>StartsWith</operator>
            <value><stringValue>[Demo] Asignación</stringValue></value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value><stringValue>Completed</stringValue></value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value><stringValue>Completed</stringValue></value>
        </inputAssignments>
        <object>Task</object>
    </recordUpdates>
    <recordUpdates>
        <name>CloseOpenAssignment</name>
        <label>Update Records: Close Open Assignment Task</label>
        <locationX>1000</locationX><locationY>400</locationY>
        <connector><targetReference>LogCancellation</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhatId</field>
            <operator>EqualTo</operator>
            <value><elementReference>GetVehicle.Id</elementReference></value>
        </filters>
        <filters>
            <field>Subject</field>
            <operator>StartsWith</operator>
            <value><stringValue>[Demo] Asignación</stringValue></value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value><stringValue>Completed</stringValue></value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value><stringValue>Completed</stringValue></value>
        </inputAssignments>
        <object>Task</object>
    </recordUpdates>
    <screens>
        <name>AssignScreen</name>
        <label>Screen: Assign Advisor</label>
        <locationX>600</locationX><locationY>350</locationY>
        <allowBack>true</allowBack><allowFinish>true</allowFinish><allowPause>false</allowPause>
        <connector><targetReference>CloseBeforeReassign</targetReference></connector>
        <fields>
            <name>AssignScreenTitle</name>
            <fieldText>&lt;p&gt;&lt;b&gt;&lt;span style="font-size: 16px;"&gt;Asignar / reasignar asesor&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>AdvisorId</name>
            <choiceReferences>ActiveUserChoices</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Asesor (seleccione el usuario)</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter><showHeader>false</showHeader>
    </screens>
    <screens>
        <name>BranchScreen</name>
        <label>Screen: Select Branch</label>
        <locationX>200</locationX><locationY>430</locationY>
        <allowBack>true</allowBack><allowFinish>true</allowFinish><allowPause>false</allowPause>
        <connector><targetReference>GetUnitsInTargetStatus</targetReference></connector>
        <fields>
            <name>BranchScreenTitle</name>
            <fieldText>&lt;p&gt;&lt;b&gt;&lt;span style="font-size: 16px;"&gt;Sucursal&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>BranchPick</name>
            <choiceReferences>BranchChoices</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Sucursal con cupo para la marca seleccionada</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter><showHeader>false</showHeader>
    </screens>
    <screens>
        <name>CancelScreen</name>
        <label>Screen: Cancel Assignment</label>
        <locationX>1000</locationX><locationY>350</locationY>
        <allowBack>true</allowBack><allowFinish>true</allowFinish><allowPause>false</allowPause>
        <connector><targetReference>CloseOpenAssignment</targetReference></connector>
        <fields>
            <name>CancelScreenTitle</name>
            <fieldText>&lt;p&gt;&lt;b&gt;&lt;span style="font-size: 16px;"&gt;Cancelar asignación excepcional&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>CancelExplainText</name>
            <fieldText>&lt;p&gt;Se cerrará la Task de asignación abierta de esta unidad. El vehículo sigue siendo de GrupoQ: ningún dueño de registro cambia. Estado y ubicación tampoco cambian (Esc.11).&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter><showHeader>false</showHeader>
    </screens>
    <screens>
        <name>ConfirmationScreen</name>
        <label>Screen: Show Confirmation</label>
        <locationX>500</locationX><locationY>900</locationY>
        <allowBack>false</allowBack><allowFinish>true</allowFinish><allowPause>false</allowPause>
        <fields>
            <name>ConfirmationScreenTitle</name>
            <fieldText>&lt;p&gt;&lt;b&gt;&lt;span style="font-size: 16px;"&gt;Confirmación&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>ConfirmationText</name>
            <fieldText>&lt;p&gt;Acción registrada correctamente. La traza quedó en la Task vinculada al Vehicle.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter><showHeader>false</showHeader>
    </screens>
    <screens>
        <name>MenuScreen</name>
        <label>Screen: Select Action and Unit</label>
        <locationX>200</locationX><locationY>50</locationY>
        <allowBack>false</allowBack><allowFinish>true</allowFinish><allowPause>false</allowPause>
        <connector><targetReference>GetVehicle</targetReference></connector>
        <fields>
            <name>MenuScreenTitle</name>
            <fieldText>&lt;p&gt;&lt;b&gt;&lt;span style="font-size: 16px;"&gt;Vehículos Demo / Exhibición&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>RequestedAction</name>
            <choiceReferences>ActionRequest</choiceReferences>
            <choiceReferences>ActionAssign</choiceReferences>
            <choiceReferences>ActionRelease</choiceReferences>
            <choiceReferences>ActionCancel</choiceReferences>
            <dataType>String</dataType>
            <fieldText>¿Qué desea hacer?</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>VehicleSerialSection</name>
            <fieldType>RegionContainer</fieldType>
            <fields>
                <name>VehicleSerialSectionCol1</name>
                <fieldType>Region</fieldType>
                <fields>
                    <name>VehicleSerial</name>
                    <dataType>String</dataType>
                    <fieldText>VIN o nombre de la unidad</fieldText>
                    <fieldType>InputField</fieldType>
                    <helpText>&lt;p&gt;Busca por VIN (17 caracteres) o por el nombre exacto de la unidad. Si abriste esta acción desde la página del vehículo, deja el campo vacío: la unidad de la página ya está seleccionada.&lt;/p&gt;</helpText>
                    <isRequired>false</isRequired>
                </fields>
                <inputParameters>
                    <name>width</name>
                    <value><stringValue>4</stringValue></value>
                </inputParameters>
            </fields>
            <fields>
                <name>VehicleSerialSectionCol2</name>
                <fieldType>Region</fieldType>
                <inputParameters>
                    <name>width</name>
                    <value><stringValue>8</stringValue></value>
                </inputParameters>
            </fields>
            <isRequired>false</isRequired>
            <regionContainerType>SectionWithoutHeader</regionContainerType>
        </fields>
        <fields>
            <name>EncargadoPick</name>
            <choiceReferences>ActiveUserChoices</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Encargado de piso (recibirá la solicitud)</fieldText>
            <fieldType>DropdownBox</fieldType>
            <helpText>&lt;p&gt;Usuario que ejecutará la solicitud en la pantalla "Ejecutar Solicitudes Demo". Será el dueño de la Task y recibirá la alerta.&lt;/p&gt;</helpText>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter><showHeader>false</showHeader>
    </screens>
    <screens>
        <name>NotEligibleScreen</name>
        <label>Screen: Unit Not Eligible</label>
        <locationX>0</locationX><locationY>330</locationY>
        <allowBack>true</allowBack><allowFinish>true</allowFinish><allowPause>false</allowPause>
        <fields>
            <name>NotEligibleTitle</name>
            <fieldText>&lt;p&gt;&lt;b&gt;&lt;span style="font-size: 16px;"&gt;Unidad no elegible&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>NotEligibleText</name>
            <fieldText>&lt;p&gt;Solo unidades con estado &lt;b&gt;En ubicación de concesionario&lt;/b&gt; pueden designarse como Demo/Exhibición.&lt;/p&gt;&lt;p&gt;Estado actual de la unidad: &lt;b&gt;{!GetVehicle.Status}&lt;/b&gt;. Si la unidad está en demo/exhibición y debe venderse, use "Liberar para venta"; si está en otro estado, regularícela primero.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter><showHeader>false</showHeader>
    </screens>
    <screens>
        <name>QuotaFullScreen</name>
        <label>Screen: Show Quota Full</label>
        <locationX>400</locationX><locationY>700</locationY>
        <allowBack>true</allowBack><allowFinish>true</allowFinish><allowPause>false</allowPause>
        <fields>
            <name>QuotaFullScreenTitle</name>
            <fieldText>&lt;p&gt;&lt;b&gt;&lt;span style="font-size: 16px;"&gt;Cupo no disponible&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>QuotaFullText</name>
            <fieldText>&lt;p&gt;{!resultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter><showHeader>false</showHeader>
    </screens>
    <screens>
        <name>RequestScreen</name>
        <label>Screen: Collect Designation Request</label>
        <locationX>200</locationX><locationY>400</locationY>
        <allowBack>true</allowBack><allowFinish>true</allowFinish><allowPause>false</allowPause>
        <connector><targetReference>BranchScreen</targetReference></connector>
        <fields>
            <name>RequestScreenTitle</name>
            <fieldText>&lt;p&gt;&lt;b&gt;&lt;span style="font-size: 16px;"&gt;Solicitar designación Demo / Exhibición&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>DesignationType</name>
            <choiceReferences>TypeDemo</choiceReferences>
            <choiceReferences>TypeExhibition</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Tipo de designación</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>BrandPick</name>
            <choiceReferences>UniqueBrandChoices</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Marca (según cupos configurados)</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter><showHeader>false</showHeader>
    </screens>
    <screens>
        <name>UnitNotFoundScreen</name>
        <label>Screen: Show Unit Not Found</label>
        <locationX>0</locationX><locationY>300</locationY>
        <allowBack>true</allowBack><allowFinish>true</allowFinish><allowPause>false</allowPause>
        <fields>
            <name>UnitNotFoundScreenTitle</name>
            <fieldText>&lt;p&gt;&lt;b&gt;&lt;span style="font-size: 16px;"&gt;Unidad no encontrada&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>UnitNotFoundText</name>
            <fieldText>&lt;p&gt;No se encontró la unidad con el VIN/serial informado. Verifique el dato e intente de nuevo (botón Anterior).&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter><showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>200</locationX><locationY>0</locationY>
        <connector><targetReference>MenuScreen</targetReference></connector>
    </start>
    <status>Draft</status>
    <subflows>
        <name>LogAssignment</name>
        <label>Subflow: Log Demo Activity (Assignment)</label>
        <locationX>600</locationX><locationY>500</locationY>
        <connector><targetReference>ConfirmationScreen</targetReference></connector>
        <flowName>LogDemoActivity</flowName>
        <inputAssignments>
            <name>actionType</name>
            <value><stringValue>Asignación</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>activityDetails</name>
            <value><stringValue>Asignación excepcional de unidad demo a asesor (ventana de 8h hábiles). La Task abierta, cuyo dueño es el asesor, ES la asignación; ningún dueño de registro cambia (el vehículo es de GrupoQ).</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>taskOwnerId</name>
            <value><elementReference>AdvisorId</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <name>taskStatus</name>
            <value><stringValue>Not Started</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>vehicleId</name>
            <value><elementReference>GetVehicle.Id</elementReference></value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>LogCancellation</name>
        <label>Subflow: Log Demo Activity (Cancellation)</label>
        <locationX>1000</locationX><locationY>500</locationY>
        <connector><targetReference>ConfirmationScreen</targetReference></connector>
        <flowName>LogDemoActivity</flowName>
        <inputAssignments>
            <name>actionType</name>
            <value><stringValue>Cancelación</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>activityDetails</name>
            <value><stringValue>Cancelación de la asignación excepcional. Estado y ubicación sin cambios (Esc.11).</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>taskOwnerId</name>
            <value><elementReference>$User.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <name>taskStatus</name>
            <value><stringValue>Completed</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>vehicleId</name>
            <value><elementReference>GetVehicle.Id</elementReference></value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>LogDesignationRequest</name>
        <label>Subflow: Log Demo Activity (Designation Request)</label>
        <locationX>200</locationX><locationY>650</locationY>
        <connector><targetReference>SetDesignationRecipients</targetReference></connector>
        <flowName>LogDemoActivity</flowName>
        <inputAssignments>
            <name>actionType</name>
            <value><stringValue>Solicitud de designación</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>activityDetails</name>
            <value><elementReference>resultMessage</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <name>taskOwnerId</name>
            <value><elementReference>EncargadoPick</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <name>taskStatus</name>
            <value><stringValue>Not Started</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>vehicleId</name>
            <value><elementReference>GetVehicle.Id</elementReference></value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>LogReleaseRequest</name>
        <label>Subflow: Log Demo Activity (Release Request)</label>
        <locationX>800</locationX><locationY>400</locationY>
        <connector><targetReference>SetReleaseRecipients</targetReference></connector>
        <flowName>LogDemoActivity</flowName>
        <inputAssignments>
            <name>actionType</name>
            <value><stringValue>Solicitud de liberación</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>activityDetails</name>
            <value><stringValue>Solicitud de liberación para venta. Pendiente de ejecución por el encargado de piso (Esc.7).</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>taskOwnerId</name>
            <value><elementReference>EncargadoPick</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <name>taskStatus</name>
            <value><stringValue>Not Started</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>vehicleId</name>
            <value><elementReference>GetVehicle.Id</elementReference></value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>ValidateQuota</name>
        <label>Subflow: Validate Demo Quota</label>
        <locationX>200</locationX><locationY>550</locationY>
        <connector><targetReference>IsQuotaOk</targetReference></connector>
        <flowName>ValidateDemoQuota</flowName>
        <inputAssignments>
            <name>brandName</name>
            <value><elementReference>BrandPick</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <name>branchName</name>
            <value><elementReference>BranchPick</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <name>currentUnitCount</name>
            <value><elementReference>currentUnitCount</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <name>designationType</name>
            <value><elementReference>DesignationType</elementReference></value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>isQuotaAvailable</assignToReference>
            <name>isQuotaAvailable</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>resultMessage</assignToReference>
            <name>resultMessage</name>
        </outputAssignments>
    </subflows>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput>
    </variables>
    <variables>
        <name>currentUnitCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>isQuotaAvailable</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput>
    </variables>
    <variables>
        <name>recipientIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection><isInput>false</isInput><isOutput>false</isOutput>
    </variables>
    <variables>
        <name>resultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput>
    </variables>
    <variables>
        <name>seenBrands</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput>
    </variables>
    <variables>
        <name>uniqueBrandRecs</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection><isInput>false</isInput><isOutput>false</isOutput>
        <objectType>DemoCapacityConfig__mdt</objectType>
    </variables>
</Flow>
