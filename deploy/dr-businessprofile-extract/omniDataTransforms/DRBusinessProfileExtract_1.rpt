<?xml version="1.0" encoding="UTF-8"?>
<!--
  DRBusinessProfileExtract - Data Mapper EXTRACT padrao (NAO Turbo).
  Resolve o dealer pelo codigo SAP: filtra BusinessProfile por
  ExternalReferenceNumber = dealerCode AND BusinessPartnerType = 'Sales Dealer' (LIMIT 1)
  e devolve AccountId/Id num node limpo "dealerLookup":
    { "dealerLookup": { "dealerAccountId": "001...", "businessProfileId": "0eQ..." } }
  (Extract comum tem aba Output, ao contrario do Turbo - por isso conseguimos
   renomear AccountId -> dealerAccountId.)

  Teste de Preview: input { "dealerCode": "C011" }
    -> dealerAccountId = 001WK00002EjOWkYAN, businessProfileId = 0eQWK0000000CKX2A2
  Se vier como lista, referenciar %dealerLookup:0:dealerAccountId% (validar no Preview).
-->
<OmniDataTransform xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <assignmentRulesUsed>false</assignmentRulesUsed>
    <deletedOnSuccess>false</deletedOnSuccess>
    <errorIgnored>false</errorIgnored>
    <fieldLevelSecurityEnabled>true</fieldLevelSecurityEnabled>
    <inputType>JSON</inputType>
    <isManagedUsingStdDesigner>true</isManagedUsingStdDesigner>
    <name>DRBusinessProfileExtract</name>
    <nullInputsIncludedInOutput>false</nullInputsIncludedInOutput>
    <omniDataTransformItem>
        <disabled>false</disabled>
        <filterDataType>STRING</filterDataType>
        <filterGroup>0.0</filterGroup>
        <filterOperator>=</filterOperator>
        <filterValue>dealerCode</filterValue>
        <globalKey>c4f1a2b3-3001-4d5e-9f10-300000000001</globalKey>
        <inputFieldName>ExternalReferenceNumber</inputFieldName>
        <inputObjectName>BusinessProfile</inputObjectName>
        <inputObjectQuerySequence>1.0</inputObjectQuerySequence>
        <linkedObjectSequence>0.0</linkedObjectSequence>
        <name>DRBusinessProfileExtract</name>
        <outputCreationSequence>0.0</outputCreationSequence>
        <outputFieldName>dealerLookup</outputFieldName>
        <outputObjectName>Extract</outputObjectName>
        <requiredForUpsert>false</requiredForUpsert>
        <upsertKey>false</upsertKey>
    </omniDataTransformItem>
    <omniDataTransformItem>
        <disabled>false</disabled>
        <filterGroup>0.0</filterGroup>
        <globalKey>c4f1a2b3-3001-4d5e-9f10-300000000003</globalKey>
        <inputFieldName>AccountId</inputFieldName>
        <inputObjectName>BusinessProfile</inputObjectName>
        <inputObjectQuerySequence>0.0</inputObjectQuerySequence>
        <linkedObjectSequence>0.0</linkedObjectSequence>
        <name>DRBusinessProfileExtract</name>
        <outputCreationSequence>1.0</outputCreationSequence>
        <outputFieldName>dealerLookup:dealerAccountId</outputFieldName>
        <outputObjectName>Extract</outputObjectName>
        <requiredForUpsert>false</requiredForUpsert>
        <upsertKey>false</upsertKey>
    </omniDataTransformItem>
    <omniDataTransformItem>
        <disabled>false</disabled>
        <filterGroup>0.0</filterGroup>
        <globalKey>c4f1a2b3-3001-4d5e-9f10-300000000004</globalKey>
        <inputFieldName>Id</inputFieldName>
        <inputObjectName>BusinessProfile</inputObjectName>
        <inputObjectQuerySequence>0.0</inputObjectQuerySequence>
        <linkedObjectSequence>0.0</linkedObjectSequence>
        <name>DRBusinessProfileExtract</name>
        <outputCreationSequence>1.0</outputCreationSequence>
        <outputFieldName>dealerLookup:businessProfileId</outputFieldName>
        <outputObjectName>Extract</outputObjectName>
        <requiredForUpsert>false</requiredForUpsert>
        <upsertKey>false</upsertKey>
    </omniDataTransformItem>
    <outputType>JSON</outputType>
