<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Sucursal__c</fullName>
        <label>Sucursal</label>
        <length>20</length>
        <type>Text</type>
        <description>HU-009: codigo de la sucursal de la actividad presencial. Es el CONTRATO del flow de share (GRP_Sucursal_[codigo]). Lo llena el asesor digital al agendar; en Test Drive lo llena el flow espejo desde el ServiceTerritory.</description>
        <required>false</required>
    </fields>
    <fields>
        <fullName>EstadoVisita__c</fullName>
        <label>Estado de la Visita</label>
        <type>Picklist</type>
        <description>HU-009: estado operativo de la visita (solo actividades Event-puras; el Test Drive se gobierna por el Appointment del Scheduler).</description>
        <required>false</required>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>Pendiente</fullName><default>true</default><label>Pendiente</label></value>
                <value><fullName>Atendida</fullName><default>false</default><label>Atendida</label></value>
                <value><fullName>No Show</fullName><default>false</default><label>No Show</label></value>
                <value><fullName>Cancelada</fullName><default>false</default><label>Cancelada</label></value>
                <value><fullName>Reprogramada</fullName><default>false</default><label>Reprogramada</label></value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>SA_Id__c</fullName>
        <label>ServiceAppointment Id (espejo TD)</label>
        <length>18</length>
        <type>Text</type>
        <externalId>true</externalId>
        <unique>false</unique>
        <description>HU-009: Id del ServiceAppointment origen del Event espejo del Test Drive. Clave de match del flow de sincronizacion unidireccional (evita duplicados en reprogramaciones).</description>
        <required>false</required>
    </fields>
</CustomObject>
