<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <enableHistory>true</enableHistory>
    <fields>
        <fullName>ChannelCode__c</fullName>
        <label>Canal Originador (Código de Canal)</label>
        <length>50</length>
        <type>Text</type>
        <description>HU-009: canal que origino la oportunidad. Se llena por Lead Conversion Mapping desde Lead.ChannelCode__c (nativo) - no por flow.</description>
        <required>false</required>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>AsesorDigitalOriginador__c</fullName>
        <label>Asesor Digital Originador</label>
        <type>Lookup</type>
        <referenceTo>User</referenceTo>
        <relationshipLabel>Oportunidades Originadas (Digital)</relationshipLabel>
        <relationshipName>OppsOriginadasDigital</relationshipName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>HU-009: asesor digital que origino la oportunidad. Estampado por el flow de hand-off (Owner al agendar la primera actividad presencial), inmutable despues.</description>
        <required>false</required>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>FechaHandOff__c</fullName>
        <label>Fecha de Hand-Off</label>
        <type>DateTime</type>
        <description>HU-009: momento en que se ejecuto Recibir Cliente (cambio de Owner al asesor presencial).</description>
        <required>false</required>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>EstadoHandOff__c</fullName>
        <label>Estado Hand-Off</label>
        <type>Picklist</type>
        <description>HU-009: estado operativo del hand-off. Sin hand-off (default) / Pendiente Recepcion (al agendar actividad presencial o enviar preaprobacion) / Recibido (tras Recibir Cliente).</description>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>Sin hand-off</fullName><default>true</default><label>Sin hand-off</label></value>
                <value><fullName>Pendiente Recepción</fullName><default>false</default><label>Pendiente Recepción</label></value>
                <value><fullName>Recibido</fullName><default>false</default><label>Recibido</label></value>
            </valueSetDefinition>
        </valueSet>
    </fields>
</CustomObject>
