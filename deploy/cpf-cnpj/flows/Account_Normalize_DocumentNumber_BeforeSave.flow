<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>

    <assignments>
        <name>Assign_Mask_CPF</name>
        <label>Assign Mask CPF</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>$Record.DocumentNumber__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>fCpfMasked</elementReference></value>
        </assignmentItems>
    </assignments>

    <assignments>
        <name>Assign_Mask_CNPJ</name>
        <label>Assign Mask CNPJ</label>
        <locationX>440</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>$Record.DocumentNumber__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>fCnpjMasked</elementReference></value>
        </assignmentItems>
    </assignments>

    <decisions>
        <name>Decision_Document_Type</name>
        <label>Decision Document Type</label>
        <locationX>308</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Nao Formatar</defaultConnectorLabel>
        <rules>
            <name>Is_CPF</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fIsCpf</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Assign_Mask_CPF</targetReference></connector>
            <label>Is CPF</label>
        </rules>
        <rules>
            <name>Is_CNPJ</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fIsCnpj</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Assign_Mask_CNPJ</targetReference></connector>
            <label>Is CNPJ</label>
        </rules>
    </decisions>

    <environments>Default</environments>

    <formulas>
        <name>fStripped</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!$Record.DocumentNumber__c}, ".", ""), "-", ""), "/", ""), "(", ""), ")", ""), " ", "")</expression>
    </formulas>

    <formulas>
        <name>fIsCpf</name>
        <dataType>Boolean</dataType>
        <expression>AND(LEN({!fStripped}) = 11, ISNUMBER({!fStripped}))</expression>
    </formulas>

    <formulas>
        <name>fIsCnpj</name>
        <dataType>Boolean</dataType>
        <expression>AND(LEN({!fStripped}) = 14, ISNUMBER(RIGHT({!fStripped}, 2)))</expression>
    </formulas>

    <formulas>
        <name>fCpfMasked</name>
        <dataType>String</dataType>
        <expression>LEFT({!fStripped}, 3) &amp; "." &amp; MID({!fStripped}, 4, 3) &amp; "." &amp; MID({!fStripped}, 7, 3) &amp; "-" &amp; RIGHT({!fStripped}, 2)</expression>
    </formulas>

    <formulas>
        <name>fCnpjMasked</name>
        <dataType>String</dataType>
        <expression>LEFT(UPPER({!fStripped}), 2) &amp; "." &amp; MID(UPPER({!fStripped}), 3, 3) &amp; "." &amp; MID(UPPER({!fStripped}), 6, 3) &amp; "/" &amp; MID(UPPER({!fStripped}), 9, 4) &amp; "-" &amp; RIGHT(UPPER({!fStripped}), 2)</expression>
    </formulas>

    <interviewLabel>Account Normalize DocumentNumber {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Normalize DocumentNumber BeforeSave</label>
    <processType>AutoLaunchedFlow</processType>

    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Decision_Document_Type</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DocumentNumber__c</field>
            <operator>IsNull</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <filters>
            <field>DocumentNumber__c</field>
            <operator>NotEqualTo</operator>
            <value><stringValue></stringValue></value>
        </filters>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>

    <status>Active</status>
</Flow>
