<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>RequestedParts__c</fullName>
        <label>Repuestos a cotizar</label>
        <type>LongTextArea</type>
        <length>32768</length>
        <visibleLines>5</visibleLines>
        <inlineHelpText>Repuestos o productos que el cliente solicitó cotizar, recibidos del lead en la conversión.</inlineHelpText>
        <description>Business purpose: parts or products the customer asked to quote, received from the lead on conversion (Repuestos a cotizar, US-001 follow-up BUG). When used: reference for advisors and for the Repuestos guided selling flow when building the quote. Dependencies: populated by the lead convert field mapping (LeadConvertSettings) from Lead.RequestedParts__c. Country considerations: label and help text in Spanish for all countries.</description>
    </fields>
    <validationRules>
        <fullName>Currency_Matches_Country</fullName>
        <active>true</active>
        <description>Blocks currencies not allowed for the opportunity country (Pais__c; map in CountryCurrency__mdt, Sales+Financial 04/08/2026). Runs on UI, API and loads. Skips blank, NA and unmapped countries.</description>
        <errorConditionFormula>AND(
    NOT(ISBLANK(Pais__c)),
    Pais__c &lt;&gt; 'NA',
    CASE(Pais__c,
        'CR', $CustomMetadata.CountryCurrency__mdt.CR.AllowedCurrencies__c,
        'GT', $CustomMetadata.CountryCurrency__mdt.GT.AllowedCurrencies__c,
        'SV', $CustomMetadata.CountryCurrency__mdt.SV.AllowedCurrencies__c,
        'HN', $CustomMetadata.CountryCurrency__mdt.HN.AllowedCurrencies__c,
        'NI', $CustomMetadata.CountryCurrency__mdt.NI.AllowedCurrencies__c,
        'PA', $CustomMetadata.CountryCurrency__mdt.PA.AllowedCurrencies__c,
        '') &lt;&gt; '',
    NOT(CONTAINS(
        CASE(Pais__c,
            'CR', $CustomMetadata.CountryCurrency__mdt.CR.AllowedCurrencies__c,
            'GT', $CustomMetadata.CountryCurrency__mdt.GT.AllowedCurrencies__c,
            'SV', $CustomMetadata.CountryCurrency__mdt.SV.AllowedCurrencies__c,
            'HN', $CustomMetadata.CountryCurrency__mdt.HN.AllowedCurrencies__c,
            'NI', $CustomMetadata.CountryCurrency__mdt.NI.AllowedCurrencies__c,
            'PA', $CustomMetadata.CountryCurrency__mdt.PA.AllowedCurrencies__c,
            ''),
        TEXT(CurrencyIsoCode)
    ))
)</errorConditionFormula>
        <errorMessage>La moneda seleccionada no está permitida para el país de esta oportunidad. Verifique las monedas habilitadas para su sociedad.</errorMessage>
    </validationRules>
</CustomObject>
