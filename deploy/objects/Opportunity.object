<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>Currency_Matches_Country</fullName>
        <active>true</active>
        <description>Blocks currencies not allowed for the opportunity country (Pais__c; map in CountryCurrency__mdt, Sales+Financial 04/08/2026). Runs on UI, API and loads. Skips blank, NA and unmapped countries.</description>
        <errorConditionFormula>AND(
    NOT(ISBLANK(Pais__c)),
    Pais__c &lt;&gt; 'NA',
    CASE(Pais__c,
        'CR', $CustomMetadata.CountryCurrency__mdt.CR.AllowedCurrencies__c,
        'GT', $CustomMetadata.CountryCurrency__mdt.GT.AllowedCurrencies__c,
        'SV', $CustomMetadata.CountryCurrency__mdt.SV.AllowedCurrencies__c,
        'HN', $CustomMetadata.CountryCurrency__mdt.HN.AllowedCurrencies__c,
        'NI', $CustomMetadata.CountryCurrency__mdt.NI.AllowedCurrencies__c,
        'PA', $CustomMetadata.CountryCurrency__mdt.PA.AllowedCurrencies__c,
        '') &lt;&gt; '',
    NOT(CONTAINS(
        CASE(Pais__c,
            'CR', $CustomMetadata.CountryCurrency__mdt.CR.AllowedCurrencies__c,
            'GT', $CustomMetadata.CountryCurrency__mdt.GT.AllowedCurrencies__c,
            'SV', $CustomMetadata.CountryCurrency__mdt.SV.AllowedCurrencies__c,
            'HN', $CustomMetadata.CountryCurrency__mdt.HN.AllowedCurrencies__c,
            'NI', $CustomMetadata.CountryCurrency__mdt.NI.AllowedCurrencies__c,
            'PA', $CustomMetadata.CountryCurrency__mdt.PA.AllowedCurrencies__c,
            ''),
        TEXT(CurrencyIsoCode)
    ))
)</errorConditionFormula>
        <errorMessage>La moneda seleccionada no está permitida para el país de esta oportunidad. Verifique las monedas habilitadas para su sociedad.</errorMessage>
    </validationRules>
</CustomObject>
