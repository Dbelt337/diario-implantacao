	<language>English</language>
	<name>CrearCotizacion</name>
	<omniProcessElements>
		<description>Corta si no llega ContextId.</description>
		<isActive>true</isActive>
		<isOmniScriptEmbeddable>false</isOmniScriptEmbeddable>
		<level>0.0</level>
		<name>ReturnIfNoContext</name>
		<omniProcessVersionNumber>0.0</omniProcessVersionNumber>
		<propertySetConfig>{
  "returnFullDataJSON": false,
  "returnOnlyAdditionalOutput": true,
  "elementValueMap": {},
  "responseFormat": "",
  "isActive": true,
  "responseJSONPath": "",
  "responseJSONNode": "",
  "executionConditionalFormula": "ISBLANK(%ContextId%)",
  "additionalOutput": {
    "success": false,
    "status": "error",
    "message": "Falta ContextId (Id de Cuenta u Oportunidad)."
  },
  "sendJSONPath": "",
  "id": "",
  "restOptions": {},
  "sendJSONNode": ""
}</propertySetConfig>
		<sequenceNumber>1.0</sequenceNumber>
		<type>Response Action</type>
	</omniProcessElements>
	<omniProcessElements>
		<description>Arma el node quote y detecta 001/006.</description>
		<isActive>true</isActive>
		<isOmniScriptEmbeddable>false</isOmniScriptEmbeddable>
		<level>0.0</level>
		<name>Prep</name>
		<omniProcessVersionNumber>0.0</omniProcessVersionNumber>
		<propertySetConfig>{
  "elementValueMap": {
    "objTipo": "=LEFT(%ContextId%,3)",
    "quote:Name": "=CONCAT(\"Cotizacion \",TEXT(TODAY()))",
    "quote:Status": "Draft",
    "quote:ExpirationDate": "=TODAY()+30",
    "quote:AccountId": "=IF(LEFT(%ContextId%,3)==\"001\",%ContextId%,\"\")",
    "quote:OpportunityId": "=IF(LEFT(%ContextId%,3)==\"006\",%ContextId%,\"\")"
  },
  "isActive": true,
  "id": "",
  "executionConditionalFormula": ""
}</propertySetConfig>
		<sequenceNumber>2.0</sequenceNumber>
		<type>Set Values</type>
	</omniProcessElements>
	<omniProcessElements>
		<description>Inserta la Quote via DataRaptor DRQuoteInsert.</description>
