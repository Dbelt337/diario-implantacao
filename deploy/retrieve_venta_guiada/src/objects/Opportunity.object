    <validationRules>
        <fullName>Currency_Matches_Country</fullName>
        <active>true</active>
        <description>Blocks currencies not allowed for the opportunity country (Pais__c; map in CountryCurrency__mdt, Sales+Financial 04/08/2026). Runs on UI, API and loads. Skips blank, NA and unmapped countries.</description>
        <errorConditionFormula>AND(
    NOT(ISBLANK(Pais__c)),
    Pais__c &lt;&gt; &apos;NA&apos;,
    CASE(Pais__c,
        &apos;CR&apos;, $CustomMetadata.CountryCurrency__mdt.CR.AllowedCurrencies__c,
        &apos;GT&apos;, $CustomMetadata.CountryCurrency__mdt.GT.AllowedCurrencies__c,
        &apos;SV&apos;, $CustomMetadata.CountryCurrency__mdt.SV.AllowedCurrencies__c,
        &apos;HN&apos;, $CustomMetadata.CountryCurrency__mdt.HN.AllowedCurrencies__c,
        &apos;NI&apos;, $CustomMetadata.CountryCurrency__mdt.NI.AllowedCurrencies__c,
        &apos;PA&apos;, $CustomMetadata.CountryCurrency__mdt.PA.AllowedCurrencies__c,
        &apos;&apos;) &lt;&gt; &apos;&apos;,
    NOT(CONTAINS(
        CASE(Pais__c,
            &apos;CR&apos;, $CustomMetadata.CountryCurrency__mdt.CR.AllowedCurrencies__c,
            &apos;GT&apos;, $CustomMetadata.CountryCurrency__mdt.GT.AllowedCurrencies__c,
            &apos;SV&apos;, $CustomMetadata.CountryCurrency__mdt.SV.AllowedCurrencies__c,
            &apos;HN&apos;, $CustomMetadata.CountryCurrency__mdt.HN.AllowedCurrencies__c,
            &apos;NI&apos;, $CustomMetadata.CountryCurrency__mdt.NI.AllowedCurrencies__c,
            &apos;PA&apos;, $CustomMetadata.CountryCurrency__mdt.PA.AllowedCurrencies__c,
            &apos;&apos;),
        TEXT(CurrencyIsoCode)
    ))
)</errorConditionFormula>
        <errorMessage>La moneda seleccionada no está permitida para el país de esta oportunidad. Verifique las monedas habilitadas para su sociedad.</errorMessage>
    </validationRules>
</CustomObject>
