<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>All countries. Asynchronous result of the order sent to SAP through MuleSoft; consumed by the guided-selling UI via empApi with scoped subscription and channel filters (platform event governance of the sales guide).</description>
    <eventType>HighVolume</eventType>
    <fields>
        <fullName>ErrorMessage__c</fullName>
        <description>All countries. Error detail when the SAP send fails.</description>
        <externalId>false</externalId>
        <isFilteringDisabled>false</isFilteringDisabled>
        <isNameField>false</isNameField>
        <isSortingDisabled>false</isSortingDisabled>
        <label>Mensaje de Error</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>OrderId__c</fullName>
        <description>All countries. Salesforce order the response belongs to; also the channel filter key.</description>
        <externalId>false</externalId>
        <isFilteringDisabled>false</isFilteringDisabled>
        <isNameField>false</isNameField>
        <isSortingDisabled>false</isSortingDisabled>
        <label>Id del Pedido</label>
        <length>18</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SapOrderNumber__c</fullName>
        <description>All countries. Order number returned by SAP on confirmation.</description>
        <externalId>false</externalId>
        <isFilteringDisabled>false</isFilteringDisabled>
        <isNameField>false</isNameField>
        <isSortingDisabled>false</isSortingDisabled>
        <label>Número de Pedido SAP</label>
        <length>40</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>All countries. Confirmado o error; el retorno de factura NO usa este evento (llega por actualización del pedido).</description>
        <externalId>false</externalId>
        <isFilteringDisabled>false</isFilteringDisabled>
        <isNameField>false</isNameField>
        <isSortingDisabled>false</isSortingDisabled>
        <label>Estado</label>
        <length>40</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Respuesta de Pedido SAP</label>
    <pluralLabel>Respuestas de Pedido SAP</pluralLabel>
    <publishBehavior>PublishAfterCommit</publishBehavior>
</CustomObject>
