<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>NotifyOwnerFacturado</name>
        <label>Action: Notificar pedido facturado</label>
        <locationX>0</locationX><locationY>500</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <connector><targetReference>CreateDeliveryTask</targetReference></connector>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value><elementReference>GetNotificationType.Id</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value><elementReference>recipientIds</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value><stringValue>Pedido facturado en SAP</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value><elementReference>notifBody</elementReference></value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>AddOwnerRecipient</name>
        <label>Assignment: Destinatario = dueño del pedido</label>
        <locationX>0</locationX><locationY>400</locationY>
        <assignmentItems>
            <assignToReference>recipientIds</assignToReference>
            <operator>Add</operator>
            <value><elementReference>$Record.OwnerId</elementReference></value>
        </assignmentItems>
        <connector><targetReference>NotifyOwnerFacturado</targetReference></connector>
    </assignments>
    <decisions>
        <name>HasNotificationType</name>
        <label>Decision: ¿Existe el tipo de notificación?</label>
        <locationX>200</locationX><locationY>300</locationY>
        <defaultConnector><targetReference>CreateDeliveryTask</targetReference></defaultConnector>
        <defaultConnectorLabel>Sin tipo — solo tarea</defaultConnectorLabel>
        <rules>
            <name>TypeFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetNotificationType</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>AddOwnerRecipient</targetReference></connector>
            <label>Tipo encontrado</label>
        </rules>
    </decisions>
    <decisions>
        <name>TieneVehiculo</name>
        <label>Decision: ¿La venta tiene unidad (Vehiculo__c)?</label>
        <locationX>200</locationX><locationY>800</locationY>
        <defaultConnectorLabel>Sin unidad (repuestos/PA) — fin</defaultConnectorLabel>
        <rules>
            <name>ConVehiculo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetOpportunityVenta</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetOpportunityVenta.Vehiculo__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>GetVehicleUnit</targetReference></connector>
            <label>Con unidad</label>
        </rules>
    </decisions>
    <decisions>
        <name>TieneAsset</name>
        <label>Decision: ¿La unidad tiene Asset?</label>
        <locationX>200</locationX><locationY>1000</locationY>
        <defaultConnectorLabel>Sin asset — fin</defaultConnectorLabel>
        <rules>
            <name>ConAsset</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetVehicleUnit</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetVehicleUnit.AssetId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>CreateSoldMilestone</targetReference></connector>
            <label>Con asset</label>
        </rules>
    </decisions>
    <description>v2 (fase 4). Arranque del flujo de entrega cuando MuleSoft marca el pedido como Facturado: notifica al dueño, crea la tarea de entrega y REGISTRA EL MARCO OFICIAL en la historia del vehículo — AssetMilestone tipo Sold (modelo Automotive: Order Received/Sold/Delivered), resuelto por Order → Opportunity.Vehiculo__c → Vehicle.AssetId (gate HU-025). Sin unidad (repuestos/PA) o sin asset: solo notificación+tarea. El marco Delivered y el Action Plan del ritual de entrega llegan con el paquete de assetización.</description>
    <environments>Default</environments>
    <formulas>
        <name>notifBody</name>
        <dataType>String</dataType>
        <expression>'El pedido ' &amp; {!$Record.OrderNumber} &amp; ' fue facturado en SAP (factura ' &amp; {!$Record.SapInvoiceNumber__c} &amp; '). Inicia el proceso de entrega.'</expression>
    </formulas>
    <formulas>
        <name>taskSubject</name>
        <dataType>String</dataType>
        <expression>'[Entrega] Pedido facturado — ' &amp; {!$Record.OrderNumber}</expression>
    </formulas>
    <formulas>
        <name>milestoneName</name>
        <dataType>String</dataType>
        <expression>'Venta — pedido ' &amp; {!$Record.OrderNumber}</expression>
    </formulas>
    <interviewLabel>Order Facturado Handler {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Order Facturado Handler</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>CreateDeliveryTask</name>
        <label>Create Records: Tarea de entrega</label>
        <locationX>200</locationX><locationY>600</locationY>
        <connector><targetReference>GetOpportunityVenta</targetReference></connector>
        <inputAssignments>
            <field>Subject</field>
            <value><elementReference>taskSubject</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value><elementReference>notifBody</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value><elementReference>$Record.OwnerId</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value><stringValue>Not Started</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value><elementReference>$Flow.CurrentDate</elementReference></value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>CreateSoldMilestone</name>
        <label>Create Records: Marco Sold en la unidad</label>
        <locationX>200</locationX><locationY>1100</locationY>
        <inputAssignments>
            <field>Name</field>
            <value><elementReference>milestoneName</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>AssetId</field>
            <value><elementReference>GetVehicleUnit.AssetId</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>VehicleId</field>
            <value><elementReference>GetVehicleUnit.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>MilestoneDate</field>
            <value><elementReference>$Flow.CurrentDate</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>MilestoneType</field>
            <value><stringValue>Sold</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Stage</field>
            <value><stringValue>Active</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>UsageType</field>
            <value><stringValue>Automotive</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value><elementReference>notifBody</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>SourceSystemName</field>
            <value><stringValue>SAP</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>SourceSystemIdentifier</field>
            <value><elementReference>$Record.SapInvoiceNumber__c</elementReference></value>
        </inputAssignments>
        <object>AssetMilestone</object>
    </recordCreates>
    <recordLookups>
        <name>GetNotificationType</name>
        <label>Get Records: Tipo de notificación</label>
        <locationX>200</locationX><locationY>200</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>HasNotificationType</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value><stringValue>SapOrderAlert</stringValue></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetOpportunityVenta</name>
        <label>Get Records: Oportunidad de la venta</label>
        <locationX>200</locationX><locationY>700</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>TieneVehiculo</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.OpportunityId</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetVehicleUnit</name>
        <label>Get Records: Unidad (Vehicle)</label>
        <locationX>200</locationX><locationY>900</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>TieneAsset</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>GetOpportunityVenta.Vehiculo__c</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vehicle</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>200</locationX><locationY>50</locationY>
        <connector><targetReference>GetNotificationType</targetReference></connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SapStatus__c</field>
            <operator>EqualTo</operator>
            <value><stringValue>Facturado</stringValue></value>
        </filters>
        <object>Order</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>recipientIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
