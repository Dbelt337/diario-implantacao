<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Grants access to the MuleSoft integration principal used by the guided selling flow (parts catalog search and SAP price/stock lookup). Dependencies: MuleSoft_EC principal MulePrincipal, MuleSoftPricesInventory named credential. Assign to sales profiles.</description>
    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal>MuleSoft_EC-MulePrincipal</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>
    <classAccesses>
        <apexClass>GuidedSellingController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <hasActivationRequired>false</hasActivationRequired>
    <label>GQ Mule Integration</label>
</PermissionSet>
