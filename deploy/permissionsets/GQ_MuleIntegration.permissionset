<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Business purpose: grants sales users access to the MuleSoft integration principal used by the guided selling flow (parts catalog search and SAP price/stock lookup). When used: assigned to sales profiles together with the guided selling components. Dependencies: External Credential MuleSoft_EC (principal MulePrincipal), Named Credential MuleSoftPricesInventory, Apex services of the sales flow. Country considerations: none, single principal for all countries.</description>
    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal>MuleSoft_EC-MulePrincipal</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>
    <classAccesses>
        <apexClass>GuidedSellingController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <hasActivationRequired>false</hasActivationRequired>
    <label>GQ Mule Integration</label>
</PermissionSet>
