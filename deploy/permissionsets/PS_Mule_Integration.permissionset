<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Grants access to the MuleSoft integration used by the guided selling flow (parts catalog search and SAP price/stock lookup). Dependencies: external credential MuleSoft_EC (grant principal access in this permission set via Setup), named credential MuleGateway.</description>
    <classAccesses>
        <apexClass>GuidedSellingController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <hasActivationRequired>false</hasActivationRequired>
    <label>PS Mule Integration</label>
</PermissionSet>
