<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <decisions>
        <name>AlertAlreadySent</name>
        <label>Decision: Alert Already Sent?</label>
        <locationX>446</locationX>
        <locationY>576</locationY>
        <defaultConnectorLabel>Alert Exists</defaultConnectorLabel>
        <rules>
            <name>NoAlertYet</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetExistingAlertTask</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CreateAlertTask</targetReference>
            </connector>
            <label>No Alert Yet</label>
        </rules>
    </decisions>
    <decisions>
        <name>EvaluateInactivity</name>
        <label>Decision: Days Inactive?</label>
        <locationX>446</locationX>
        <locationY>360</locationY>
        <defaultConnectorLabel>Active</defaultConnectorLabel>
        <rules>
            <name>ReadyToClose</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>daysInactive</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>GetInactivityPolicy.DaysToClose__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CloseOpportunity</targetReference>
            </connector>
            <label>Ready To Close</label>
        </rules>
        <rules>
            <name>AlertWindow</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>daysInactive</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>GetInactivityPolicy.DaysToAlert__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetExistingAlertTask</targetReference>
            </connector>
            <label>Alert Window</label>
        </rules>
    </decisions>
    <description>All countries. Daily scheduled evaluation of open opportunities by inactivity, measured on LastActivityDate (falls back to CreatedDate when no activity exists; the standard field already counts scheduled follow-up events). At the configured alert threshold it creates a single warning task for the owner (deduplicated by subject); at the configured close threshold it closes the opportunity as lost. The close reason is written to Loss_Reason__c from the policy value, confirmed by HU-024 on 17/08/2026. All parameters (days, lost stage, texts, close reason value) live in the InactivityPolicy custom metadata type: the business tunes them per environment in Setup without redeploying the flow. If no policy record exists the flow safely does nothing. Origin: automatic closure by inactivity user story (draft under admission).</description>
    <environments>Default</environments>
    <formulas>
        <name>daysInactive</name>
        <dataType>Number</dataType>
        <expression>TODAY() - IF(ISBLANK({!$Record.LastActivityDate}), DATEVALUE({!$Record.CreatedDate}), {!$Record.LastActivityDate})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>plannedCloseDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + ({!GetInactivityPolicy.DaysToClose__c} - {!daysInactive})</expression>
    </formulas>
    <interviewLabel>Close Inactive Opportunities {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Close Inactive Opportunities</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>CreateAlertTask</name>
        <label>Create Alert Task</label>
        <locationX>314</locationX>
        <locationY>684</locationY>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>plannedCloseDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>Esta oportunidad no registra seguimiento (actividades completadas o programadas). Si no se registra una actividad, será cerrada automáticamente en la fecha de vencimiento de esta tarea, con motivo de cierre por inactividad.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>GetInactivityPolicy.AlertTaskSubject__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>CreateClosureTask</name>
        <label>Create Closure Notice Task</label>
        <locationX>50</locationX>
        <locationY>576</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>Cierre automático: la oportunidad superó el plazo de inactividad definido por el negocio. Si el cliente vuelve a contactar, la solicitud pasa por el proceso de asignación vigente.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Oportunidad cerrada automáticamente por inactividad</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>GetExistingAlertTask</name>
        <label>Get Records: Get Existing Alert Task</label>
        <locationX>446</locationX>
        <locationY>468</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>AlertAlreadySent</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhatId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Subject</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GetInactivityPolicy.AlertTaskSubject__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetInactivityPolicy</name>
        <label>Get Records: Get Inactivity Policy</label>
        <locationX>446</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>EvaluateInactivity</targetReference>
        </connector>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>InactivityPolicy__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>CloseOpportunity</name>
        <label>Close Opportunity As Lost</label>
        <locationX>50</locationX>
        <locationY>468</locationY>
        <connector>
            <targetReference>CreateClosureTask</targetReference>
        </connector>
        <inputAssignments>
            <field>Loss_Reason__c</field>
            <value>
                <elementReference>GetInactivityPolicy.CloseReasonValue__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <elementReference>GetInactivityPolicy.LostStageName__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>320</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetInactivityPolicy</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <schedule>
            <dayOfMonthToRun>0</dayOfMonthToRun>
            <frequency>Daily</frequency>
            <frequencyNumber>0</frequencyNumber>
            <startDate>2026-07-24</startDate>
            <startTime>06:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
