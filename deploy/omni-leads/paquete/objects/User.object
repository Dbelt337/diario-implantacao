<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>RoutesLeadsToQueue__c</fullName>
        <label>Rutea leads a la cola</label>
        <type>Checkbox</type>
        <defaultValue>false</defaultValue>
        <description>Todos los países. Marcar SOLO en los usuarios técnicos de canales digitales: usuario de integración (Mule), Default Lead Creator del Web-to-Lead y guest users de portales. El flow Lead Before Handler envía a la cola Omni los leads creados por usuarios con esta marca; los leads creados por vendedores en la UI permanecen con su creador (requisito del ruteo de leads digitales). Nunca marcar en vendedores.</description>
        <trackHistory>false</trackHistory>
    </fields>
</CustomObject>
