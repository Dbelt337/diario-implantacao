<?xml version="1.0" encoding="UTF-8"?>
<!--
  US-005 Fase 3 - Duplicate Rule. Politica: ALERTAR E PERMITIR, nunca bloquear.
  Referencia a matching rule GQ_Lead_Repuestos_Match (que ja precisa estar ATIVA - Fase 2).
  actionOnInsert/Update=Allow (nunca Block); operationsOnInsert/Update=Alert.
-->
<DuplicateRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionOnInsert>Allow</actionOnInsert>
    <actionOnUpdate>Allow</actionOnUpdate>
    <alertText>Se encontraron Leads que podrian ser duplicados (mismo contacto o pieza). Puede guardar de todas formas.</alertText>
    <description>US-005: alerta de Lead de Repuestos duplicado. Nunca bloquea (Alert + Allow).</description>
    <duplicateRuleMatchRules>
        <matchRuleSObjectType>Lead</matchRuleSObjectType>
        <matchingRule>GQ_Lead_Repuestos_Match</matchingRule>
    </duplicateRuleMatchRules>
    <isActive>true</isActive>
    <masterLabel>GQ Lead Repuestos Dup</masterLabel>
    <operationsOnInsert>Alert</operationsOnInsert>
    <operationsOnUpdate>Alert</operationsOnUpdate>
    <securityOption>EnforceSharingRules</securityOption>
    <sortOrder>1</sortOrder>
</DuplicateRule>
