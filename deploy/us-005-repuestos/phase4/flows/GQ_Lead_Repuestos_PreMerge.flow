<?xml version="1.0" encoding="UTF-8"?>
<!--
  US-005 - GQ_Lead_Repuestos_PreMerge (Screen Flow). Roda no Lead MASTER (recordId).
  Prepara os campos ANTES do merge nativo (que e' acao manual do usuario):
   - Master: WasUnified__c=true, UnifiedFromLeadId__c = ID do lead duplicado.
   - Lead duplicado (a ser inativado): DuplicateReason__c = motivo escolhido.
  NAO executa o merge, NAO chama Database.merge, NAO deleta. So prepara campos.
  runInMode SystemModeWithSharing: grava os campos de trazabilidade (read-only no FLS)
  respeitando o sharing.
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <choices>
        <name>Choice_MismaPieza</name>
        <choiceText>Duplicado - Misma Pieza</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Duplicado_MismaPieza</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_MismoContacto</name>
        <choiceText>Duplicado - Mismo Contacto</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Duplicado_MismoContacto</stringValue>
        </value>
    </choices>
    <environments>Default</environments>
    <interviewLabel>GQ_Lead_Repuestos_PreMerge {!$Flow.CurrentDateTime}</interviewLabel>
    <label>GQ_Lead_Repuestos_PreMerge</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordUpdates>
        <name>Update_Dup</name>
        <label>Update Lead Duplicado</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Tela_Fim</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Tela_Erro</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>In_DupLeadId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>DuplicateReason__c</field>
            <value>
                <elementReference>In_Reason</elementReference>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Master</name>
        <label>Update Lead Master</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Dup</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Tela_Erro</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>WasUnified__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>UnifiedFromLeadId__c</field>
            <value>
                <elementReference>In_DupLeadId</elementReference>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <runInMode>SystemModeWithSharing</runInMode>
    <screens>
        <name>Preparar</name>
        <label>Preparar Unificacion</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Update_Master</targetReference>
        </connector>
        <fields>
            <name>In_DupLeadId</name>
            <dataType>String</dataType>
            <fieldText>ID del Lead duplicado (que sera inactivado en el merge nativo)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>In_Reason</name>
            <choiceReferences>Choice_MismaPieza</choiceReferences>
            <choiceReferences>Choice_MismoContacto</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Motivo de la inactivacion</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Tela_Erro</name>
        <label>Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>MsgErro</name>
            <fieldText>&lt;p&gt;No se pudieron preparar los campos. Detalle: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Tela_Fim</name>
        <label>Listo</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>MsgFim</name>
            <fieldText>&lt;p&gt;Campos preparados. Ahora ejecute el &lt;b&gt;merge nativo&lt;/b&gt; de Leads desde la interfaz.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Preparar</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
