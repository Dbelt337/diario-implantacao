<?xml version="1.0" encoding="UTF-8"?>
<!--
  US-005 - GQ_Lead_Repuestos_Reasignacion_y_Cotizacion (Record-Triggered, Lead CREATE,
  ASYNC AFTER COMMIT para os LeadLineItem ja existirem; create-only evita re-disparo).

  Camada 2 (filho LeadLineItem):
   - Le o LeadLineItem do lead novo. Sem item -> sai.
   - Repuestos? NATIVO ItemType IN (Part, Accessory). Se nao -> sai.
   - VINCULO AO VEICULO REAL (por IGUALDADE de VIN, sem lookup): se AssetIdentificationNumber
     preenchido, busca Vehicle (VehicleIdentificationNumber =) e, senao, Asset (SerialNumber =).
     Se acha, LOGA o match numa Task pro asesor. >>> ver flag: registrar via Task (sem custom
     lookup) vs campo de texto no Lead - decisao pendente.
   - REASIGNACION: Lead anterior do mesmo contato (Email OR MobilePhone). Se o asesor anterior
     tem presenca Omni ativa -> atribui o lead novo a ele; senao nao mexe (roteamento padrao).
   - UNIFICACION (candidato, nao automatica): mesma peca (NATIVO ProductId) dentro da janela
     (CMT.RecurrenceWindowDays__c, 5 dias) -> popula UnifiedFromLeadId__c.
   - Nao bloqueia, nao deleta. Fault -> Task, sem perder lead.
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Asesor_Disponivel</name>
        <label>Asesor Disponivel</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_LineItem_Prev</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No disponible</defaultConnectorLabel>
        <rules>
            <name>Disponible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Presencia</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reasignar</targetReference>
            </connector>
            <label>Disponible</label>
        </rules>
    </decisions>
    <decisions>
        <name>Asset_Encontrado</name>
        <label>Asset Encontrado</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Lead_Anterior</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Hay_Asset</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Asset</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Log_Asset</targetReference>
            </connector>
            <label>Hay Asset</label>
        </rules>
    </decisions>
    <decisions>
        <name>Avalia_Unificacion</name>
        <label>Avalia Unificacion</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No es candidato</defaultConnectorLabel>
        <rules>
            <name>Candidato</name>
            <conditionLogic>1 AND 2 AND 3</conditionLogic>
            <conditions>
                <leftValueReference>Get_LineItem_Prev</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_LineItem_New.ProductId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_LineItem_Prev.ProductId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>dentroJanela</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Marcar_Candidato</targetReference>
            </connector>
            <label>Misma pieza dentro de la ventana</label>
        </rules>
    </decisions>
    <decisions>
        <name>Es_Repuestos</name>
        <label>Es Repuestos</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No es Repuestos/PA</defaultConnectorLabel>
        <rules>
            <name>Es_Parte_o_Accesorio</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>Get_LineItem_New.ItemType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Part</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_LineItem_New.ItemType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accessory</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Tiene_VIN</targetReference>
            </connector>
            <label>Es Parte o Accesorio</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tem_Anterior</name>
        <label>Tem Anterior</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Sin lead anterior</defaultConnectorLabel>
        <rules>
            <name>Existe_Anterior</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead_Anterior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Presencia</targetReference>
            </connector>
            <label>Existe anterior</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tiene_LineItem</name>
        <label>Tiene LineItem</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Sin LineItem</defaultConnectorLabel>
        <rules>
            <name>Hay_LineItem</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_LineItem_New</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Es_Repuestos</targetReference>
            </connector>
            <label>Hay LineItem</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tiene_VIN</name>
        <label>Tiene VIN</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Lead_Anterior</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sin VIN</defaultConnectorLabel>
        <rules>
            <name>Hay_VIN</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_LineItem_New.AssetIdentificationNumber</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Vehicle</targetReference>
            </connector>
            <label>Hay VIN</label>
        </rules>
    </decisions>
    <decisions>
        <name>Vehiculo_Encontrado</name>
        <label>Vehiculo Encontrado</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Asset</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No (intenta Asset)</defaultConnectorLabel>
        <rules>
            <name>Hay_Vehiculo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Vehicle</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Log_Vehiculo</targetReference>
            </connector>
            <label>Hay Vehiculo</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>dentroJanela</name>
        <dataType>Boolean</dataType>
        <expression>(TODAY() - DATEVALUE({!Get_Lead_Anterior.CreatedDate})) &lt; {!Get_Config.RecurrenceWindowDays__c}</expression>
    </formulas>
    <formulas>
        <name>descAsset</name>
        <dataType>String</dataType>
        <expression>"Cotizacion vinculada a Asset " &amp; {!Get_Asset.Id} &amp; " por coincidencia de VIN/Serial " &amp; {!Get_LineItem_New.AssetIdentificationNumber}</expression>
    </formulas>
    <formulas>
        <name>descVehiculo</name>
        <dataType>String</dataType>
        <expression>"Cotizacion vinculada a Vehicle " &amp; {!Get_Vehicle.Id} &amp; " por coincidencia de VIN " &amp; {!Get_LineItem_New.AssetIdentificationNumber}</expression>
    </formulas>
    <interviewLabel>GQ_Lead_Repuestos_Reasignacion_y_Cotizacion {!$Flow.CurrentDateTime}</interviewLabel>
    <label>GQ_Lead_Repuestos_Reasignacion_y_Cotizacion</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Log_Asset</name>
        <label>Log Asset</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Lead_Anterior</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Get_Lead_Anterior</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>descAsset</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Cotizacion vinculada a Asset por VIN</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>Log_Falha</name>
        <label>Log Falha</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Falha em GQ_Lead_Repuestos_Reasignacion_y_Cotizacion (US-005) - lead mantido</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>Log_Vehiculo</name>
        <label>Log Vehiculo</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Lead_Anterior</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Get_Lead_Anterior</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>descVehiculo</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Cotizacion vinculada a Vehicle por VIN</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Asset</name>
        <label>Get Asset</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Asset_Encontrado</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Get_Lead_Anterior</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SerialNumber</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_LineItem_New.AssetIdentificationNumber</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Asset</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Config</name>
        <label>Get Config</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_LineItem_New</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Default</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>GQ_Dedup_Repuestos_Config__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Lead_Anterior</name>
        <label>Get Lead Anterior</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Tem_Anterior</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>1 AND ((2 AND 3) OR (4 AND 5))</filterLogic>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Email</elementReference>
            </value>
        </filters>
        <filters>
            <field>Email</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>MobilePhone</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.MobilePhone</elementReference>
            </value>
        </filters>
        <filters>
            <field>MobilePhone</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_LineItem_New</name>
        <label>Get LineItem New</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Tiene_LineItem</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LeadId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>LeadLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_LineItem_Prev</name>
        <label>Get LineItem Prev</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Avalia_Unificacion</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LeadId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Lead_Anterior.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>LeadLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Presencia</name>
        <label>Get Presencia</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Asesor_Disponivel</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>UserId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Lead_Anterior.OwnerId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsCurrentState</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>UserServicePresence</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Vehicle</name>
        <label>Get Vehicle</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Vehiculo_Encontrado</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Get_Lead_Anterior</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>VehicleIdentificationNumber</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_LineItem_New.AssetIdentificationNumber</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vehicle</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Marcar_Candidato</name>
        <label>Marcar Candidato</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>UnifiedFromLeadId__c</field>
            <value>
                <elementReference>Get_Lead_Anterior.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Reasignar</name>
        <label>Reasignar</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_LineItem_Prev</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Get_Lead_Anterior.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <object>Lead</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Get_Config</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
