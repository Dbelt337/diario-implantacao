<?xml version="1.0" encoding="UTF-8"?>
<!--
  US-005 - Custom Metadata Type com os valores parametrizados (D-005-A/B/C).
  NUNCA hard-coded em formula: os Flows leem o registro 'Default' deste CMT.
  RepuestosLeadSource__c: valor de LeadSource que identifica linha Repuestos/PA.
    >>> ASSUNCAO a confirmar - ver flag no relatorio (qual campo/valor marca Repuestos).
-->
