<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>AvailabilityStatus__c</fullName>
        <description>HU-043 (GQ-PV-03-028): estado de disponibilidad de la línea informado por SAP vía MuleSoft al cotizar. Venta Perdida NO es un valor: esas líneas no se guardan (se trazan en la cotización; modelo en US-040/US-057).</description>
        <externalId>false</externalId>
        <label>Estado de disponibilidad</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>false</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>Disponible</fullName><default>false</default><label>Disponible</label></value>
                <value><fullName>Parcial</fullName><default>false</default><label>Parcial</label></value>
                <value><fullName>Otro Centro</fullName><default>false</default><label>Otro Centro</label></value>
                <value><fullName>Otra Sociedad</fullName><default>false</default><label>Otra Sociedad</label></value>
                <value><fullName>No Disponible</fullName><default>false</default><label>No Disponible</label></value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>AvailabilityDetail__c</fullName>
        <description>HU-043: leyenda de existencia/ubicación devuelta por SAP (texto de existencia) en la última consulta o revalidación de la línea.</description>
        <externalId>false</externalId>
        <label>Detalle de disponibilidad</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
</CustomObject>
