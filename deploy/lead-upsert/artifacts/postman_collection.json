{
  "info": {
    "name": "GrupoQ Lead Upsert API",
    "description": "Generated contract artifact for the GrupoQ native OmniStudio Integration Procedure lead upsert endpoint. Not auto-validated against a live org.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "instanceUrl",
      "value": "https://grupoq--devsales.sandbox.my.salesforce.com",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Lead mínimo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('status is success', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.status).to.eql('success');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"externalRequestId\": \"11111111-1111-4111-8111-111111111111\",\n  \"channelCode\": \"MULESOFT_FB\",\n  \"lead\": {\n    \"lastName\": \"Pérez\",\n    \"company\": \"Persona Física\",\n    \"leadSource\": \"WEB_FORLAND_LURUCA\"\n  }\n}"
        },
        "url": {
          "raw": "{{instanceUrl}}/services/apexrest/omnistudio/v1/integrationprocedure/GrupoQ_LeadUpsert/",
          "host": [
            "{{instanceUrl}}"
          ],
          "path": [
            "services",
            "apexrest",
            "omnistudio",
            "v1",
            "integrationprocedure",
            "GrupoQ_LeadUpsert",
            ""
          ]
        }
      }
    },
    {
