              "pm.test('status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('status is success and leadId present', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.status).to.eql('success');",
              "  pm.expect(json).to.have.property('leadId');",
              "  pm.expect(json.leadId).to.not.be.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
