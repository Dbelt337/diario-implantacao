<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <description>Deriva Lead.Sociedad__c como FALLBACK (nivel 4 $User.Sociedad__c, nivel 5 default config Lead_Routing_Config__mdt). Dispara so quando Sociedad__c IsNull. Plan A / Opcao 2: niveis 2 (dealer) e 3 (marca do produto) sao resolvidos na Lead_Upsert_IP, pois dependem de dados ausentes no Before-Save do Lead (dealerCode no payload e LeadLineItem filho). Removida a decisao quebrada LeadSource Contains Brand (LeadSource e picklist restrito, nunca casa marca).</description>
    <environments>Default</environments>
    <interviewLabel>Lead_BS_DeriveSociedad {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead BS DeriveSociedad</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Config</name>
        <label>Get Config</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_FinalResolution</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Default</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead_Routing_Config__mdt</object>
        <queriedFields>Default_Sociedad__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <decisions>
        <name>Decision_FinalResolution</name>
        <label>Decision Final Resolution</label>
        <locationX>176</locationX>
        <locationY>254</locationY>
        <defaultConnector>
            <targetReference>Assign_Final_Default</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Config</defaultConnectorLabel>
        <rules>
            <name>UserHasSociedad</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.Sociedad__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Final_FromUser</targetReference>
            </connector>
            <label>User Has Sociedad</label>
        </rules>
    </decisions>
    <assignments>
        <name>Assign_Final_FromUser</name>
        <label>Assign Final From User</label>
        <locationX>50</locationX>
        <locationY>374</locationY>
        <assignmentItems>
            <assignToReference>$Record.Sociedad__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$User.Sociedad__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Final_Default</name>
        <label>Assign Final Default</label>
        <locationX>302</locationX>
        <locationY>374</locationY>
        <assignmentItems>
            <assignToReference>$Record.Sociedad__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Config.Default_Sociedad__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Config</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Sociedad__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
