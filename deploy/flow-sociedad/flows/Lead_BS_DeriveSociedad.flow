            </connector>
            <label>Contains</label>
        </rules>
    </decisions>
    <description>Deriva Lead.Sociedad__c via Custom Metadata Type Brand_Sociedad_Map. Escalavel para 6 paises sem alterar Flow - basta adicionar registros CMT.</description>
    <environments>Default</environments>
    <interviewLabel>Lead_BS_DeriveSociedad {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead BS DeriveSociedad</label>
    <loops>
        <name>Loop_BrandMap</name>
        <label>Loop BrandMap</label>
        <locationX>314</locationX>
        <locationY>611</locationY>
        <collectionReference>Get_BrandMap</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
