<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>GetReferenceValueFromMatrix</name>
        <label>Action: Get Reference Value</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <actionName>PRU_Valor_Referencia</actionName>
        <actionType>decisionMatrixAction</actionType>
        <connector>
            <targetReference>ReferenceValueFound</targetReference>
        </connector>
        <inputParameters>
            <name>Pais</name>
            <value>
                <stringValue>CR</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Marca</name>
            <value>
                <elementReference>$Record.MakeName</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Modelo</name>
            <value>
                <elementReference>$Record.ModelName</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Anio</name>
            <value>
                <elementReference>$Record.ModelYear</elementReference>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>63.0</apiVersion>
    <decisions>
        <name>ReferenceValueFound</name>
        <label>Decision: Reference Value Found?</label>
        <locationX>176</locationX>
        <locationY>395</locationY>
        <defaultConnectorLabel>No Reference Value</defaultConnectorLabel>
        <rules>
            <name>ReferenceValueExists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetReferenceValueFromMatrix.ValorReferencia</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CreateProviderValuation</targetReference>
            </connector>
            <label>Reference Value Exists</label>
        </rules>
    </decisions>
    <description>All countries. After-save handler for Appraisal Item creation (used-vehicle trade-in appraisal). When the item has make, model and model year, looks up the reference value in the decision matrix (blue book), creates the provider valuation record and sets the item initial value. If the matrix returns no value, the item is left untouched and the appraiser enters the value manually. Origin: used-vehicle trade-in appraisal user story.</description>
    <environments>Default</environments>
    <interviewLabel>Appraisal Item After Handler {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Appraisal Item After Handler</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>CreateProviderValuation</name>
        <label>Create Provider Valuation</label>
        <locationX>176</locationX>
        <locationY>503</locationY>
        <connector>
            <targetReference>SetInitialValue</targetReference>
        </connector>
        <inputAssignments>
            <field>AppraisalItemId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ProviderName</field>
            <value>
                <stringValue>PRU</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ValuationDateTime</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AverageConditionValue</field>
            <value>
                <elementReference>GetReferenceValueFromMatrix.ValorReferencia</elementReference>
            </value>
        </inputAssignments>
        <object>AppraisalItemProviderVal</object>
    </recordCreates>
    <recordUpdates>
        <name>SetInitialValue</name>
        <label>Set Initial Value on Item</label>
        <locationX>176</locationX>
        <locationY>611</locationY>
        <inputAssignments>
            <field>InitialValue</field>
            <value>
                <elementReference>GetReferenceValueFromMatrix.ValorReferencia</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetReferenceValueFromMatrix</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>MakeName</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>ModelName</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>ModelYear</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>AppraisalItem</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
