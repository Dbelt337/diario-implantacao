<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>TradeInValue__c</fullName>
        <label>Valor de trade-in</label>
        <description>All countries. Accepted trade-in value of the customer used vehicle, stamped automatically by the appraisal closure flow (Appraisal After Handler) from FinalAppraisalValue when the appraisal is accepted. Consumed by the quotation to recalculate the net value. Created after verifying (describe 23/07/2026) that Opportunity and Quote have no native trade-in column in this org.</description>
        <type>Currency</type>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <trackHistory>false</trackHistory>
    </fields>
</CustomObject>
