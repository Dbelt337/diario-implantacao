<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>TrafficFines__c</fullName>
        <label>Multas (esquelas)</label>
        <description>All countries. Legal verification indicator for the used-vehicle trade-in appraisal: records whether the appraised vehicle has outstanding traffic fines (esquelas). Captured by the sales advisor before the appraisal can be accepted. Values are maintained by the business.</description>
        <type>Picklist</type>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Sí</fullName>
                    <default>false</default>
                    <label>Sí</label>
                </value>
                <value>
                    <fullName>No</fullName>
                    <default>false</default>
                    <label>No</label>
                </value>
                <value>
                    <fullName>Pendiente de verificación</fullName>
                    <default>true</default>
                    <label>Pendiente de verificación</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Liens__c</fullName>
        <label>Gravámenes</label>
        <description>All countries. Legal verification indicator for the used-vehicle trade-in appraisal: records whether the appraised vehicle has liens or encumbrances registered against it. Captured by the sales advisor before the appraisal can be accepted. Values are maintained by the business.</description>
        <type>Picklist</type>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Sí</fullName>
                    <default>false</default>
                    <label>Sí</label>
                </value>
                <value>
                    <fullName>No</fullName>
                    <default>false</default>
                    <label>No</label>
                </value>
                <value>
                    <fullName>Pendiente de verificación</fullName>
                    <default>true</default>
                    <label>Pendiente de verificación</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>LegalProceedings__c</fullName>
        <label>Procesos judiciales</label>
        <description>All countries. Legal verification indicator for the used-vehicle trade-in appraisal: records whether the appraised vehicle is involved in judicial proceedings. Captured by the sales advisor before the appraisal can be accepted. Values are maintained by the business.</description>
        <type>Picklist</type>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Sí</fullName>
                    <default>false</default>
                    <label>Sí</label>
                </value>
                <value>
                    <fullName>No</fullName>
                    <default>false</default>
                    <label>No</label>
                </value>
                <value>
                    <fullName>Pendiente de verificación</fullName>
                    <default>true</default>
                    <label>Pendiente de verificación</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>RejectionReason__c</fullName>
        <label>Motivo de rechazo</label>
        <description>All countries. Reason selected when the customer rejects the appraised trade-in value (appraisal Status = Rechazado). Feeds rejection reporting for the used-vehicle business. Value list is defined by the business per environment; unrestricted so admins can extend it without a deployment.</description>
        <type>Picklist</type>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <valueSet>
            <restricted>false</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Otro</fullName>
                    <default>false</default>
                    <label>Otro</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
</CustomObject>
