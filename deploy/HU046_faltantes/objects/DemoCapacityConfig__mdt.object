<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Demo Capacity Config</label>
    <pluralLabel>Demo Capacity Configs</pluralLabel>
    <visibility>Public</visibility>
    <description>Demo/Exhibition vehicle quotas per brand and branch. Applies to all countries (CR, GT, HN, NI, PA, SV). Initial load from the GrupoQ quota spreadsheet (HU-046, open point 1). Maintained via Setup by the profile designated by each brand. Consumed by the Validate Demo Quota flow.</description>
    <fields>
        <fullName>Brand__c</fullName>
        <label>Brand</label>
        <type>Text</type>
        <length>80</length>
        <required>true</required>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <description>Vehicle brand (e.g. CHEVROLET, ISUZU, HYUNDAI). All countries. Used as lookup key for demo quota validation (HU-046).</description>
    </fields>
    <fields>
        <fullName>BranchCode__c</fullName>
        <label>Branch Code</label>
        <type>Text</type>
        <length>40</length>
        <required>false</required>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <description>SAP branch code (e.g. C013). All countries. PENDING name-to-code mapping from GrupoQ; the quota spreadsheet provides names only (HU-046).</description>
    </fields>
    <fields>
        <fullName>MaxDemo__c</fullName>
        <label>Max Demo</label>
        <type>Number</type>
        <precision>18</precision>
        <scale>0</scale>
        <required>true</required>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <description>Maximum number of units in demo status for the brand+branch combination. All countries. Business rule RN-8 (HU-046).</description>
    </fields>
    <fields>
        <fullName>MaxExhibition__c</fullName>
        <label>Max Exhibition</label>
        <type>Number</type>
        <precision>18</precision>
        <scale>0</scale>
        <required>true</required>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <description>Maximum number of units in exhibition status for the brand+branch combination. All countries. Business rule RN-8 (HU-046).</description>
    </fields>
    <fields>
        <fullName>MaxDemoMileage__c</fullName>
        <label>Max Demo Mileage</label>
        <type>Number</type>
        <precision>18</precision>
        <scale>0</scale>
        <required>false</required>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <description>Maximum mileage before the unit is transferred to demo-sale status (GQ-CA-01-127). All countries. Values pending business policy (HU-046, open point 4).</description>
    </fields>
    <fields>
        <fullName>Country__c</fullName>
        <label>Country</label>
        <type>Text</type>
        <length>2</length>
        <required>true</required>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <description>ISO-style country code (CR, GT, HN, NI, PA, SV). Quotas are defined per country (HU-046).</description>
    </fields>
    <fields>
        <fullName>BranchName__c</fullName>
        <label>Branch Name</label>
        <type>Text</type>
        <length>80</length>
        <required>true</required>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <description>Branch name as provided in the GrupoQ quota spreadsheet (e.g. Uruca, Ayarco). All countries. Lookup key for demo quota validation (HU-046).</description>
    </fields>
    <fields>
        <fullName>Comments__c</fullName>
        <label>Comments</label>
        <type>Text</type>
        <length>255</length>
        <required>false</required>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <description>Comments carried over from the GrupoQ quota spreadsheet (e.g. closed branch). Traceability only (HU-046).</description>
    </fields>
</CustomObject>
