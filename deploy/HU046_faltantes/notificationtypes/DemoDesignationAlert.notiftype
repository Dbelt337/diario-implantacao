<?xml version="1.0" encoding="UTF-8"?>
<CustomNotificationType xmlns="http://soap.sforce.com/2006/04/metadata">
    <customNotifTypeName>DemoDesignationAlert</customNotifTypeName>
    <masterLabel>Demo Designation Alert</masterLabel>
