<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Creates the standardized audit Task for the demo vehicle lifecycle (HU-046, RN-6/7). All countries. Subject pattern: "[Demo] " + actionType (data is user-facing, kept in Spanish: Solicitud de designación | Asignación | Solicitud de liberación | Cancelación | Vencimiento). Inputs: vehicleId (WhatId), actionType, activityDetails, taskOwnerId, taskStatus (default Not Started; pass Completed for historical records). Output: taskId. The scheduled release flow filters open Tasks by the "[Demo] Asignación" subject.</description>
    <environments>Default</environments>
    <formulas>
        <name>activityDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>taskSubject</name>
        <dataType>String</dataType>
        <expression>'[Demo] ' &amp; {!actionType}</expression>
    </formulas>
    <interviewLabel>Log Demo Activity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Log Demo Activity</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>CreateAuditTask</name>
        <label>Create Records: Create Audit Task</label>
        <locationX>200</locationX><locationY>200</locationY>
        <assignRecordIdToReference>taskId</assignRecordIdToReference>
        <inputAssignments>
            <field>ActivityDate</field>
            <value><elementReference>activityDate</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value><elementReference>activityDetails</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value><elementReference>taskOwnerId</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value><elementReference>taskStatus</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value><elementReference>taskSubject</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value><elementReference>vehicleId</elementReference></value>
        </inputAssignments>
    </recordCreates>
    <start>
        <locationX>200</locationX><locationY>0</locationY>
        <connector><targetReference>CreateAuditTask</targetReference></connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>actionType</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput>
    </variables>
    <variables>
        <name>activityDetails</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput>
    </variables>
    <variables>
        <name>taskId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput>
    </variables>
    <variables>
        <name>taskOwnerId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput>
    </variables>
    <variables>
        <name>taskStatus</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput>
        <value><stringValue>Not Started</stringValue></value>
    </variables>
    <variables>
        <name>vehicleId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput>
    </variables>
</Flow>
