<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <choices>
        <name>Ch_Concesionario</name>
        <choiceText>En ubicacion de concesionario</choiceText>
        <dataType>String</dataType>
        <value><stringValue>En ubicación de concesionario</stringValue></value>
    </choices>
    <choices>
        <name>Ch_DemoEjec</name>
        <choiceText>Demo</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Demo</stringValue></value>
    </choices>
    <choices>
        <name>Ch_DemoVenta</name>
        <choiceText>Demo venta (la unidad fue demo; sigue siendo Nuevo)</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Demo venta</stringValue></value>
    </choices>
    <choices>
        <name>Ch_Designar</name>
        <choiceText>Ejecutar designacion (Demo/Exhibicion)</choiceText>
        <dataType>String</dataType>
        <value><stringValue>DESIGNAR</stringValue></value>
    </choices>
    <choices>
        <name>Ch_ExhEjec</name>
        <choiceText>Exhibicion</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Exhibicion</stringValue></value>
    </choices>
    <choices>
        <name>Ch_LiberarEjec</name>
        <choiceText>Ejecutar liberacion para venta</choiceText>
        <dataType>String</dataType>
        <value><stringValue>LIBERAR</stringValue></value>
    </choices>
    <decisions>
        <name>D_AccionEjec</name>
        <label>Que ejecuta?</label>
        <locationX>300</locationX>
        <locationY>300</locationY>
        <defaultConnector><targetReference>U_SP_Available</targetReference></defaultConnector>
        <defaultConnectorLabel>Liberacion</defaultConnectorLabel>
        <rules>
            <name>R_Designar</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AccionEjec</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>DESIGNAR</stringValue></rightValue>
            </conditions>
            <connector><targetReference>U_Veh_Designar</targetReference></connector>
            <label>Designacion</label>
        </rules>
    </decisions>
    <decisions>
        <name>D_UnidadOkEjec</name>
        <label>Unidad encontrada?</label>
        <locationX>200</locationX>
        <locationY>200</locationY>
        <defaultConnector><targetReference>S_NoEncontradaEjec</targetReference></defaultConnector>
        <defaultConnectorLabel>No encontrada</defaultConnectorLabel>
        <rules>
            <name>R_UnidadOkEjec</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_UnidadEjec</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_VehiculoEjec</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>D_AccionEjec</targetReference></connector>
            <label>Encontrada</label>
        </rules>
    </decisions>
    <description>HU-046 T08: pantalla del ENCARGADO DE PISO. Lee sus Tasks pendientes HU-046 y ejecuta: designacion (Vehicle.Status = En demostración/En exhibicion + SerializedProduct.Status = Allocated) o liberacion (SerializedProduct = Available, Vehicle = En ubicación de concesionario o Demo venta, ConditionType se MANTIENE Nuevo, abre Opportunity del VIN con RT GQOpportunitiesAutos). Cierra la Task. TODO-DAVI: (1) traslado fisico via accion Vehicle Transfer (T02) queda fuera del flow - CBSF; (2) StageName inicial de la Opportunity segun proceso GRPQM (asumido el primero del RT); (3) API names de picklist usados EXACTOS al describe 05/08: 'En exhibicion' SIN acento, 'En demostración' y 'En ubicación de concesionario' CON acento - si renombran valores, actualizar aqui.</description>
    <dynamicChoiceSets>
        <name>DC_Solicitudes</name>
        <dataType>String</dataType>
        <displayField>Subject</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OwnerId</field>
            <operator>EqualTo</operator>
            <value><elementReference>$User.Id</elementReference></value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value><stringValue>Completed</stringValue></value>
        </filters>
        <filters>
            <field>Subject</field>
            <operator>StartsWith</operator>
            <value><stringValue>HU-046 · Solicitud</stringValue></value>
        </filters>
        <object>Task</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>fx_CierreOpp</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 30</expression>
    </formulas>
    <formulas>
        <name>fx_EstadoDesignacion</name>
        <dataType>String</dataType>
        <expression>IF({!TipoDesignacionEjec} = 'Demo', 'En demostración', 'En exhibicion')</expression>
    </formulas>
    <formulas>
        <name>fx_NombreOpp</name>
        <dataType>String</dataType>
        <expression>'Venta unidad demo ' &amp; {!In_SerialEjec}</expression>
    </formulas>
    <interviewLabel>Ejecutar Solicitud Demo {!$Flow.CurrentDateTime}</interviewLabel>
    <label>HU046 Ejecutar Solicitud Demo</label>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Opp</name>
        <label>Abrir Opportunity del VIN</label>
        <locationX>500</locationX>
        <locationY>600</locationY>
        <connector><targetReference>U_CerrarTask_Lib</targetReference></connector>
        <inputAssignments>
            <field>CloseDate</field>
            <value><elementReference>fx_CierreOpp</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value><elementReference>fx_NombreOpp</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value><elementReference>Get_RT_Opp.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>StageName</field>
            <value><stringValue>Prospecting</stringValue></value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordCreates>
    <recordLookups>
        <name>Get_RT_Opp</name>
        <label>Get RT GQOpportunitiesAutos</label>
        <locationX>500</locationX>
        <locationY>550</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Create_Opp</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value><stringValue>GQOpportunitiesAutos</stringValue></value>
        </filters>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value><stringValue>Opportunity</stringValue></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_UnidadEjec</name>
        <label>Get SerializedProduct por serial</label>
        <locationX>200</locationX>
        <locationY>100</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Get_VehiculoEjec</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SerialNumber</field>
            <operator>EqualTo</operator>
            <value><elementReference>In_SerialEjec</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>SerializedProduct</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_VehiculoEjec</name>
        <label>Get Vehicle</label>
        <locationX>200</locationX>
        <locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>D_UnidadOkEjec</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value><elementReference>In_SerialEjec</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vehicle</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>U_CerrarTask_Desig</name>
        <label>Cerrar Task (designacion)</label>
        <locationX>100</locationX>
        <locationY>600</locationY>
        <connector><targetReference>S_FinEjec</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>SolicitudSeleccionada</elementReference></value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value><stringValue>Completed</stringValue></value>
        </inputAssignments>
        <object>Task</object>
    </recordUpdates>
    <recordUpdates>
        <name>U_CerrarTask_Lib</name>
        <label>Cerrar Task (liberacion)</label>
        <locationX>500</locationX>
        <locationY>700</locationY>
        <connector><targetReference>S_FinEjec</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>SolicitudSeleccionada</elementReference></value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value><stringValue>Completed</stringValue></value>
        </inputAssignments>
        <object>Task</object>
    </recordUpdates>
    <recordUpdates>
        <name>U_SP_Allocated</name>
        <label>SerializedProduct = Allocated</label>
        <locationX>100</locationX>
        <locationY>500</locationY>
        <connector><targetReference>U_CerrarTask_Desig</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>Get_UnidadEjec.Id</elementReference></value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value><stringValue>Allocated</stringValue></value>
        </inputAssignments>
        <object>SerializedProduct</object>
    </recordUpdates>
    <recordUpdates>
        <name>U_SP_Available</name>
        <label>SerializedProduct = Available</label>
        <locationX>500</locationX>
        <locationY>400</locationY>
        <connector><targetReference>U_Veh_Liberar</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>Get_UnidadEjec.Id</elementReference></value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value><stringValue>Available</stringValue></value>
        </inputAssignments>
        <object>SerializedProduct</object>
    </recordUpdates>
    <recordUpdates>
        <name>U_Veh_Designar</name>
        <label>Vehicle al estado de designacion</label>
        <locationX>100</locationX>
        <locationY>400</locationY>
        <connector><targetReference>U_SP_Allocated</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>Get_VehiculoEjec.Id</elementReference></value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value><elementReference>fx_EstadoDesignacion</elementReference></value>
        </inputAssignments>
        <object>Vehicle</object>
    </recordUpdates>
    <recordUpdates>
        <name>U_Veh_Liberar</name>
        <label>Vehicle al estado de liberacion</label>
        <locationX>500</locationX>
        <locationY>500</locationY>
        <connector><targetReference>Get_RT_Opp</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>Get_VehiculoEjec.Id</elementReference></value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value><elementReference>EstadoLiberacion</elementReference></value>
        </inputAssignments>
        <object>Vehicle</object>
    </recordUpdates>
    <screens>
        <name>S_FinEjec</name>
        <label>Ejecucion registrada</label>
        <locationX>300</locationX>
        <locationY>800</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Txt_FinEjec</name>
            <fieldText>&lt;p&gt;Ejecucion completada. La Task quedo cerrada con ejecutor y fecha/hora. Si la unidad requiere traslado fisico, use la accion Vehicle Transfer de la busqueda de inventario (T02).&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>S_NoEncontradaEjec</name>
        <label>Unidad no encontrada</label>
        <locationX>0</locationX>
        <locationY>300</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Txt_NoEncontradaEjec</name>
            <fieldText>&lt;p&gt;No se encontro la unidad con el VIN/serial informado. Vuelva atras y verifique.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>S_SeleccionEjec</name>
        <label>Ejecutar Solicitud Demo</label>
        <locationX>200</locationX>
        <locationY>50</locationY>
        <allowBack>false</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector><targetReference>Get_UnidadEjec</targetReference></connector>
        <fields>
            <name>SolicitudSeleccionada</name>
            <choiceReferences>DC_Solicitudes</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Solicitud pendiente a ejecutar (sus Tasks HU-046)</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>AccionEjec</name>
            <choiceReferences>Ch_Designar</choiceReferences>
            <choiceReferences>Ch_LiberarEjec</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Accion a ejecutar</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>In_SerialEjec</name>
            <dataType>String</dataType>
            <fieldText>VIN / Numero de serie de la unidad</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>TipoDesignacionEjec</name>
            <choiceReferences>Ch_DemoEjec</choiceReferences>
            <choiceReferences>Ch_ExhEjec</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Si es designacion: tipo</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>EstadoLiberacion</name>
            <choiceReferences>Ch_Concesionario</choiceReferences>
            <choiceReferences>Ch_DemoVenta</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Si es liberacion: estado destino del Vehicle (D4)</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>200</locationX>
        <locationY>0</locationY>
        <connector><targetReference>S_SeleccionEjec</targetReference></connector>
    </start>
    <status>Draft</status>
</Flow>
