<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>HU-046 T07: traza padronizada del ciclo demo como Task nativa (WhatId = Vehicle). Entradas: varVehicleId, varTipoAccion (Solicitud designacion | Asignacion | Solicitud liberacion | Liberacion | Cancelacion | Vencimiento), varDetalle, varOwnerId (a quien queda la Task; si es registro historico usar el ejecutor). TODO-DAVI: confirmar el API value del estado de Task en la org (asumido 'Completed').</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_Hoy</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>fx_Subject</name>
        <dataType>String</dataType>
        <expression>'HU-046 · ' &amp; {!varTipoAccion}</expression>
    </formulas>
    <interviewLabel>Registrar Traza Demo {!$Flow.CurrentDateTime}</interviewLabel>
    <label>HU046 Subflow Registrar Traza Demo</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Task</name>
        <label>Crear Task de traza</label>
        <locationX>200</locationX>
        <locationY>200</locationY>
        <assignRecordIdToReference>varTaskId</assignRecordIdToReference>
        <inputAssignments>
            <field>ActivityDate</field>
            <value><elementReference>fx_Hoy</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value><elementReference>varDetalle</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value><elementReference>varOwnerId</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value><elementReference>varEstadoTask</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value><elementReference>fx_Subject</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value><elementReference>varVehicleId</elementReference></value>
        </inputAssignments>
    </recordCreates>
    <start>
        <locationX>200</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Create_Task</targetReference></connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>varDetalle</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varEstadoTask</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value><stringValue>Not Started</stringValue></value>
    </variables>
    <variables>
        <name>varOwnerId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varTaskId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varTipoAccion</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varVehicleId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
