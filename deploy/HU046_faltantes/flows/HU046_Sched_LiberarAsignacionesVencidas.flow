<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>A_AgregarVencida</name>
        <label>Marcar y coleccionar</label>
        <locationX>400</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>Loop_Unidades.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>varOwnerPorDefectoId</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varColVencidas</assignToReference>
            <operator>Add</operator>
            <value><elementReference>Loop_Unidades</elementReference></value>
        </assignmentItems>
        <connector><targetReference>Loop_Unidades</targetReference></connector>
    </assignments>
    <decisions>
        <name>D_HayVencidas</name>
        <label>Hay vencidas?</label>
        <locationX>200</locationX>
        <locationY>500</locationY>
        <defaultConnectorLabel>Nada que liberar</defaultConnectorLabel>
        <rules>
            <name>R_HayVencidas</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varColVencidas</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>U_RevertirOwners</targetReference></connector>
            <label>Hay vencidas</label>
        </rules>
    </decisions>
    <decisions>
        <name>D_Vencida</name>
        <label>Asignacion vencida?</label>
        <locationX>300</locationX>
        <locationY>300</locationY>
        <defaultConnector><targetReference>Loop_Unidades</targetReference></defaultConnector>
        <defaultConnectorLabel>Vigente</defaultConnectorLabel>
        <rules>
            <name>R_Vencida</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fx_Vencida</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>A_AgregarVencida</targetReference></connector>
            <label>Vencida</label>
        </rules>
    </decisions>
    <description>HU-046 T10 (D9a - CERO Apex): libera asignaciones excepcionales vencidas. Regla simplificada: la asignacion vence al mismo horario del siguiente dia habil (WEEKDAY, sin feriados). APROXIMACION v1: la fecha de asignacion se toma de LastModifiedDate del SerializedProduct - TODO-DAVI: si hay ediciones intermedias frecuentes, cambiar la fuente a la Task de traza 'HU-046 - Asignacion'. TODO-DAVI: (1) setear default de varOwnerPorDefectoId (usuario/cola a quien revierte el Owner); (2) OJO: scheduled flows solo corren Once/Daily/Weekly - la tarea decia 'horario': con D9a la corrida diaria es suficiente en la practica; validar con negocio. (3) Agregar filtros org-especificos si aplica.</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_Vencida</name>
        <dataType>Boolean</dataType>
        <expression>NOW() &gt; ({!Loop_Unidades.LastModifiedDate} + CASE(WEEKDAY(DATEVALUE({!Loop_Unidades.LastModifiedDate})), 6, 3, 7, 2, 1))</expression>
    </formulas>
    <interviewLabel>Liberar asignaciones demo vencidas {!$Flow.CurrentDateTime}</interviewLabel>
    <label>HU046 Sched Liberar Asignaciones Demo Vencidas</label>
    <loops>
        <name>Loop_Unidades</name>
        <label>Por cada unidad asignada</label>
        <locationX>200</locationX>
        <locationY>200</locationY>
        <collectionReference>Get_Asignadas</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector><targetReference>D_Vencida</targetReference></nextValueConnector>
        <noMoreValuesConnector><targetReference>D_HayVencidas</targetReference></noMoreValuesConnector>
    </loops>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Asignadas</name>
        <label>Get unidades Allocated</label>
        <locationX>200</locationX>
        <locationY>100</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Loop_Unidades</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value><stringValue>Allocated</stringValue></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>SerializedProduct</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>U_RevertirOwners</name>
        <label>Revertir owners (bulk)</label>
        <locationX>200</locationX>
        <locationY>600</locationY>
        <inputReference>varColVencidas</inputReference>
    </recordUpdates>
    <start>
        <locationX>200</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Get_Asignadas</targetReference></connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-08-10</startDate>
            <startTime>06:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>varColVencidas</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>SerializedProduct</objectType>
    </variables>
    <variables>
        <name>varOwnerPorDefectoId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
