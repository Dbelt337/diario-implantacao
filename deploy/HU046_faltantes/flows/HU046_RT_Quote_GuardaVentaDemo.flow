<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>A_TODO_SetUnidad</name>
        <label>TODO-DAVI: unidad desde el Quote</label>
        <locationX>200</locationX>
        <locationY>200</locationY>
        <assignmentItems>
            <assignToReference>varSerializedProductId</assignToReference>
            <operator>Assign</operator>
            <value><stringValue></stringValue></value>
        </assignmentItems>
        <connector><targetReference>Get_Unidad</targetReference></connector>
        <description>TODO-DAVI: reemplazar el valor vacio por la referencia del campo del Quote ($Record) que vincula la unidad (SerializedProduct/VIN) segun la venta guiada GRPQM. Mientras quede vacio, el flow no bloquea nada.</description>
    </assignments>
    <customErrors>
        <name>Error_Bloqueo</name>
        <label>Bloquear cotizacion de unidad asignada</label>
        <locationX>200</locationX>
        <locationY>500</locationY>
        <customErrorMessages>
            <errorMessage>Esta unidad esta reservada como Demo/Exhibicion y asignada a otro asesor. No puede cotizarse (HU-046). Si necesita venderla, solicite la liberacion a su gerente.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>D_Bloquear</name>
        <label>Unidad Allocated de otro asesor?</label>
        <locationX>200</locationX>
        <locationY>400</locationY>
        <defaultConnectorLabel>Permitir</defaultConnectorLabel>
        <rules>
            <name>R_Bloquear</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Unidad</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Unidad.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>Allocated</stringValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Unidad.OwnerId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue><elementReference>$User.Id</elementReference></rightValue>
            </conditions>
            <connector><targetReference>Error_Bloqueo</targetReference></connector>
            <label>Bloquear</label>
        </rules>
    </decisions>
    <decisions>
        <name>D_Bypass</name>
        <label>Tiene bypass?</label>
        <locationX>200</locationX>
        <locationY>100</locationY>
        <defaultConnector><targetReference>A_TODO_SetUnidad</targetReference></defaultConnector>
        <defaultConnectorLabel>Validar</defaultConnectorLabel>
        <rules>
            <name>R_ConBypass</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.BypassAllocationValidation</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <label>Con bypass (integracion/admin)</label>
        </rules>
    </decisions>
    <description>HU-046 T11: guarda de venta SIN Apex (patron Lead_RecordTriggered_DupGovernance). Before-save al CREAR Quote: si la unidad referenciada esta Allocated y el usuario no es el Owner asignado, Custom Error bloquea (Esc.10 - visible pero no vendible). Protege tambien quotes creadas fuera de la venta guiada. Bypass via custom permission BypassAllocationValidation. TODO-DAVI: wire del campo Quote-unidad en A_TODO_SetUnidad.</description>
    <environments>Default</environments>
    <interviewLabel>Guarda Venta Demo {!$Flow.CurrentDateTime}</interviewLabel>
    <label>HU046 RT Quote Guarda Venta Demo</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Unidad</name>
        <label>Get SerializedProduct</label>
        <locationX>200</locationX>
        <locationY>300</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>D_Bloquear</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>varSerializedProductId</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>SerializedProduct</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>200</locationX>
        <locationY>0</locationY>
        <connector><targetReference>D_Bypass</targetReference></connector>
        <object>Quote</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>varSerializedProductId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
