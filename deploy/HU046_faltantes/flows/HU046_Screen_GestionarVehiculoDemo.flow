<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Notif_Liberacion</name>
        <label>Notificar encargado (liberacion)</label>
        <locationX>800</locationX>
        <locationY>600</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <connector><targetReference>S_Confirmacion</targetReference></connector>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value><elementReference>Get_TipoNotif_Lib.Id</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value><elementReference>varDestinatarios</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value><stringValue>HU-046: Solicitud de liberacion para venta</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value><stringValue>Hay una nueva solicitud de liberacion de unidad Demo/Exhibicion pendiente de ejecucion.</stringValue></value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
    </actionCalls>
    <actionCalls>
        <name>Notif_Solicitud</name>
        <label>Notificar encargado (designacion)</label>
        <locationX>200</locationX>
        <locationY>800</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <connector><targetReference>S_Confirmacion</targetReference></connector>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value><elementReference>Get_TipoNotif.Id</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value><elementReference>varDestinatarios</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value><stringValue>HU-046: Nueva solicitud de designacion Demo/Exhibicion</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value><elementReference>varMensaje</elementReference></value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>A_Contar</name>
        <label>Contar unidades en uso</label>
        <locationX>200</locationX>
        <locationY>500</locationY>
        <assignmentItems>
            <assignToReference>varUnidadesActuales</assignToReference>
            <operator>AssignCount</operator>
            <value><elementReference>Get_UnidadesActuales</elementReference></value>
        </assignmentItems>
        <connector><targetReference>SF_ValidarCupo</targetReference></connector>
    </assignments>
    <assignments>
        <name>A_Dest_Lib</name>
        <label>Destinatario liberacion</label>
        <locationX>800</locationX>
        <locationY>500</locationY>
        <assignmentItems>
            <assignToReference>varDestinatarios</assignToReference>
            <operator>Add</operator>
            <value><elementReference>varEncargadoId</elementReference></value>
        </assignmentItems>
        <connector><targetReference>Get_TipoNotif_Lib</targetReference></connector>
    </assignments>
    <assignments>
        <name>A_Dest_Sol</name>
        <label>Destinatario designacion</label>
        <locationX>200</locationX>
        <locationY>700</locationY>
        <assignmentItems>
            <assignToReference>varDestinatarios</assignToReference>
            <operator>Add</operator>
            <value><elementReference>varEncargadoId</elementReference></value>
        </assignmentItems>
        <connector><targetReference>Get_TipoNotif</targetReference></connector>
    </assignments>
    <choices>
        <name>Ch_Asignar</name>
        <choiceText>Asignar / reasignar a asesor (ventana 8h habiles)</choiceText>
        <dataType>String</dataType>
        <value><stringValue>ASIGNAR</stringValue></value>
    </choices>
    <choices>
        <name>Ch_Cancelar</name>
        <choiceText>Cancelar asignacion excepcional (nada cambia de estado/ubicacion)</choiceText>
        <dataType>String</dataType>
        <value><stringValue>CANCELAR</stringValue></value>
    </choices>
    <choices>
        <name>Ch_Demo</name>
        <choiceText>Demo</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Demo</stringValue></value>
    </choices>
    <choices>
        <name>Ch_Exhibicion</name>
        <choiceText>Exhibicion</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Exhibicion</stringValue></value>
    </choices>
    <choices>
        <name>Ch_Liberar</name>
        <choiceText>Liberar para venta (solicitud al encargado)</choiceText>
        <dataType>String</dataType>
        <value><stringValue>LIBERAR</stringValue></value>
    </choices>
    <choices>
        <name>Ch_Solicitar</name>
        <choiceText>Solicitar designacion Demo / Exhibicion</choiceText>
        <dataType>String</dataType>
        <value><stringValue>SOLICITAR</stringValue></value>
    </choices>
    <decisions>
        <name>D_Accion</name>
        <label>Que accion?</label>
        <locationX>400</locationX>
        <locationY>300</locationY>
        <defaultConnector><targetReference>S_Cancelar</targetReference></defaultConnector>
        <defaultConnectorLabel>Cancelar</defaultConnectorLabel>
        <rules>
            <name>R_Solicitar</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Accion</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>SOLICITAR</stringValue></rightValue>
            </conditions>
            <connector><targetReference>S_Solicitud</targetReference></connector>
            <label>Solicitar</label>
        </rules>
        <rules>
            <name>R_Asignar</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Accion</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>ASIGNAR</stringValue></rightValue>
            </conditions>
            <connector><targetReference>S_Asignar</targetReference></connector>
            <label>Asignar</label>
        </rules>
        <rules>
            <name>R_Liberar</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Accion</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>LIBERAR</stringValue></rightValue>
            </conditions>
            <connector><targetReference>SF_Traza_Liberacion</targetReference></connector>
            <label>Liberar</label>
        </rules>
    </decisions>
    <decisions>
        <name>D_Cupo</name>
        <label>Cupo disponible?</label>
        <locationX>200</locationX>
        <locationY>600</locationY>
        <defaultConnector><targetReference>S_CupoLleno</targetReference></defaultConnector>
        <defaultConnectorLabel>Cupo lleno</defaultConnectorLabel>
        <rules>
            <name>R_CupoOk</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCupoDisponible</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>SF_Traza_Solicitud</targetReference></connector>
            <label>Disponible</label>
        </rules>
    </decisions>
    <decisions>
        <name>D_UnidadOk</name>
        <label>Unidad encontrada?</label>
        <locationX>200</locationX>
        <locationY>200</locationY>
        <defaultConnector><targetReference>S_NoEncontrada</targetReference></defaultConnector>
        <defaultConnectorLabel>No encontrada</defaultConnectorLabel>
        <rules>
            <name>R_UnidadOk</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Unidad</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Vehiculo</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>D_Accion</targetReference></connector>
            <label>Encontrada</label>
        </rules>
    </decisions>
    <description>HU-046 T06: pantalla unica de GERENCIA con 4 ramas (solicitar designacion / asignar-reasignar / liberar / cancelar). Entrada controlada por custom permission RequestDemoVehicle (configurar visibilidad del boton/accion). v1 con TODO-DAVI: (1) seleccion de unidad por VIN digitado - evolucionar a busqueda CBSF (T01); (2) marca/sucursal digitadas - derivarlas del Vehicle; (3) Get_UnidadesActuales filtra solo por Status - agregar filtros de marca y sucursal del Vehicle; (4) default de varEncargadoId (encargado de piso por sucursal, grupos GRP_Sucursal_*); (5) In_AsesorId / In_OwnerAnteriorId como texto - reemplazar por lookup.</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_EstadoObjetivo</name>
        <dataType>String</dataType>
        <expression>IF({!TipoDesignacion} = 'Demo', 'En demostración', 'En exhibicion')</expression>
    </formulas>
    <interviewLabel>Gestionar Vehiculo Demo {!$Flow.CurrentDateTime}</interviewLabel>
    <label>HU046 Gestionar Vehiculo Demo</label>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_TipoNotif</name>
        <label>Get tipo de notificacion</label>
        <locationX>200</locationX>
        <locationY>750</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Notif_Solicitud</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value><stringValue>DemoDesignationAlert</stringValue></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_TipoNotif_Lib</name>
        <label>Get tipo de notificacion (lib)</label>
        <locationX>800</locationX>
        <locationY>550</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Notif_Liberacion</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value><stringValue>DemoDesignationAlert</stringValue></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Unidad</name>
        <label>Get SerializedProduct por serial</label>
        <locationX>200</locationX>
        <locationY>100</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Get_Vehiculo</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SerialNumber</field>
            <operator>EqualTo</operator>
            <value><elementReference>In_Serial</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>SerializedProduct</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_UnidadesActuales</name>
        <label>Get unidades en el estado objetivo</label>
        <locationX>200</locationX>
        <locationY>450</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>A_Contar</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value><elementReference>fx_EstadoObjetivo</elementReference></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Vehicle</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Vehiculo</name>
        <label>Get Vehicle</label>
        <locationX>200</locationX>
        <locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>D_UnidadOk</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value><elementReference>In_Serial</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vehicle</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>U_Asignar</name>
        <label>Asignar owner al asesor</label>
        <locationX>600</locationX>
        <locationY>400</locationY>
        <connector><targetReference>SF_Traza_Asignacion</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>Get_Unidad.Id</elementReference></value>
        </filters>
        <inputAssignments>
            <field>OwnerId</field>
            <value><elementReference>In_AsesorId</elementReference></value>
        </inputAssignments>
        <object>SerializedProduct</object>
    </recordUpdates>
    <recordUpdates>
        <name>U_Cancelar</name>
        <label>Revertir owner</label>
        <locationX>1000</locationX>
        <locationY>400</locationY>
        <connector><targetReference>SF_Traza_Cancelacion</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>Get_Unidad.Id</elementReference></value>
        </filters>
        <inputAssignments>
            <field>OwnerId</field>
            <value><elementReference>In_OwnerAnteriorId</elementReference></value>
        </inputAssignments>
        <object>SerializedProduct</object>
    </recordUpdates>
    <screens>
        <name>S_Asignar</name>
        <label>Asignar a asesor</label>
        <locationX>600</locationX>
        <locationY>350</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector><targetReference>U_Asignar</targetReference></connector>
        <fields>
            <name>In_AsesorId</name>
            <dataType>String</dataType>
            <fieldText>Id del asesor (TODO-DAVI: reemplazar por lookup de User)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>S_Cancelar</name>
        <label>Cancelar asignacion excepcional</label>
        <locationX>1000</locationX>
        <locationY>350</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector><targetReference>U_Cancelar</targetReference></connector>
        <fields>
            <name>In_OwnerAnteriorId</name>
            <dataType>String</dataType>
            <fieldText>Id del owner a restaurar (TODO-DAVI: derivar de la traza)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>S_Confirmacion</name>
        <label>Confirmacion</label>
        <locationX>500</locationX>
        <locationY>900</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Txt_Confirmacion</name>
            <fieldText>&lt;p&gt;Accion registrada correctamente. La traza quedo en la Task vinculada al Vehicle.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>S_CupoLleno</name>
        <label>Cupo lleno</label>
        <locationX>400</locationX>
        <locationY>700</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Txt_CupoLleno</name>
            <fieldText>&lt;p&gt;{!varMensaje}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>S_Menu</name>
        <label>Gestionar Vehiculo Demo</label>
        <locationX>200</locationX>
        <locationY>50</locationY>
        <allowBack>false</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector><targetReference>Get_Unidad</targetReference></connector>
        <fields>
            <name>Accion</name>
            <choiceReferences>Ch_Solicitar</choiceReferences>
            <choiceReferences>Ch_Asignar</choiceReferences>
            <choiceReferences>Ch_Liberar</choiceReferences>
            <choiceReferences>Ch_Cancelar</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Que desea hacer?</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>In_Serial</name>
            <dataType>String</dataType>
            <fieldText>VIN / Numero de serie de la unidad (TODO-DAVI: evolucionar a busqueda CBSF T01)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>S_NoEncontrada</name>
        <label>Unidad no encontrada</label>
        <locationX>0</locationX>
        <locationY>300</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Txt_NoEncontrada</name>
            <fieldText>&lt;p&gt;No se encontro la unidad con el VIN/serial informado. Verifique el dato e intente de nuevo (boton Anterior).&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>S_Solicitud</name>
        <label>Solicitar designacion</label>
        <locationX>200</locationX>
        <locationY>400</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector><targetReference>Get_UnidadesActuales</targetReference></connector>
        <fields>
            <name>TipoDesignacion</name>
            <choiceReferences>Ch_Demo</choiceReferences>
            <choiceReferences>Ch_Exhibicion</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Tipo de designacion</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>In_Marca</name>
            <dataType>String</dataType>
            <fieldText>Marca (TODO-DAVI: derivar del Vehicle)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>In_Sucursal</name>
            <dataType>String</dataType>
            <fieldText>Sucursal (TODO-DAVI: derivar del Vehicle; usar el nombre del excel de cupos)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>200</locationX>
        <locationY>0</locationY>
        <connector><targetReference>S_Menu</targetReference></connector>
    </start>
    <status>Draft</status>
    <subflows>
        <name>SF_Traza_Asignacion</name>
        <label>Traza: asignacion</label>
        <locationX>600</locationX>
        <locationY>500</locationY>
        <connector><targetReference>S_Confirmacion</targetReference></connector>
        <flowName>HU046_Subflow_RegistrarTrazaDemo</flowName>
        <inputAssignments>
            <name>varDetalle</name>
            <value><stringValue>Asignacion excepcional de unidad demo a asesor (ventana 8h habiles).</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>varEstadoTask</name>
            <value><stringValue>Completed</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>varOwnerId</name>
            <value><elementReference>$User.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <name>varTipoAccion</name>
            <value><stringValue>Asignacion</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>varVehicleId</name>
            <value><elementReference>Get_Vehiculo.Id</elementReference></value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>SF_Traza_Cancelacion</name>
        <label>Traza: cancelacion</label>
        <locationX>1000</locationX>
        <locationY>500</locationY>
        <connector><targetReference>S_Confirmacion</targetReference></connector>
        <flowName>HU046_Subflow_RegistrarTrazaDemo</flowName>
        <inputAssignments>
            <name>varDetalle</name>
            <value><stringValue>Cancelacion de la asignacion excepcional. Estado y ubicacion sin cambios (Esc.11).</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>varEstadoTask</name>
            <value><stringValue>Completed</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>varOwnerId</name>
            <value><elementReference>$User.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <name>varTipoAccion</name>
            <value><stringValue>Cancelacion</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>varVehicleId</name>
            <value><elementReference>Get_Vehiculo.Id</elementReference></value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>SF_Traza_Liberacion</name>
        <label>Traza: solicitud de liberacion</label>
        <locationX>800</locationX>
        <locationY>400</locationY>
        <connector><targetReference>A_Dest_Lib</targetReference></connector>
        <flowName>HU046_Subflow_RegistrarTrazaDemo</flowName>
        <inputAssignments>
            <name>varDetalle</name>
            <value><stringValue>Solicitud de liberacion para venta. Pendiente de ejecucion por el encargado de piso (Esc.7).</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>varEstadoTask</name>
            <value><stringValue>Not Started</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>varOwnerId</name>
            <value><elementReference>varEncargadoId</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <name>varTipoAccion</name>
            <value><stringValue>Solicitud liberacion</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>varVehicleId</name>
            <value><elementReference>Get_Vehiculo.Id</elementReference></value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>SF_Traza_Solicitud</name>
        <label>Traza: solicitud designacion</label>
        <locationX>200</locationX>
        <locationY>650</locationY>
        <connector><targetReference>A_Dest_Sol</targetReference></connector>
        <flowName>HU046_Subflow_RegistrarTrazaDemo</flowName>
        <inputAssignments>
            <name>varDetalle</name>
            <value><elementReference>varMensaje</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <name>varEstadoTask</name>
            <value><stringValue>Not Started</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>varOwnerId</name>
            <value><elementReference>varEncargadoId</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <name>varTipoAccion</name>
            <value><stringValue>Solicitud designacion</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <name>varVehicleId</name>
            <value><elementReference>Get_Vehiculo.Id</elementReference></value>
        </inputAssignments>
