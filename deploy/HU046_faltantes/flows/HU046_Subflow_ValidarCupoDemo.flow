<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>A_Cupo_Demo</name>
        <label>Cupo objetivo = MaxDemo</label>
        <locationX>200</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>varCupoMaximo</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Get_Cupo.MaxDemo__c</elementReference></value>
        </assignmentItems>
        <connector><targetReference>D_Comparar</targetReference></connector>
    </assignments>
    <assignments>
        <name>A_Cupo_Exh</name>
        <label>Cupo objetivo = MaxExhibition</label>
        <locationX>400</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>varCupoMaximo</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Get_Cupo.MaxExhibition__c</elementReference></value>
        </assignmentItems>
        <connector><targetReference>D_Comparar</targetReference></connector>
    </assignments>
    <assignments>
        <name>A_CupoLleno</name>
        <label>Cupo lleno</label>
        <locationX>400</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>varCupoDisponible</assignToReference>
            <operator>Assign</operator>
            <value><booleanValue>false</booleanValue></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varMensaje</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>fx_MensajeLleno</elementReference></value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>A_Disponible</name>
        <label>Cupo disponible</label>
        <locationX>200</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>varCupoDisponible</assignToReference>
            <operator>Assign</operator>
            <value><booleanValue>true</booleanValue></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varMensaje</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>fx_MensajeOK</elementReference></value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>A_SinConfig</name>
        <label>Sin parametrizacion</label>
        <locationX>600</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>varCupoDisponible</assignToReference>
            <operator>Assign</operator>
            <value><booleanValue>false</booleanValue></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varMensaje</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>No existe parametrizacion de cupo para la marca/sucursal indicada (DemoCapacityConfig). Contacte al administrador.</stringValue></value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>D_Comparar</name>
        <label>Hay cupo?</label>
        <locationX>300</locationX>
        <locationY>500</locationY>
        <defaultConnector><targetReference>A_CupoLleno</targetReference></defaultConnector>
        <defaultConnectorLabel>Cupo lleno</defaultConnectorLabel>
        <rules>
            <name>R_HayCupo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varUnidadesActuales</leftValueReference>
                <operator>LessThan</operator>
                <rightValue><elementReference>varCupoMaximo</elementReference></rightValue>
            </conditions>
            <connector><targetReference>A_Disponible</targetReference></connector>
            <label>Hay cupo</label>
        </rules>
    </decisions>
    <decisions>
        <name>D_ConfigEncontrada</name>
        <label>Existe parametrizacion?</label>
        <locationX>300</locationX>
        <locationY>200</locationY>
        <defaultConnector><targetReference>A_SinConfig</targetReference></defaultConnector>
        <defaultConnectorLabel>No encontrada</defaultConnectorLabel>
        <rules>
            <name>R_Encontrada</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Cupo</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>D_Tipo</targetReference></connector>
            <label>Encontrada</label>
        </rules>
    </decisions>
    <decisions>
        <name>D_Tipo</name>
        <label>Tipo de designacion</label>
        <locationX>300</locationX>
        <locationY>300</locationY>
        <defaultConnector><targetReference>A_Cupo_Exh</targetReference></defaultConnector>
        <defaultConnectorLabel>Exhibicion</defaultConnectorLabel>
        <rules>
            <name>R_EsDemo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTipo</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>Demo</stringValue></rightValue>
            </conditions>
            <connector><targetReference>A_Cupo_Demo</targetReference></connector>
            <label>Demo</label>
        </rules>
    </decisions>
    <description>HU-046 T07: valida el cupo Demo/Exhibicion por marca+sucursal contra DemoCapacityConfig__mdt. Entradas: varMarca, varSucursal, varTipo (Demo|Exhibicion), varUnidadesActuales (el CALLER cuenta las unidades actuales con sus filtros org-especificos). Salidas: varCupoDisponible, varCupoMaximo, varMensaje. Reusado por las pantallas de gerencia y encargado.</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_MensajeLleno</name>
        <dataType>String</dataType>
        <expression>'Cupo lleno: ' &amp; TEXT({!varUnidadesActuales}) &amp; ' unidades en uso de un maximo de ' &amp; TEXT({!varCupoMaximo}) &amp; ' para ' &amp; {!varMarca} &amp; ' / ' &amp; {!varSucursal} &amp; ' (' &amp; {!varTipo} &amp; ').'</expression>
    </formulas>
    <formulas>
        <name>fx_MensajeOK</name>
        <dataType>String</dataType>
        <expression>'Cupo disponible: ' &amp; TEXT({!varUnidadesActuales}) &amp; ' de ' &amp; TEXT({!varCupoMaximo}) &amp; ' en uso para ' &amp; {!varMarca} &amp; ' / ' &amp; {!varSucursal} &amp; ' (' &amp; {!varTipo} &amp; ').'</expression>
    </formulas>
    <interviewLabel>Validar Cupo Demo {!$Flow.CurrentDateTime}</interviewLabel>
    <label>HU046 Subflow Validar Cupo Demo</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Cupo</name>
        <label>Get cupo parametrizado</label>
        <locationX>300</locationX>
        <locationY>100</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>D_ConfigEncontrada</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Brand__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>varMarca</elementReference></value>
        </filters>
        <filters>
            <field>BranchName__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>varSucursal</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>DemoCapacityConfig__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>300</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Get_Cupo</targetReference></connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>varCupoDisponible</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varCupoMaximo</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>varMarca</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varMensaje</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varSucursal</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varTipo</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varUnidadesActuales</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
</Flow>
