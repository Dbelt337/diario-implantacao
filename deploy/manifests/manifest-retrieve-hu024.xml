<?xml version="1.0" encoding="UTF-8"?>
<!--
    Retrieve para a HU-024, cierre de oportunidad com registro de motivo.

    Serve para ver o que Apex nao consegue ler: Sales Process por Record Type,
    atribuicao de valores de picklist por Record Type, validation rules de
    etapa, e os flows que mexem em StageName.

    Retrieve do objeto Opportunity inteiro traz, dentro do proprio .object,
    os businessProcesses, os recordTypes, os validationRules e os campos com
    seus valorSet. Se por alguma razao o businessProcesses nao vier, o tipo
    BusinessProcess esta declarado abaixo de forma explicita para garantir.

    Como usar: rodar "sf project retrieve start" apontando a flag de manifest
    para este arquivo e a flag de target org para QA.

    Rodar tambem apontando para UAT e comparar os dois, porque as duas orgs ja
    mostraram configuracao diferente de picklist em Lead e podem divergir aqui
    tambem.
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">

    <types>
        <members>Opportunity</members>
        <members>Quote</members>
        <members>InactivityPolicy__mdt</members>
        <name>CustomObject</name>
    </types>

    <types>
        <members>Opportunity.*</members>
        <name>BusinessProcess</name>
    </types>

    <types>
        <members>Opportunity.*</members>
        <name>RecordType</name>
    </types>

    <types>
        <members>Opportunity.*</members>
        <name>ValidationRule</name>
    </types>

    <types>
        <members>CloseInactiveOpportunities</members>
        <name>Flow</name>
    </types>

    <version>62.0</version>
</Package>
