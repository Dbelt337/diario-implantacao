<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Deve_Rotear</name>
        <label>Debe Rutear (owner es Fila)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Ya tiene dueño (usuario) - no rutear</defaultConnectorLabel>
        <rules>
            <name>Owner_Es_Fila</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fOwnerEsFila</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Queue_Target</targetReference>
            </connector>
            <label>Owner es Fila</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Config</name>
        <label>Check Config</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Log_Falha_Config</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sem Config</defaultConnectorLabel>
        <rules>
            <name>Tem_Config</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Queue_Target.QueueRoutingConfigId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invocar_OmniRouting</targetReference>
            </connector>
            <label>Tem Config</label>
        </rules>
    </decisions>
    <description>Dispara el roteamento Omni-Channel del Lead (subflow LeadRouting_OmniFlow). TRAVA: solo rutea cuando el dueño del Lead es una FILA (OwnerId empieza con 00G). Asi, un Lead ya atribuido a un vendedor (005) editado NO vuelve a la fila (elimina el re-roteamento en update). Leads de UI que quedan con su creador (dueño usuario) se mantienen. Depende de que las Assignment Rules pongan el Lead en la fila en el create (API via assignmentRulesUsed=true; UI segun el flag de la regla).</description>
    <environments>Default</environments>
    <formulas>
        <name>fOwnerEsFila</name>
        <dataType>Boolean</dataType>
        <expression>BEGINS({!$Record.OwnerId}, &quot;00G&quot;)</expression>
    </formulas>
    <formulas>
        <name>TargetQueueDeveloperName</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!$Record.Industry}) = &quot;Repuestos&quot;, &quot;Leads_Repuestos&quot;, IF(TEXT({!$Record.Industry}) = &quot;PA&quot;, &quot;Leads_Productos_Automotrices&quot;, IF(TEXT({!$Record.CompanyCode__c}) = &quot;N101&quot;, &quot;Leads_N101_Motos&quot;, IF(TEXT({!$Record.CompanyCode__c}) = &quot;N105&quot;, &quot;Leads_N105_Motos&quot;, &quot;Queue_Vendedores_CR&quot;))))</expression>
    </formulas>
    <interviewLabel>Lead_TriggerOmniRouting {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead_TriggerOmniRouting</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Log_Falha_Config</name>
        <label>Log Falha Config</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>La cola de destino no tiene Routing Configuration (QueueRoutingConfigId vacío). Lead no roteado.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Lead no roteado: cola sin Routing Configuration</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>Log_Falha_Roteamento</name>
        <label>Log Falha Roteamento</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Falha no roteamento Omni-Channel do Lead</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Queue_Target</name>
        <label>Get Queue Target</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Config</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha_Roteamento</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>TargetQueueDeveloperName</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>2 AND (((1 AND (3 OR 4)) OR 5 OR 6) OR 7 OR 8)</filterLogic>
        <filters>
            <field>Brand__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>CompanyCode__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>C101</stringValue>
            </value>
        </filters>
        <filters>
            <field>CompanyCode__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>C105</stringValue>
            </value>
        </filters>
        <filters>
            <field>CompanyCode__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>N101</stringValue>
            </value>
        </filters>
        <filters>
            <field>CompanyCode__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>N105</stringValue>
            </value>
        </filters>
        <filters>
            <field>Industry</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Repuestos</stringValue>
            </value>
        </filters>
        <filters>
            <field>Industry</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PA</stringValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Deve_Rotear</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Invocar_OmniRouting</name>
        <label>Invocar OmniRouting</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>LeadRouting_OmniFlow</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>routingConfigId</name>
            <value>
                <elementReference>Get_Queue_Target.QueueRoutingConfigId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>TargetQueueId</name>
            <value>
                <elementReference>Get_Queue_Target.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <triggerOrder>30</triggerOrder>
</Flow>
