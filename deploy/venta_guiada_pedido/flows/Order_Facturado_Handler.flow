<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>NotifyOwnerFacturado</name>
        <label>Action: Notificar pedido facturado</label>
        <locationX>0</locationX><locationY>500</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <connector><targetReference>CreateDeliveryTask</targetReference></connector>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value><elementReference>GetNotificationType.Id</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value><elementReference>recipientIds</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value><stringValue>Pedido facturado en SAP</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value><elementReference>notifBody</elementReference></value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>AddOwnerRecipient</name>
        <label>Assignment: Destinatario = dueño del pedido</label>
        <locationX>0</locationX><locationY>400</locationY>
        <assignmentItems>
            <assignToReference>recipientIds</assignToReference>
            <operator>Add</operator>
            <value><elementReference>$Record.OwnerId</elementReference></value>
        </assignmentItems>
        <connector><targetReference>NotifyOwnerFacturado</targetReference></connector>
    </assignments>
    <decisions>
        <name>HasNotificationType</name>
        <label>Decision: ¿Existe el tipo de notificación?</label>
        <locationX>200</locationX><locationY>300</locationY>
        <defaultConnector><targetReference>CreateDeliveryTask</targetReference></defaultConnector>
        <defaultConnectorLabel>Sin tipo — solo tarea</defaultConnectorLabel>
        <rules>
            <name>TypeFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetNotificationType</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>AddOwnerRecipient</targetReference></connector>
            <label>Tipo encontrado</label>
        </rules>
    </decisions>
    <description>Arranque del flujo de entrega: cuando MuleSoft marca el pedido como Facturado (update inbound con número y fecha de factura), notifica al dueño y crea la tarea de entrega. La assetización (cierre del asset anterior + asset del comprador) se conecta aquí cuando la frente de posventa la defina.</description>
    <environments>Default</environments>
    <formulas>
        <name>notifBody</name>
        <dataType>String</dataType>
        <expression>'El pedido ' &amp; {!$Record.OrderNumber} &amp; ' fue facturado en SAP (factura ' &amp; {!$Record.SapInvoiceNumber__c} &amp; '). Inicia el proceso de entrega.'</expression>
    </formulas>
    <formulas>
        <name>taskSubject</name>
        <dataType>String</dataType>
        <expression>'[Entrega] Pedido facturado — ' &amp; {!$Record.OrderNumber}</expression>
    </formulas>
    <interviewLabel>Order Facturado Handler {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Order Facturado Handler</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>CreateDeliveryTask</name>
        <label>Create Records: Tarea de entrega</label>
        <locationX>200</locationX><locationY>600</locationY>
        <inputAssignments>
            <field>Subject</field>
            <value><elementReference>taskSubject</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value><elementReference>notifBody</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value><elementReference>$Record.OwnerId</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value><stringValue>Not Started</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value><elementReference>$Flow.CurrentDate</elementReference></value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>GetNotificationType</name>
        <label>Get Records: Tipo de notificación</label>
        <locationX>200</locationX><locationY>200</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>HasNotificationType</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value><stringValue>SapOrderAlert</stringValue></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>200</locationX><locationY>50</locationY>
        <connector><targetReference>GetNotificationType</targetReference></connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SapStatus__c</field>
            <operator>EqualTo</operator>
            <value><stringValue>Facturado</stringValue></value>
        </filters>
        <object>Order</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>recipientIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
