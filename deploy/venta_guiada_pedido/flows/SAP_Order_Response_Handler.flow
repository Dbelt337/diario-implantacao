<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <decisions>
        <name>QueLlego</name>
        <label>Decision: Qué llegó del SAP</label>
        <locationX>200</locationX><locationY>200</locationY>
        <defaultConnector><targetReference>UpdateOrderStatusOnly</targetReference></defaultConnector>
        <defaultConnectorLabel>Solo estado (sin número SAP)</defaultConnectorLabel>
        <rules>
            <name>EsError</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>Error SAP</stringValue></rightValue>
            </conditions>
            <connector><targetReference>UpdateOrderError</targetReference></connector>
            <label>Error SAP</label>
        </rules>
        <rules>
            <name>ConNumeroSap</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SapOrderNumber__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>UpdateOrderConfirmed</targetReference></connector>
            <label>Con número SAP</label>
        </rules>
    </decisions>
    <description>Escribe en el pedido el resultado asíncrono del SAP publicado en SapOrderResponse__e (por Apex en el ack o por MuleSoft en la confirmación IDoc). La factura NO llega por este evento: entra por update inbound del pedido (Order_Facturado_Handler).</description>
    <environments>Default</environments>
    <interviewLabel>SAP Order Response Handler {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SAP Order Response Handler</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>UpdateOrderConfirmed</name>
        <label>Update Records: Pedido confirmado con número SAP</label>
        <locationX>0</locationX><locationY>350</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.OrderId__c</elementReference></value>
        </filters>
        <inputAssignments>
            <field>SapStatus__c</field>
            <value><elementReference>$Record.Status__c</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>SapOrderNumber__c</field>
            <value><elementReference>$Record.SapOrderNumber__c</elementReference></value>
        </inputAssignments>
        <object>Order</object>
    </recordUpdates>
    <recordUpdates>
        <name>UpdateOrderStatusOnly</name>
        <label>Update Records: Solo estado</label>
        <locationX>200</locationX><locationY>350</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.OrderId__c</elementReference></value>
        </filters>
        <inputAssignments>
            <field>SapStatus__c</field>
            <value><elementReference>$Record.Status__c</elementReference></value>
        </inputAssignments>
        <object>Order</object>
    </recordUpdates>
    <recordUpdates>
        <name>UpdateOrderError</name>
        <label>Update Records: Pedido con error SAP</label>
        <locationX>400</locationX><locationY>350</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.OrderId__c</elementReference></value>
        </filters>
        <inputAssignments>
            <field>SapStatus__c</field>
            <value><stringValue>Error SAP</stringValue></value>
        </inputAssignments>
        <object>Order</object>
    </recordUpdates>
    <start>
        <locationX>200</locationX><locationY>50</locationY>
        <connector><targetReference>QueLlego</targetReference></connector>
        <object>SapOrderResponse__e</object>
        <triggerType>PlatformEvent</triggerType>
    </start>
    <status>Draft</status>
</Flow>
