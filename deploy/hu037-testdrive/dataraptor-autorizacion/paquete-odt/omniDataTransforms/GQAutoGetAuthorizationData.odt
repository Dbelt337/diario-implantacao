<?xml version="1.0" encoding="UTF-8"?>
<OmniDataTransform xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <assignmentRulesUsed>false</assignmentRulesUsed>
    <deletedOnSuccess>false</deletedOnSuccess>
    <description>All countries. Extracts the test drive authorization tokens (HU-037 RN 9.2) from a single ServiceAppointment: schedule, branch, customer, and the display stamps (vehicle, advisor, driver license) written at booking time. Single-step by design: the booking stamps AdvisorName__c / VehicleDescription__c / DriverLicenseNumber__c on the SA, so no multi-hop extraction is needed. Consumed by the authorization renderer and the reprint flow.</description>
    <expectedInputJson>{&quot;ContextId&quot;:&quot;&quot;}</expectedInputJson>
    <fieldLevelSecurityEnabled>false</fieldLevelSecurityEnabled>
    <inputType>JSON</inputType>
    <name>GQAutoGetAuthorizationData</name>
    <nullInputsIncludedInOutput>false</nullInputsIncludedInOutput>
    <outputType>JSON</outputType>
    <sourceObject>ServiceAppointment</sourceObject>
    <type>Extract</type>
    <omniDataTransformItems>
        <name>FilterSAById</name>
        <disabled>false</disabled>
        <filterDataType>TEXT</filterDataType>
        <filterGroup>1</filterGroup>
        <filterOperator>=</filterOperator>
        <filterValue>ContextId</filterValue>
        <globalKey>GQAutoAuthData0001</globalKey>
        <inputFieldName>Id</inputFieldName>
        <inputObjectName>ServiceAppointment</inputObjectName>
        <inputObjectQuerySequence>1</inputObjectQuerySequence>
    </omniDataTransformItems>
    <omniDataTransformItems>
        <name>MapNumeroCita</name>
        <disabled>false</disabled>
        <globalKey>GQAutoAuthData0002</globalKey>
        <inputFieldName>AppointmentNumber</inputFieldName>
        <inputObjectName>ServiceAppointment</inputObjectName>
        <inputObjectQuerySequence>1</inputObjectQuerySequence>
        <outputFieldName>NumeroCita</outputFieldName>
    </omniDataTransformItems>
    <omniDataTransformItems>
        <name>MapFechaHoraInicio</name>
        <disabled>false</disabled>
        <globalKey>GQAutoAuthData0003</globalKey>
        <inputFieldName>SchedStartTime</inputFieldName>
        <inputObjectName>ServiceAppointment</inputObjectName>
        <inputObjectQuerySequence>1</inputObjectQuerySequence>
        <outputFieldName>FechaHoraInicio</outputFieldName>
    </omniDataTransformItems>
    <omniDataTransformItems>
        <name>MapFechaHoraFin</name>
        <disabled>false</disabled>
        <globalKey>GQAutoAuthData0004</globalKey>
        <inputFieldName>SchedEndTime</inputFieldName>
        <inputObjectName>ServiceAppointment</inputObjectName>
        <inputObjectQuerySequence>1</inputObjectQuerySequence>
        <outputFieldName>FechaHoraFin</outputFieldName>
    </omniDataTransformItems>
    <omniDataTransformItems>
        <name>MapSucursal</name>
        <disabled>false</disabled>
        <globalKey>GQAutoAuthData0005</globalKey>
        <inputFieldName>ServiceTerritory.Name</inputFieldName>
        <inputObjectName>ServiceAppointment</inputObjectName>
        <inputObjectQuerySequence>1</inputObjectQuerySequence>
        <outputFieldName>Sucursal</outputFieldName>
    </omniDataTransformItems>
    <omniDataTransformItems>
        <name>MapCliente</name>
        <disabled>false</disabled>
        <globalKey>GQAutoAuthData0006</globalKey>
        <inputFieldName>Account.Name</inputFieldName>
        <inputObjectName>ServiceAppointment</inputObjectName>
        <inputObjectQuerySequence>1</inputObjectQuerySequence>
        <outputFieldName>Cliente</outputFieldName>
    </omniDataTransformItems>
    <omniDataTransformItems>
        <name>MapLicenciaNumero</name>
        <disabled>false</disabled>
        <globalKey>GQAutoAuthData0007</globalKey>
        <inputFieldName>DriverLicenseNumber__c</inputFieldName>
        <inputObjectName>ServiceAppointment</inputObjectName>
        <inputObjectQuerySequence>1</inputObjectQuerySequence>
        <outputFieldName>LicenciaNumero</outputFieldName>
    </omniDataTransformItems>
    <omniDataTransformItems>
        <name>MapVehiculo</name>
        <disabled>false</disabled>
        <globalKey>GQAutoAuthData0008</globalKey>
        <inputFieldName>VehicleDescription__c</inputFieldName>
        <inputObjectName>ServiceAppointment</inputObjectName>
        <inputObjectQuerySequence>1</inputObjectQuerySequence>
        <outputFieldName>Vehiculo</outputFieldName>
    </omniDataTransformItems>
    <omniDataTransformItems>
        <name>MapAsesor</name>
        <disabled>false</disabled>
        <globalKey>GQAutoAuthData0009</globalKey>
        <inputFieldName>AdvisorName__c</inputFieldName>
        <inputObjectName>ServiceAppointment</inputObjectName>
        <inputObjectQuerySequence>1</inputObjectQuerySequence>
        <outputFieldName>Asesor</outputFieldName>
    </omniDataTransformItems>
    <omniDataTransformItems>
        <name>MapDireccionCalle</name>
        <disabled>false</disabled>
        <globalKey>GQAutoAuthData0010</globalKey>
        <inputFieldName>Street</inputFieldName>
        <inputObjectName>ServiceAppointment</inputObjectName>
        <inputObjectQuerySequence>1</inputObjectQuerySequence>
        <outputFieldName>DireccionCalle</outputFieldName>
    </omniDataTransformItems>
    <omniDataTransformItems>
        <name>MapDireccionCiudad</name>
        <disabled>false</disabled>
        <globalKey>GQAutoAuthData0011</globalKey>
        <inputFieldName>City</inputFieldName>
        <inputObjectName>ServiceAppointment</inputObjectName>
        <inputObjectQuerySequence>1</inputObjectQuerySequence>
        <outputFieldName>DireccionCiudad</outputFieldName>
    </omniDataTransformItems>
</OmniDataTransform>
