<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>OwnerName__c</fullName>
        <description>All countries. Owner name of the service appointment, flattened into a field on the record. List components bind by flat field name and cannot resolve a lookup path such as Owner.Name, so the value has to exist on the record itself. Used by the TestDriveSchedule FlexCard as the person responsible for the reservation, which is the Owner and not the Created By, since Created By carries the Named Credential integration user. Blank when the owner is a queue.</description>
        <externalId>false</externalId>
        <formula>Owner:User.FirstName &amp; &quot; &quot; &amp; Owner:User.LastName</formula>
        <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
        <inlineHelpText>Person responsible for the reservation.</inlineHelpText>
        <label>Owner Name</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
</CustomObject>
