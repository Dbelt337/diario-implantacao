<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>ChannelCode__c</fullName>
        <label>Canal Originador (Código de Canal)</label>
        <type>Picklist</type>
        <description>HU-009 (all countries): channel that originated the opportunity. Filled natively by Lead Conversion Mapping from Lead.ChannelCode__c - never by flow or user. Restricted to the same ChannelCode global value set as the Lead field, so conversion never carries an orphan value.</description>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>ChannelCode</valueSetName>
        </valueSet>
    </fields>
</CustomObject>
