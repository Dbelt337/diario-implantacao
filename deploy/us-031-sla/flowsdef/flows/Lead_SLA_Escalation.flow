<?xml version="1.0" encoding="UTF-8"?>
<!--
  US-031 Fase 1 - Lead_SLA_Escalation (Record-Triggered AFTER-SAVE, Create).
  Scheduled Path dispara no SLADeadline__c (calculado pelo before-save a partir do CMT).
  IDEMPOTENCIA: so age se o Lead AINDA esta em 'New' (sem 1a atencion). Se ja saiu de New
  (foi atendido) -> nao faz nada.
  No estouro do SLA:
   - contador SLAReassignCount__c +1, ReassignReason__c, TransferDate__c, asesor anterior
     (TransferredFromOnlineConsultant__c), prioridade alta (IsPriorityRecord).
   - REATRIBUICAO: devolve a fila (OwnerId = fila do CMT EscalationQueueDevName__c).
     >>> reusa as filas nativas; NAO reescreve roteamento. Ver relatorio sobre Omni re-push.
   - Se contador > MaxReassignments (CMT, default 2): notifica o GERENTE, derivado pela
     Role hierarchy (papel pai do dono) filtrado pelo perfil 'Gerente de Ventas'.
  ASSUNCOES (ver relatorio): canal = LeadSource; perfil = 'Gerente de Ventas'; o lead foi
  roteado a um AGENTE (User). Fila placeholder no CMT -> path "sem fila" (soft) + Task.
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Notificar_Gerente</name>
        <label>Notificar Gerente</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <elementReference>Get_NotifType.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <stringValue>Lead reasignado por SLA</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <stringValue>Un lead supero el numero maximo de reasignaciones por SLA sin recibir primera atencion. Revise el detalle.</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>recipientIds</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Capturar_Owner</name>
        <label>Capturar Owner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varPrevOwner</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Config</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Montar_Dest</name>
        <label>Montar Dest</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>recipientIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_Manager.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_NotifType</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Avalia_Max</name>
        <label>Avalia Max</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Dentro do limite</defaultConnectorLabel>
        <rules>
            <name>Passou</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>pasouMax</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_OwnerUser</targetReference>
            </connector>
            <label>Passou do limite</label>
        </rules>
    </decisions>
    <decisions>
        <name>Queue_Found</name>
        <label>Queue Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Log_Sem_Fila</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sem fila (placeholder)</defaultConnectorLabel>
        <rules>
            <name>Tem_Fila</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Queue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Reasignar</targetReference>
            </connector>
            <label>Tem fila</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tem_Manager</name>
        <label>Tem Manager</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Sem gerente</defaultConnectorLabel>
        <rules>
            <name>Achou_Manager</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Manager</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Montar_Dest</targetReference>
            </connector>
            <label>Achou manager</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verifica_Atendido</name>
        <label>Verifica Atendido</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Ja atendido (sai)</defaultConnectorLabel>
        <rules>
            <name>Ainda_New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Capturar_Owner</targetReference>
            </connector>
            <label>Ainda New</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>nuevoContador</name>
        <dataType>Number</dataType>
        <scale>0</scale>
        <expression>BLANKVALUE({!$Record.SLAReassignCount__c}, 0) + 1</expression>
    </formulas>
    <formulas>
        <name>pasouMax</name>
        <dataType>Boolean</dataType>
        <expression>{!nuevoContador} &gt; BLANKVALUE({!Get_Config.MaxReassignments__c}, 2)</expression>
    </formulas>
    <interviewLabel>Lead_SLA_Escalation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead_SLA_Escalation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Log_Falha</name>
        <label>Log Falha</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Falha em Lead_SLA_Escalation (US-031)</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>Log_Sem_Fila</name>
        <label>Log Sem Fila</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Soft</targetReference>
        </connector>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>SLA estourou mas a fila de escalada (EscalationQueueDevName__c) nao esta configurada no CMT. Lead marcado prioritario sem reatribuir. Configure a fila no Lead_SLA_Config.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>SLA: fila de escalada nao configurada</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Config</name>
        <label>Get Config</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Queue</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Default_Bandeja</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead_SLA_Config__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Manager</name>
        <label>Get Manager</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Tem_Manager</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>UserRoleId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Role.ParentRoleId</elementReference>
            </value>
        </filters>
        <filters>
            <field>ProfileId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Profile.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
