    <decisions>
        <name>Afinidad_Valida</name>
        <label>Afinidad Valida</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Rotear_Lead_Queue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sin Afinidad</defaultConnectorLabel>
        <rules>
            <name>Owner_Con_Skill_Y_Online</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_SR_Skill</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Presencia</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Lead_Anterior</targetReference>
            </connector>
            <label>Owner com skill e online</label>
        </rules>
    </decisions>
    <decisions>
        <name>Ventana_Valida</name>
        <label>Ventana Valida</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Rotear_Lead_Queue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Fuera del periodo (rutea normal)</defaultConnectorLabel>
        <rules>
            <name>Dentro_O_Sin_Anterior</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead_Anterior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>dentroVentana</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Route_Agente</targetReference>
            </connector>
            <label>Dentro del periodo o sin lead anterior</label>
        </rules>
    </decisions>
    <decisions>
        <name>Lead_Tiene_Email</name>
        <label>Lead Tiene Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Rotear_Lead_Queue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sin Email</defaultConnectorLabel>
        <rules>
            <name>Con_Email</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Leads.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contact</targetReference>
            </connector>
            <label>Con Email</label>
        </rules>
    </decisions>
    <decisions>
        <name>Owner_Es_User</name>
        <label>Owner Es User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Rotear_Lead_Queue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Owner es Fila</defaultConnectorLabel>
        <rules>
            <name>Es_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>EsUsuario</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_ServiceResource</targetReference>
            </connector>
            <label>Es User</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tiene_Cuenta</name>
        <label>Tiene Cuenta</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Rotear_Lead_Queue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sin Cuenta</defaultConnectorLabel>
        <rules>
            <name>Con_Cuenta</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contact</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Contact.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Cuenta</targetReference>
            </connector>
            <label>Con Cuenta</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>EsUsuario</name>
        <dataType>Boolean</dataType>
        <expression>BEGINS({!Get_Cuenta.OwnerId}, &quot;005&quot;)</expression>
    </formulas>
    <formulas>
        <name>dentroVentana</name>
        <dataType>Boolean</dataType>
        <expression>TODAY() &lt;= ADDMONTHS(DATEVALUE({!Get_Lead_Anterior.CreatedDate}), IF({!Get_OwnerUser.VendedorOnline__c}, 6, 3))</expression>
    </formulas>
    <formulas>
        <name>SkillDevName</name>
        <dataType>String</dataType>
        <expression>&quot;Marca_&quot; &amp; TEXT({!Get_Leads.Brand__c})</expression>
    </formulas>
    <interviewLabel>LeadRouting_OmniFlow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LeadRouting_OmniFlow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
