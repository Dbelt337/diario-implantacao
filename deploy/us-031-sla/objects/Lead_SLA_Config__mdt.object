<?xml version="1.0" encoding="UTF-8"?>
<!--
  US-031 - CMT de SLA de Lead (Sec 37.2.2: SLA por Sociedade+Linea+Canal).
  Nada hardcoded: o flow le o SLA (minutos), o teto de reatribuicoes e a fila de
  escalada DESTE CMT. Chave de match: Channel (obrigatorio) + Sociedad/Línea (opcionais
  p/ override). Linha com Sociedad/Línea em branco = default que vale pra todos.
-->
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Lead SLA Config</label>
    <pluralLabel>Lead SLA Config</pluralLabel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Channel__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Channel</label>
        <length>60</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Sociedad__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Sociedad</label>
        <length>20</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>BusinessLine__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Business Line</label>
        <length>40</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SLAMinutes__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>SLA Minutes</label>
        <precision>6</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>MaxReassignments__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Max Reassignments</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>EscalationQueueDevName__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Escalation Queue Dev Name</label>
        <length>80</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
</CustomObject>
