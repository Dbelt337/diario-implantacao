<?xml version="1.0" encoding="UTF-8"?>
<!--
  US-031 - Lead_BS_SetSLADeadline (Record-Triggered BEFORE-SAVE, Create AND Update).
  Faz DUAS coisas, gateadas por ISNEW()/ISCHANGED() pra nao colidirem:
   1) Fase 1 (no CREATE): calcula SLADeadline__c = agora + SLAMinutes (CMT Default_Bandeja).
   2) Fase 2 (no UPDATE): quando o Status muda, carimba LastGestionDate__c = agora.
      A org nao tem Tasks/Events, entao essa e a marca de "ultima gestao/atencion" que o
      fluxo agendado (Lead_Sched_Inactividad) usa pra detectar inatividade de 24h.
  >>> Substitui o Lead_BS_SetSLADeadline da Fase 1 (mesmo nome). Antes era Create-only.
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Set_Deadline</name>
        <label>Set Deadline</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.SLADeadline__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>deadlineFx</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Stamp_Gestion</name>
        <label>Stamp Gestion</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.LastGestionDate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Es_Nuevo</name>
        <label>Es Nuevo</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Verifica_Gestion</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Update</defaultConnectorLabel>
        <rules>
            <name>Es_Create</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>esNuevo</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_SLA</targetReference>
            </connector>
            <label>Es Create</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tem_SLA</name>
        <label>Tem SLA</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Sem SLA</defaultConnectorLabel>
        <rules>
            <name>Encontrou</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_SLA.SLAMinutes__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Deadline</targetReference>
            </connector>
            <label>Encontrou</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verifica_Gestion</name>
        <label>Verifica Gestion</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Status igual (nao faz nada)</defaultConnectorLabel>
        <rules>
            <name>Status_Cambio</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>statusCambio</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stamp_Gestion</targetReference>
            </connector>
            <label>Status cambio</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>deadlineFx</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.CurrentDateTime} + ({!Get_SLA.SLAMinutes__c} / 1440)</expression>
    </formulas>
    <formulas>
        <name>esNuevo</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>statusCambio</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.Status})</expression>
    </formulas>
    <interviewLabel>Lead_BS_SetSLADeadline {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead_BS_SetSLADeadline</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_SLA</name>
        <label>Get SLA</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Tem_SLA</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Default_Bandeja</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead_SLA_Config__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Es_Nuevo</targetReference>
        </connector>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
