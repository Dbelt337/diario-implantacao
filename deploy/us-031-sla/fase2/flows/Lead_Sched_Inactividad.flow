<?xml version="1.0" encoding="UTF-8"?>
<!--
  US-031 Fase 2 - Lead_Sched_Inactividad (Scheduled-Triggered Flow, Daily).
  Reasigna leads que foram CONTACTADOS (tem LastGestionDate__c) mas ficaram sem gestao
  por +24h. Bulkificado: 1 Get -> Loop monta coleccion -> 1 unico Update DML.
   - Inativos = IsConverted=false AND LastGestionDate__c < (agora - 1 dia).
     (LastGestionDate so e carimbado em mudanca de Status pelo Lead_BS_SetSLADeadline,
      logo so leads ja trabalhados entram; New nunca carimbado fica de fora.)
   - Reasignacao: devolve a fila do CMT (EscalationQueueDevName__c) -> Omni re-roteia.
     NAO reescreve roteamento (igual Fase 1 / ver relatorio).
   - Marca Rating='Hot', contador +1, ReassignReason='Inactividad_24h', TransferDate e
     asesor anterior (TransferredFromOnlineConsultant__c).
   - Notifica o(s) GERENTE(s) (perfil 'Gerente de Ventas / Gerente de Marca') com resumo.
     O NOVO asesor e notificado pelo proprio Omni quando re-rotea da fila (nativo).
  AJUSTE PENDENTE DE VALIDACAO: se houver Status de "perdido/cerrado nao convertido",
  adicionar como filtro negativo no Get_Inactivos pra nao reasignar lead morto.
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Notificar_Gerentes</name>
        <label>Notificar Gerentes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <elementReference>Get_NotifType.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <stringValue>Leads reasignados por inactividad</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <elementReference>bodyMsg</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>recipientIds</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>varSampleLeadId</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Preparar_Update</name>
        <label>Preparar Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Inactivos.TransferredFromOnlineConsultant__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Inactivos.OwnerId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Inactivos.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Queue.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Inactivos.Rating</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Hot</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Inactivos.SLAReassignCount__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>contadorInact</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Inactivos.ReassignReason__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Inactividad_24h</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Inactivos.TransferDate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varUpdates</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Inactivos</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varSampleLeadId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Inactivos.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Inactivos</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Mgr</name>
        <label>Add Mgr</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>recipientIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Mgr.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varMgrCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Mgr</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Queue_Found</name>
        <label>Queue Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Log_Sem_Fila</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sem fila (placeholder)</defaultConnectorLabel>
        <rules>
            <name>Tem_Fila</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Queue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Inactivos</targetReference>
            </connector>
            <label>Tem fila</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Count</name>
        <label>Check Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Nada a reasignar</defaultConnectorLabel>
        <rules>
            <name>Tem_Reasignados</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Inactivos</targetReference>
            </connector>
            <label>Tem reasignados</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tem_Gerente</name>
        <label>Tem Gerente</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Sem gerente (sai)</defaultConnectorLabel>
        <rules>
            <name>Ha_Gerente</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varMgrCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_NotifType</targetReference>
            </connector>
            <label>Ha gerente</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>cutoffDt</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.CurrentDateTime} - 1</expression>
    </formulas>
    <formulas>
        <name>contadorInact</name>
        <dataType>Number</dataType>
        <scale>0</scale>
        <expression>BLANKVALUE({!Loop_Inactivos.SLAReassignCount__c}, 0) + 1</expression>
    </formulas>
    <formulas>
        <name>bodyMsg</name>
        <dataType>String</dataType>
        <expression>"Se reasignaron " &amp; TEXT({!varCount}) &amp; " lead(s) a la bandeja por inactividad de 24h. Revise la cola y la reasignacion."</expression>
    </formulas>
    <interviewLabel>Lead_Sched_Inactividad {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead_Sched_Inactividad</label>
    <loops>
        <name>Loop_Inactivos</name>
        <label>Loop Inactivos</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Inactivos</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Preparar_Update</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_Count</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Mgr</name>
        <label>Loop Mgr</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Managers</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Mgr</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Tem_Gerente</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Log_Falha</name>
        <label>Log Falha</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Falha em Lead_Sched_Inactividad (US-031 Fase 2)</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>Log_Sem_Fila</name>
        <label>Log Sem Fila</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>A varredura de inatividade rodou mas a fila de escalada (EscalationQueueDevName__c) nao esta configurada no CMT Default_Bandeja. Nada reasignado. Configure a fila.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Inatividad 24h: fila de escalada nao configurada</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Config</name>
        <label>Get Config</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Queue</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Default_Bandeja</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead_SLA_Config__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Queue</name>
        <label>Get Queue</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Queue_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Config.EscalationQueueDevName__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Inactivos</name>
        <label>Get Inactivos</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Loop_Inactivos</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>LastGestionDate__c</field>
            <operator>LessThan</operator>
            <value>
                <elementReference>cutoffDt</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Lead</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Profile</name>
        <label>Get Profile</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Managers</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Gerente de Ventas / Gerente de Marca</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Profile</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Managers</name>
        <label>Get Managers</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Loop_Mgr</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ProfileId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Profile.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_NotifType</name>
        <label>Get NotifType</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Notificar_Gerentes</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Lead_SLA_Alert</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Inactivos</name>
        <label>Update Inactivos</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Profile</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <inputReference>varUpdates</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Config</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-06-27</startDate>
            <startTime>06:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varUpdates</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
    <variables>
        <name>recipientIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varMgrCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varSampleLeadId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
