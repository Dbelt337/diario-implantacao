    <dataSourceConfig>{&quot;dataSource&quot;: {&quot;type&quot;: &quot;Query&quot;, &quot;value&quot;: {&quot;dsDelay&quot;: &quot;&quot;, &quot;query&quot;: &quot;SELECT Id, AppointmentNumber, Status, SchedStartTime, SchedEndTime, WorkType.Name, ServiceTerritory.Name, Owner.Name, CreatedBy.Name FROM ServiceAppointment WHERE Id IN (SELECT ServiceAppointmentId FROM AssignedResource WHERE ServiceResourceId = &#x27;{recordId}&#x27;) AND SchedStartTime != NULL AND WorkType.Name LIKE &#x27;Prueba de manejo%&#x27; ORDER BY SchedStartTime DESC&quot;, &quot;jsonMap&quot;: &quot;{\&quot;recordId\&quot;:\&quot;{recordId}\&quot;}&quot;}, &quot;orderBy&quot;: {&quot;name&quot;: &quot;&quot;, &quot;isReverse&quot;: &quot;&quot;}, &quot;contextVariables&quot;: [{&quot;name&quot;: &quot;recordId&quot;, &quot;val&quot;: &quot;0HnWK000000PAfL0AW&quot;, &quot;id&quot;: 0}]}}</dataSourceConfig>
    <description>All countries. Test drive schedule of a vehicle, on its Service Resource page. The SOQL is the privacy control: never select ContactId, ParentRecordId, AccountId or Subject. ParentRecordId is not permissionable.</description>
