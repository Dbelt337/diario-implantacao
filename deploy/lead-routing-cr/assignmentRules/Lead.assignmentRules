<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lead_Routing_GrupoQ - regra unica do objeto Lead (o AssignmentRules e UM arquivo
  por objeto e contem TODAS as regras). Este deploy SOBRESCREVE a regra inteira,
  migrando do padrao antigo (por pais) para Sociedad + Linha de Negocio.
  Escopo: Costa Rica (C101, C105). Sem Motos em CR.
  Fallback (so Sociedad, sem Linha) e a ULTIMA entrada - regras avaliam em ordem
  e param na primeira que casa.
-->
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>Lead_Routing_GrupoQ</fullName>
        <active>true</active>
        <ruleEntries>
            <!-- C101 Autos -->
            <assignedTo>Leads_C101_Autos</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.Sociedad__c</field>
                <operation>equals</operation>
                <value>C101</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.LinhaNegocio__c</field>
                <operation>equals</operation>
                <value>Autos</value>
            </criteriaItems>
        </ruleEntries>
        <ruleEntries>
            <!-- C105 Autos -->
            <assignedTo>Leads_C105_Autos</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.Sociedad__c</field>
                <operation>equals</operation>
                <value>C105</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.LinhaNegocio__c</field>
                <operation>equals</operation>
                <value>Autos</value>
            </criteriaItems>
        </ruleEntries>
        <ruleEntries>
            <!-- CR Frotas (C101 ou C105) -->
            <assignedTo>Leads_CR_Frotas</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.Sociedad__c</field>
                <operation>equals</operation>
                <value>C101,C105</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.LinhaNegocio__c</field>
                <operation>equals</operation>
                <value>Frotas</value>
            </criteriaItems>
        </ruleEntries>
        <ruleEntries>
            <!-- CR Usados (C101 ou C105) -->
            <assignedTo>Leads_CR_Usados</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.Sociedad__c</field>
                <operation>equals</operation>
                <value>C101,C105</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.LinhaNegocio__c</field>
                <operation>equals</operation>
                <value>Usados</value>
            </criteriaItems>
        </ruleEntries>
        <ruleEntries>
            <!-- Fallback CR: Sociedade CR sem linha que casou acima (ULTIMA) -->
            <assignedTo>Leads_CR_Offline</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.Sociedad__c</field>
                <operation>equals</operation>
                <value>C101,C105</value>
            </criteriaItems>
        </ruleEntries>
    </assignmentRule>
</AssignmentRules>
