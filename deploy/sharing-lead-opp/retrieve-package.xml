<?xml version="1.0" encoding="UTF-8"?>
<!--
  Retrieve do estado atual de compartilhamento (Lead/Opportunity) para análise.
  Uso (Workbench: Migration > Retrieve, ou sf):
    sf project retrieve start -x deploy/sharing-lead-opp/retrieve-package.xml -o <org>
  Depois manda o zip resultante que eu analiso roles + OWD + sharing rules.
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- Toda a hierarquia de papéis -->
    <types>
        <members>*</members>
        <name>Role</name>
    </types>
    <!-- Sharing rules existentes de Lead e Opportunity (criteria + owner) -->
    <types>
        <members>Lead</members>
        <members>Opportunity</members>
        <name>SharingRules</name>
    </types>
    <!-- OWD vem no metadata do objeto (sharingModel / externalSharingModel) -->
    <types>
        <members>Lead</members>
        <members>Opportunity</members>
        <name>CustomObject</name>
    </types>
    <!-- Filas (donas de leads não atribuídos) -->
    <types>
        <members>*</members>
        <name>Queue</name>
    </types>
    <version>66.0</version>
</Package>
