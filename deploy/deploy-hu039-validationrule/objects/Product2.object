<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
<validationRules>
        <fullName>Request_Cannot_Be_Active_Before_SAP</fullName>
        <active>true</active>
        <description>RN-07, RN-42, CA-04: a request stays inactive. Only the inbound integration marks Material Created and activates it, because a material exists only once it is in the SAP master. Blocks ticking Active by hand.</description>
        <errorConditionFormula>AND(
  OR(
    RecordType.DeveloperName = "MaterialRequestOriginalPart",
    RecordType.DeveloperName = "MaterialRequestWildcardCode"
  ),
  IsActive,
  NOT(ISPICKVAL(RequestStatus__c, "MaterialCreated"))
)</errorConditionFormula>
        <errorDisplayField>IsActive</errorDisplayField>
        <errorMessage>A material request cannot be activated manually. The record is activated automatically when SAP confirms the code was loaded into the material master.</errorMessage>
    </validationRules>
</CustomObject>
