<?xml version="1.0" encoding="UTF-8"?>
<!-- HU-010 B3: temperatura -> Rating nativo (Hot/Warm/Cold = Caliente/Tibio/Frio).
     Senales del cliente dominan (caliente directo); Einstein Score (via ScoreIntelligenceId) como secundario, terciles 34/67 (default configurable).
     Nunca degrada un Hot ya puesto (ej. SLA vencido por la escalacion). Before-save, triggerOrder 30. -->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Set_Cold</name>
        <label>Rating = Cold</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Rating</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Cold</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Hot</name>
        <label>Rating = Hot</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Rating</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Hot</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Warm</name>
        <label>Rating = Warm</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Rating</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Warm</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Dec_Signals</name>
        <label>Senal caliente directo?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Score</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sin senal fuerte</defaultConnectorLabel>
        <rules>
            <name>Caliente_Directo</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>$Record.TestDriveDateTime__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EstimatedPurchaseTime__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Inmediato</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Hot</targetReference>
            </connector>
            <label>Caliente directo</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Bands</name>
        <label>Bandas por Score</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Sin score (no cambia)</defaultConnectorLabel>
        <rules>
            <name>B_Hot</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Score.Score</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>67.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Hot</targetReference>
            </connector>
            <label>Score alto</label>
        </rules>
        <rules>
            <name>B_Warm</name>
            <conditionLogic>1 AND 2 AND 3</conditionLogic>
            <conditions>
                <leftValueReference>Get_Score.Score</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>34.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Score.Score</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>67.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Rating</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Hot</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Warm</targetReference>
            </connector>
            <label>Score medio</label>
        </rules>
        <rules>
            <name>B_Cold</name>
            <conditionLogic>1 AND 2 AND 3</conditionLogic>
            <conditions>
                <leftValueReference>Get_Score.Score</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>34.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Score.Score</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Rating</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Hot</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Cold</targetReference>
            </connector>
            <label>Score bajo</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Lead_Score_Temperatura {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead_Score_Temperatura</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Score</name>
        <label>Get Score (Einstein)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Dec_Bands</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ScoreIntelligenceId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ScoreIntelligence</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Dec_Signals</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
    <triggerOrder>30</triggerOrder>
</Flow>
