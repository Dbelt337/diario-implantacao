    <decisions>
        <name>Avalia_Max</name>
        <label>Avalia Max</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Dentro do limite</defaultConnectorLabel>
        <rules>
            <name>Passou</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>pasouMax</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asig_Ctx_Max</targetReference>
            </connector>
            <label>Passou do limite</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_Msg</name>
        <label>Mensaje por contexto</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Notificar_Gerente</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>MAX (reasignacion)</defaultConnectorLabel>
        <rules>
            <name>Es_Supervisor</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varNotifContext</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SUP</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notif_Supervisor</targetReference>
            </connector>
            <label>Supervisor (vencimiento)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Queue_Found</name>
        <label>Queue Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Log_Sem_Fila</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sem fila (placeholder)</defaultConnectorLabel>
        <rules>
            <name>Tem_Fila</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Queue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Reasignar</targetReference>
            </connector>
            <label>Tem fila</label>
        </rules>
    </decisions>
    <decisions>
        <name>Reasig_Check</name>
        <label>Reasignar? (sin gestion)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Ya atendido / hubo gestion (sai)</defaultConnectorLabel>
        <rules>
            <name>Sin_Gestion</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Nuevo</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.FechaPrimerContacto__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Capturar_Owner</targetReference>
            </connector>
            <label>Sin gestion valida</label>
        </rules>
    </decisions>
    <decisions>
        <name>Rec_Check</name>
        <label>Recordatorio? (aun Nuevo)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Ya no Nuevo (sai)</defaultConnectorLabel>
        <rules>
            <name>Rec_Nuevo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Nuevo</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asig_Dest_Rec</targetReference>
            </connector>
            <label>Aun Nuevo</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tem_Manager</name>
        <label>Tem Manager</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Sem gerente</defaultConnectorLabel>
        <rules>
            <name>Achou_Manager</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Manager</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Montar_Dest</targetReference>
            </connector>
            <label>Achou manager</label>
        </rules>
    </decisions>
    <decisions>
        <name>Sup_Check</name>
        <label>Supervisor? (aun Nuevo)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Ya no Nuevo (sai)</defaultConnectorLabel>
        <rules>
            <name>Sup_Nuevo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Nuevo</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Cap_Owner_Sup</targetReference>
            </connector>
            <label>Aun Nuevo</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>msgReasign</name>
        <dataType>String</dataType>
        <expression>&quot;Reasignado por SLA - origen &quot; &amp; IF(BEGINS({!varPrevOwner}, &quot;00G&quot;), &quot;fila &quot; &amp; {!Get_FilaAnterior.DeveloperName}, &quot;consultor &quot; &amp; {!varPrevOwner})</expression>
    </formulas>
    <formulas>
        <name>nuevoContador</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!$Record.SLAReassignCount__c}, 0) + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>pasouMax</name>
        <dataType>Boolean</dataType>
        <expression>{!nuevoContador} &gt; BLANKVALUE({!Get_Config.MaxReassignments__c}, 2)</expression>
    </formulas>
    <formulas>
        <name>prevConsultor</name>
        <dataType>String</dataType>
        <expression>IF(BEGINS({!varPrevOwner}, &quot;005&quot;), {!varPrevOwner}, &quot;&quot;)</expression>
    </formulas>
    <interviewLabel>Lead_SLA_Escalation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead_SLA_Escalation</label>
    <processMetadataValues>
