<?xml version="1.0" encoding="UTF-8"?>
<!-- HU-010 B2 (Opcion B, GO Beltrao): escada coerente. Deploy INATIVO (Draft) + ativar na tela apos validar.
     Ladder: Path_Recordatorio (-15) avisa dono -> Path_SLA (0) notifica supervisor -> Path_10min (+10) reasigna si FechaPrimerContacto__c IsNull.
     Depende de: Lead.FechaPrimerContacto__c, Lead.LastReminderDate__c. -->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Notif_Recordatorio</name>
        <label>Notif Recordatorio (dueno)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <connector>
            <targetReference>Update_Recordatorio</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <elementReference>Get_NotifType_Rec.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <stringValue>Recordatorio SLA - Primer contacto</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <stringValue>El SLA de primer contacto de este lead esta por vencer. Contactelo cuanto antes.</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>recipientIds</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
    </actionCalls>
    <actionCalls>
        <name>Notif_Supervisor</name>
