        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>recipientIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_NotifType_Rec</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Cap_Owner_Sup</name>
        <label>Capturar Owner (supervisor)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varPrevOwner</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNotifContext</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>SUP</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_OwnerUser</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Capturar_Owner</name>
