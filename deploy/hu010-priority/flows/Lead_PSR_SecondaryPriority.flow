<?xml version="1.0" encoding="UTF-8"?>
<!-- HU-010 Priorizacion (Enhanced Omni + skills-based): record-triggered no PendingServiceRouting.
     Le o Rating do Lead roteado e grava SecondaryRoutingPriority (Hot=0, Warm=1, Cold=2; 0 = maior prioridade).
     Caminho documentado para skills-based ("update SecondaryRoutingPriority on PSR"). Declarativo, sem Apex, nao toca LeadRouting_OmniFlow. -->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <decisions>
        <name>Tiene_Rating</name>
        <label>Es Lead con Rating?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No (sai)</defaultConnectorLabel>
        <rules>
            <name>Con_Rating</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lead.Rating</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_PSR</targetReference>
            </connector>
            <label>Lead con Rating</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fPrioridad</name>
        <dataType>Number</dataType>
        <expression>CASE(TEXT({!Get_Lead.Rating}), &quot;Hot&quot;, 0, &quot;Warm&quot;, 1, &quot;Cold&quot;, 2, 3)</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Lead_PSR_SecondaryPriority {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead_PSR_SecondaryPriority</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Log_Falha</name>
        <label>Log Falha</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Falha em Lead_PSR_SecondaryPriority (HU-010)</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.WorkItemId</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Lead</name>
        <label>Get Lead (WorkItemId)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Tiene_Rating</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WorkItemId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_PSR</name>
        <label>Update PSR (prioridad)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>RoutingPriority</field>
            <value>
                <elementReference>fPrioridad</elementReference>
            </value>
        </inputAssignments>
        <object>PendingServiceRouting</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Lead</targetReference>
        </connector>
        <object>PendingServiceRouting</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
