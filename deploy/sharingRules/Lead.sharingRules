<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Lead_Brand_ARCFOX</fullName>
        <accessLevel>Read</accessLevel>
        <criteriaItems>
            <field>Brand__c</field>
            <operation>equals</operation>
            <value>ARCFOX</value>
        </criteriaItems>
        <description>Business purpose: with Lead OWD Private, opens Read Only visibility of ARCFOX leads to the ARCFOX brand team (public group PG_Marca_ARCFOX), including the brand manager, whose role has no subordinates in the hierarchy. When used: evaluated automatically on lead create/update. Country considerations: applies across all countries; territorial visibility comes from the role hierarchy.</description>
        <label>Lead Brand ARCFOX</label>
        <sharedTo>
            <group>PG_Marca_ARCFOX</group>
        </sharedTo>
    </sharingCriteriaRules>
