<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================================
  Lead_BS_DeriveSociedad — EVOLUIDO (reuso, conforme instrucao 3.2).
  MUDANCAS EM RELACAO A VERSAO ATIVA (revisar antes do deploy):
   (1) Entry ampliada: antes "CompanyCode__c IsNull"; agora
       "CompanyCode__c IsNull OR Country__c IsNull" — para tambem carimbar pais
       em leads que JA tem Sociedade (ex.: C105).
   (2) As 2 assignments do fallback passam a gravar $Record.CompanyCode__c
       (antes gravavam $Record.Sociedad__c, campo inexistente -> no-op e
       impediria a reimplantacao). Efeito: o fallback de Sociedade passa a
       funcionar de fato.
   (3) NOVO ramo de pais: se Country__c vazio e CompanyCode__c resolvido ->
       Get Sociedad_Config__mdt (DeveloperName = CompanyCode__c) ->
       Country__c = Country_Picklist_Value__c. Nao sobrescreve se ja preenchido.
  Substitui o flow separado Lead_BS_DeriveCountry (descartado).
============================================================================ -->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Final_Default</name>
        <label>Assign Final Default</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.CompanyCode__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Config.Default_Sociedad__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_NeedsCountry</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Final_FromUser</name>
        <label>Assign Final From User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.CompanyCode__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$User.Sociedad__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_NeedsCountry</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Country</name>
        <label>Assign Country</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Country__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Sociedad_Config.Country_Picklist_Value__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Decision_NeedsSociedad</name>
        <label>Decision Needs Sociedad</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Decision_NeedsCountry</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sociedad ya presente</defaultConnectorLabel>
        <rules>
            <name>Falta_Sociedad</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CompanyCode__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Config</targetReference>
            </connector>
            <label>Falta Sociedad</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_FinalResolution</name>
        <label>Decision Final Resolution</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Final_Default</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Config</defaultConnectorLabel>
        <rules>
            <name>UserHasSociedad</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.Sociedad__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Final_FromUser</targetReference>
            </connector>
            <label>User Has Sociedad</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_NeedsCountry</name>
        <label>Decision Needs Country</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No aplica</defaultConnectorLabel>
        <rules>
            <name>Necesita_Pais</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Country__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CompanyCode__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Sociedad_Config</targetReference>
            </connector>
            <label>Necesita Pais</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tem_Valor</name>
        <label>Tem Valor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Sin valor</defaultConnectorLabel>
        <rules>
            <name>Config_Con_Valor</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Sociedad_Config.Country_Picklist_Value__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Country</targetReference>
            </connector>
            <label>Config con valor</label>
        </rules>
    </decisions>
    <description>Deriva Lead.CompanyCode__c (Sociedad) como FALLBACK (nivel 4 $User.Sociedad__c, nivel 5 default Lead_Routing_Config__mdt) e carimba Lead.Country__c a partir da Sociedad via Sociedad_Config__mdt.Country_Picklist_Value__c. Before-save. Trust the source: nao sobrescreve valores ja presentes.</description>
    <environments>Default</environments>
    <interviewLabel>Lead_BS_DeriveSociedad {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead BS DeriveSociedad</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Config</name>
        <label>Get Config</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_FinalResolution</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Default</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead_Routing_Config__mdt</object>
        <queriedFields>Default_Sociedad__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Sociedad_Config</name>
        <label>Get Sociedad Config</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Tem_Valor</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CompanyCode__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Sociedad_Config__mdt</object>
        <queriedFields>Country_Picklist_Value__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decision_NeedsSociedad</targetReference>
        </connector>
        <filterLogic>1 OR 2</filterLogic>
        <filters>
            <field>CompanyCode__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Country__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
