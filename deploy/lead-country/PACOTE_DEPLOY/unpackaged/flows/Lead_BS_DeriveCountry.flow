<?xml version="1.0" encoding="UTF-8"?>
<!-- Lead_BS_DeriveCountry: carimba Lead.Country__c a partir de CompanyCode__c (Sociedad)
     via Sociedad_Config__mdt.Country_Picklist_Value__c. Before-save, zero DML.
     Trust the source: so age quando Country__c esta vazio (entry condition). NAO
     substitui o Lead_BS_DeriveSociedad (que resolve Sociedad); e complementar. -->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Country</name>
        <label>Assign Country</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Country__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Sociedad_Config.Country_Picklist_Value__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Tem_Valor</name>
        <label>Tem Valor</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Sin valor</defaultConnectorLabel>
        <rules>
            <name>Config_Con_Valor</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Sociedad_Config.Country_Picklist_Value__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Country</targetReference>
            </connector>
            <label>Config con valor</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Lead_BS_DeriveCountry {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead BS DeriveCountry</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Sociedad_Config</name>
        <label>Get Sociedad Config</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Tem_Valor</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CompanyCode__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Sociedad_Config__mdt</object>
        <queriedFields>Country_Picklist_Value__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Sociedad_Config</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CompanyCode__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Country__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
