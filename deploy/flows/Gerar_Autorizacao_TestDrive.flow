<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Gerar_Documento_Servico</name>
        <label>Gerar Documento de Servico</label>
        <locationX>176</locationX>
        <locationY>374</locationY>
        <actionName>createServiceDocument</actionName>
        <actionType>createServiceDocument</actionType>
        <connector><targetReference>Screen_Aguardando</targetReference></connector>
        <faultConnector><targetReference>Screen_Erro</targetReference></faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>recordId</name>
            <value><elementReference>recordId</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>templateId</name>
            <value><elementReference>inputTemplateId</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value><elementReference>fTituloDocumento</elementReference></value>
        </inputParameters>
        <nameSegment>createServiceDocument</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>

    <apiVersion>66.0</apiVersion>

    <decisions>
        <name>Decision_Config_Valida</name>
        <label>Config Valida?</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Screen_Erro_Config</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Inputs incompletos</defaultConnectorLabel>
        <rules>
            <name>Config_OK</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inputTemplateId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Get_Service_Appointment</targetReference></connector>
            <label>Config OK</label>
        </rules>
    </decisions>

    <decisions>
        <name>Decision_Doc_Pronto</name>
        <label>Documento Pronto?</label>
        <locationX>176</locationX>
        <locationY>734</locationY>
        <defaultConnector>
            <targetReference>Screen_Aguardando</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Ainda gerando</defaultConnectorLabel>
        <rules>
            <name>Doc_Disponivel</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Service_Report</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Service_Report.ContentVersionDocumentId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Screen_Preview_Documento</targetReference></connector>
            <label>Doc disponivel</label>
        </rules>
    </decisions>

    <description>Gera a autorizacao de test drive a partir de um Service Appointment usando a acao Create Service Document (Field Service Document Builder) e exibe o PDF gerado na tela com o componente File Preview (Spring 26). A acao retorna pdfReportId (registro Service Report que recebe o PDF de forma assincrona); o flow consulta o ServiceReport ate o campo ContentVersionDocumentId ser preenchido e entao exibe esse ContentDocument. Sem Visualforce e sem Apex.</description>
    <environments>Default</environments>

    <formulas>
        <description>Titulo do documento gerado.</description>
        <name>fTituloDocumento</name>
        <dataType>String</dataType>
        <expression>"Autorizacao Test Drive - " &amp; {!Get_Service_Appointment.AppointmentNumber}</expression>
    </formulas>

    <formulas>
        <description>URL do preview padrao do arquivo gerado.</description>
        <name>fUrlDocumento</name>
        <dataType>String</dataType>
        <expression>"/lightning/r/ContentDocument/" &amp; {!Get_Service_Report.ContentVersionDocumentId} &amp; "/view"</expression>
    </formulas>

    <interviewLabel>Gerar Autorizacao TestDrive {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Gerar Autorizacao Test Drive</label>

    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>

    <processType>Flow</processType>

    <recordLookups>
        <name>Get_Service_Appointment</name>
        <label>Get Service Appointment</label>
        <locationX>176</locationX>
        <locationY>254</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Gerar_Documento_Servico</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>recordId</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ServiceAppointment</object>
        <sortField>Id</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <recordLookups>
        <name>Get_Service_Report</name>
        <label>Get Service Report</label>
        <locationX>176</locationX>
        <locationY>614</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Decision_Doc_Pronto</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>Gerar_Documento_Servico.pdfReportId</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ServiceReport</object>
        <sortField>Id</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <runInMode>DefaultMode</runInMode>

    <screens>
        <name>Screen_Aguardando</name>
        <label>Gerando Documento</label>
        <locationX>176</locationX>
        <locationY>494</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>TextoAguardando</name>
            <fieldText>&lt;p&gt;&lt;b&gt;O documento esta sendo gerado.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;A geracao e assincrona e pode levar alguns segundos. Clique em &lt;b&gt;Avancar&lt;/b&gt; para verificar se a autorizacao ja esta disponivel.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Avancar</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <connector><targetReference>Get_Service_Report</targetReference></connector>
    </screens>

    <screens>
        <name>Screen_Erro</name>
        <label>Erro na Geracao</label>
        <locationX>440</locationX>
        <locationY>494</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>TextoErro</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Nao foi possivel gerar o documento.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Detalhe tecnico: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <screens>
        <name>Screen_Erro_Config</name>
        <label>Configuracao Incompleta</label>
        <locationX>440</locationX>
        <locationY>254</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>TextoErroConfig</name>
            <fieldText>&lt;p&gt;O flow precisa receber o &lt;b&gt;recordId&lt;/b&gt; do Service Appointment e o &lt;b&gt;inputTemplateId&lt;/b&gt; do template criado no Document Builder (ID que aparece na URL do template depois de &amp;amp;id=). Configure os inputs no botao/acao que chama este flow.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <screens>
        <name>Screen_Preview_Documento</name>
        <label>Autorizacao de Test Drive</label>
        <locationX>176</locationX>
        <locationY>854</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>TextoConferencia</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Documento gerado com sucesso.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Confira os dados da autorizacao (veiculo, cliente, datas) antes de imprimir e colher a assinatura.&lt;/p&gt;&lt;p&gt;&lt;a href="{!fUrlDocumento}" target="_blank"&gt;Abrir a autorizacao&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;i&gt;Nota: quando confirmarmos o nome do componente File Preview (Spring 26), este link sera substituido pelo preview do PDF nesta mesma tela.&lt;/i&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decision_Config_Valida</targetReference>
        </connector>
    </start>

    <status>Active</status>

    <variables>
        <description>Id do template criado no Document Builder (prefixo 0M0, visivel na URL do template depois de &amp;id=). Informar via input do botao/acao que chama o flow.</description>
        <name>inputTemplateId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Id do Service Appointment. Preenchido automaticamente quando o flow roda na pagina do registro.</description>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

</Flow>
