<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>

    <decisions>
        <name>Has_File</name>
        <label>Has File?</label>
        <locationX>176</locationX>
        <locationY>254</locationY>
        <defaultConnector>
            <targetReference>Show_No_File_Message</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No File</defaultConnectorLabel>
        <rules>
            <name>File_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Latest_Content_Document_Link</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Preview_File</targetReference></connector>
            <label>File Found</label>
        </rules>
    </decisions>

    <description>Business purpose: lets a user review the most recent file attached to any record without leaving the page, using the native File Preview screen component (Spring 26). When used: launched from an action on a record page, for example to re-open a previously generated test drive authorization at the reception desk. Dependencies: File Preview screen component (org must be on Spring 26 or later; running user needs access to the file); reads ContentDocumentLink. Country considerations: none.</description>
    <environments>Default</environments>

    <interviewLabel>Preview Record File {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Preview Record File</label>

    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>

    <processType>Flow</processType>

    <recordLookups>
        <name>Get_Latest_Content_Document_Link</name>
        <label>Get Latest Content Document Link</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Has_File</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LinkedEntityId</field>
            <operator>EqualTo</operator>
            <value><elementReference>recordId</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ContentDocumentLink</object>
        <sortField>SystemModstamp</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <runInMode>DefaultMode</runInMode>

    <screens>
        <name>Preview_File</name>
        <label>Preview File</label>
        <locationX>50</locationX>
        <locationY>374</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>RecordFilePreview</name>
            <extensionName>flowruntime:filePreview</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>contentDocumentId</name>
                <value><elementReference>Get_Latest_Content_Document_Link.ContentDocumentId</elementReference></value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <screens>
        <name>Show_No_File_Message</name>
        <label>Show No File Message</label>
        <locationX>302</locationX>
        <locationY>374</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>NoFileMessageText</name>
            <fieldText>&lt;p&gt;No se encontro ningun archivo para este registro. Suba un archivo en la lista relacionada Files y ejecute el flujo nuevamente.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Latest_Content_Document_Link</targetReference>
        </connector>
    </start>

    <status>Active</status>

    <variables>
        <description>Id of the record whose latest file is previewed. Populated automatically when the flow runs from a record page.</description>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

</Flow>
