<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Post_Duplicate_Alert_To_Feed</name>
        <label>Post Duplicate Alert to Feed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>chatterPost</actionName>
        <actionType>chatterPost</actionType>
        <connector><targetReference>Is_Owner_A_User</targetReference></connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>text</name>
            <value><elementReference>alertaTexto</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>subjectNameOrId</name>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputParameters>
        <nameSegment>chatterPost</nameSegment>
    </actionCalls>

    <actionCalls>
        <name>Notify_Owner</name>
        <label>Notify Owner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value><elementReference>Get_Notification_Type.Id</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value><elementReference>notificationRecipients</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value><stringValue>Posible lead duplicado</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value><elementReference>alertaTextoNotificacion</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value><elementReference>Get_Cross_Duplicate.Id</elementReference></value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
    </actionCalls>

    <apiVersion>62.0</apiVersion>

    <assignments>
        <name>Add_Owner_To_Recipients</name>
        <label>Add Owner to Recipients</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>notificationRecipients</assignToReference>
            <operator>Add</operator>
            <value><elementReference>$Record.OwnerId</elementReference></value>
        </assignmentItems>
        <connector><targetReference>Get_Notification_Type</targetReference></connector>
    </assignments>

    <decisions>
        <name>Found_Cross_Duplicate</name>
        <label>Found Cross Duplicate?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Duplicate</defaultConnectorLabel>
        <rules>
            <name>Duplicate_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Cross_Duplicate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Post_Duplicate_Alert_To_Feed</targetReference></connector>
            <label>Duplicate Found</label>
        </rules>
    </decisions>

    <decisions>
        <name>Is_Owner_A_User</name>
        <label>Is Owner a User?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Owner Is Queue</defaultConnectorLabel>
        <rules>
            <name>Owner_Is_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ownerEsUsuario</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Add_Owner_To_Recipients</targetReference></connector>
            <label>Owner Is User</label>
        </rules>
    </decisions>

    <description>Business purpose: alerts (without blocking, per US-005) when a Lead shares contact data across DIFFERENT fields with another lead — combinations that native matching rules cannot evaluate (cross-field: new Email vs existing SecondaryEmail__c and vice versa, same for Phone/SecondaryPhone__c). When used: after save on Lead create, and on update when any of the four fields changes. How it alerts: Chatter post on the lead record plus a custom notification (DuplicateLeadAlert) to the owner when the owner is a user (queues are skipped). Blank values are replaced by a sentinel so they never match other blanks. Dependencies: fields SecondaryEmail__c and SecondaryPhone__c on Lead; CustomNotificationType DuplicateLeadAlert; Chatter enabled. Same-field duplicates remain covered by the native matching rules. Country considerations: alert texts in Spanish.</description>
    <environments>Default</environments>

    <formulas>
        <description>Org base URL derived from the API endpoint, so links work in any sandbox or production without hardcoding the domain.</description>
        <name>fBaseUrl</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_560}, FIND("/services", {!$Api.Partner_Server_URL_560}) - 1)</expression>
    </formulas>

    <formulas>
        <description>Chatter message with the full clickable link to the matching lead. Phone match is exact text; formatting differences are not normalized in this version.</description>
        <name>alertaTexto</name>
        <dataType>String</dataType>
        <expression>"Posible duplicado: este lead comparte email o teléfono (campos cruzados) con el lead \"" &amp; {!Get_Cross_Duplicate.Name} &amp; "\". Revíselo antes de continuar: " &amp; {!fBaseUrl} &amp; "/lightning/r/Lead/" &amp; {!Get_Cross_Duplicate.Id} &amp; "/view"</expression>
    </formulas>

    <formulas>
        <description>Notification body: no URL needed, clicking the notification opens the matching lead (targetId).</description>
        <name>alertaTextoNotificacion</name>
        <dataType>String</dataType>
        <expression>"Posible duplicado: este lead comparte email o teléfono (campos cruzados) con el lead \"" &amp; {!Get_Cross_Duplicate.Name} &amp; "\". Haga clic en esta notificación para abrir el lead coincidente."</expression>
    </formulas>

    <formulas>
        <description>Sentinel keeps a blank value from matching other blanks in the cross lookup.</description>
        <name>fEmail</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Email}), "##SIN-VALOR##", {!$Record.Email})</expression>
    </formulas>

    <formulas>
        <description>Sentinel keeps a blank value from matching other blanks in the cross lookup.</description>
        <name>fSecEmail</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.SecondaryEmail__c}), "##SIN-VALOR##", {!$Record.SecondaryEmail__c})</expression>
    </formulas>

    <formulas>
        <description>Sentinel keeps a blank value from matching other blanks in the cross lookup.</description>
        <name>fPhone</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Phone}), "##SIN-VALOR##", {!$Record.Phone})</expression>
    </formulas>

    <formulas>
        <description>Sentinel keeps a blank value from matching other blanks in the cross lookup.</description>
        <name>fSecPhone</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.SecondaryPhone__c}), "##SIN-VALOR##", {!$Record.SecondaryPhone__c})</expression>
    </formulas>

    <formulas>
        <description>Custom notifications only accept users as recipients; queue-owned leads skip the notification and keep the Chatter post.</description>
        <name>ownerEsUsuario</name>
        <dataType>Boolean</dataType>
        <expression>BEGINS({!$Record.OwnerId}, "005")</expression>
    </formulas>

    <interviewLabel>Lead AS Cross Field Duplicate Alert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead AS Cross Field Duplicate Alert</label>

    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>

    <processType>AutoLaunchedFlow</processType>

    <recordLookups>
        <name>Get_Cross_Duplicate</name>
        <label>Get Cross Duplicate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Found_Cross_Duplicate</targetReference></connector>
        <filterLogic>(1 OR 2 OR 3 OR 4) AND 5 AND 6</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value><elementReference>fSecEmail</elementReference></value>
        </filters>
        <filters>
            <field>SecondaryEmail__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>fEmail</elementReference></value>
        </filters>
        <filters>
            <field>Phone</field>
            <operator>EqualTo</operator>
            <value><elementReference>fSecPhone</elementReference></value>
        </filters>
        <filters>
            <field>SecondaryPhone__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>fPhone</elementReference></value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value><elementReference>$Record.Id</elementReference></value>
        </filters>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <recordLookups>
        <name>Get_Notification_Type</name>
        <label>Get Notification Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Notify_Owner</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value><stringValue>DuplicateLeadAlert</stringValue></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Get_Cross_Duplicate</targetReference></connector>
        <filterFormula>AND(
    NOT({!$Record.IsConverted}),
    OR(
        ISNEW(),
        ISCHANGED({!$Record.Email}),
        ISCHANGED({!$Record.SecondaryEmail__c}),
        ISCHANGED({!$Record.Phone}),
        ISCHANGED({!$Record.SecondaryPhone__c})
    )
)</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>

    <status>Active</status>

    <variables>
        <name>notificationRecipients</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
