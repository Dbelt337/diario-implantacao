<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Estampar_Pricebook</name>
        <label>Estampar Pricebook2Id</label>
        <locationX>176</locationX>
        <locationY>492</locationY>
        <assignmentItems>
            <assignToReference>$Record.Pricebook2Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Pricebook.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Debe_Estampar</name>
        <label>¿Debe estampar Price Book?</label>
        <locationX>176</locationX>
        <locationY>222</locationY>
        <defaultConnectorLabel>No (sin sociedad o ya tiene book): salir</defaultConnectorLabel>
        <rules>
            <name>Si_debe</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CompanyCode__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Pricebook</targetReference>
            </connector>
            <label>Sí</label>
        </rules>
    </decisions>
    <decisions>
        <name>Pricebook_Encontrado</name>
        <label>¿Price Book encontrado?</label>
        <locationX>176</locationX>
        <locationY>384</locationY>
        <defaultConnectorLabel>No encontrado (salir sin estampar)</defaultConnectorLabel>
        <rules>
            <name>Si_encontrado</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Pricebook.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Estampar_Pricebook</targetReference>
            </connector>
            <label>Sí</label>
        </rules>
    </decisions>
    <description>GQ.AUT.US025 H2: before-save de Opportunity (banda 11) que estampa el Pricebook2Id por SOCIEDAD en el CREATE (conversion, manual, API; sin segundo save). La sociedad esta en CompanyCode__c (mapeado Lead-&gt;Opp via Map Lead Fields). El unico vinculo book&lt;-&gt;sociedad es el NOMBRE del Price Book, que empieza con el codigo de sociedad (ej.: "C101 - Vehiculos y Motos (CR)"). Busca el Pricebook2 activo cuyo Name empieza con CompanyCode__c y lo estampa, para que la transformacion LeadLineItem-&gt;OpportunityLineItem resuelva el PricebookEntry del book correcto. Solo actua si Pricebook2Id esta vacio (respeta eleccion manual) y CompanyCode__c no esta vacio. SUPUESTO A VALIDAR: CompanyCode__c contiene exactamente el prefijo del nombre del book (ej. "C101"); si difiere, ajustar via formula. Books: 1 por sociedad (6). Todas las PBE del C101 estan activas y en CRC (verificado).</description>
    <environments>Default</environments>
    <interviewLabel>Opp_BS_EstampaPricebook {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opp_BS_EstampaPricebook</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Pricebook</name>
        <label>Obtener Price Book de la sociedad</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Pricebook_Encontrado</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>StartsWith</operator>
            <value>
                <elementReference>$Record.CompanyCode__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Pricebook2</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Debe_Estampar</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>11</triggerOrder>
</Flow>
