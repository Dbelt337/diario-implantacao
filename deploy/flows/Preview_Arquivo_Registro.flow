<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>

    <decisions>
        <name>Decision_Tem_Arquivo</name>
        <label>Tem Arquivo?</label>
        <locationX>176</locationX>
        <locationY>254</locationY>
        <defaultConnector>
            <targetReference>Screen_Sem_Arquivo</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sem arquivo</defaultConnectorLabel>
        <rules>
            <name>Arquivo_Encontrado</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Arquivo_Do_Registro</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Screen_Preview_Arquivo</targetReference></connector>
            <label>Arquivo encontrado</label>
        </rules>
    </decisions>

    <description>Screen Flow que exibe o preview do arquivo mais recente vinculado a um registro, usando o componente nativo File Preview (Spring 26). Recebe recordId como input (disponivel automaticamente quando executado a partir de uma pagina de registro), busca o ContentDocumentLink mais recente do registro e mostra o arquivo na tela.</description>
    <environments>Default</environments>

    <interviewLabel>Preview Arquivo Registro {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Preview Arquivo Registro</label>

    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>

    <processType>Flow</processType>

    <recordLookups>
        <name>Get_Arquivo_Do_Registro</name>
        <label>Get Arquivo do Registro</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Decision_Tem_Arquivo</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LinkedEntityId</field>
            <operator>EqualTo</operator>
            <value><elementReference>recordId</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ContentDocumentLink</object>
        <sortField>SystemModstamp</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <runInMode>DefaultMode</runInMode>

    <screens>
        <name>Screen_Preview_Arquivo</name>
        <label>Preview do Arquivo</label>
        <locationX>50</locationX>
        <locationY>374</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>FilePreview</name>
            <extensionName>flowruntime:filePreview</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>contentDocumentId</name>
                <value><elementReference>Get_Arquivo_Do_Registro.ContentDocumentId</elementReference></value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <screens>
        <name>Screen_Sem_Arquivo</name>
        <label>Nenhum Arquivo</label>
        <locationX>302</locationX>
        <locationY>374</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>TextoSemArquivo</name>
            <fieldText>&lt;p&gt;Nenhum arquivo encontrado para este registro. Faca o upload de um arquivo na lista relacionada Files e execute o flow novamente.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Arquivo_Do_Registro</targetReference>
        </connector>
    </start>

    <status>Active</status>

    <variables>
        <description>Id do registro de onde o flow e executado. Preenchido automaticamente quando o flow roda em uma pagina de registro.</description>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

</Flow>
