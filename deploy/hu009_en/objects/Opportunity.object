<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <enableHistory>true</enableHistory>
    <fields>
        <fullName>ChannelCode__c</fullName>
        <label>Canal Originador (Código de Canal)</label>
        <length>50</length>
        <type>Text</type>
        <description>HU-009 (all countries): channel that originated the opportunity. Filled natively by Lead Conversion Mapping from Lead.ChannelCode__c - never by flow or user.</description>
        <required>false</required>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>OriginatingDigitalAdvisor__c</fullName>
        <label>Asesor Digital Originador</label>
        <type>Lookup</type>
        <referenceTo>User</referenceTo>
        <relationshipLabel>Oportunidades Originadas (Digital)</relationshipLabel>
        <relationshipName>OriginatedOpportunitiesDigital</relationshipName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>HU-009 (all countries): digital advisor who originated the opportunity. Stamped by the hand-off flow (current Owner when the first in-person activity is scheduled), immutable afterwards. Basis for commission traceability.</description>
        <required>false</required>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>HandOffDate__c</fullName>
        <label>Fecha de Hand-Off</label>
        <type>DateTime</type>
        <description>HU-009 (all countries): moment when Recibir Cliente was executed (Owner changed to the in-person advisor).</description>
        <required>false</required>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>HandOffStatus__c</fullName>
        <label>Estado Hand-Off</label>
        <type>Picklist</type>
        <description>HU-009 (all countries): operational hand-off state. Sin hand-off (default) / Pendiente Recepcion (in-person activity scheduled) / Recibido (after Recibir Cliente).</description>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>Sin hand-off</fullName><default>true</default><label>Sin hand-off</label></value>
                <value><fullName>Pendiente Recepción</fullName><default>false</default><label>Pendiente Recepción</label></value>
                <value><fullName>Recibido</fullName><default>false</default><label>Recibido</label></value>
            </valueSetDefinition>
        </valueSet>
    </fields>
</CustomObject>
