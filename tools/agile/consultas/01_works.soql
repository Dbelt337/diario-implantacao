SELECT Id, Name, agf__Subject__c, agf__Scrum_Team__r.Name, agf__Sprint__r.Name, agf__Sprint__r.agf__Scrum_Team__r.Name, agf__Priority__c, agf__Assignee__r.Name, agf__Product_Owner__r.Name, agf__Status__c, agf__Epic__r.Name, agf__Product_Tag__r.Name, agf__Story_Points__c, RecordType.Name, agf__Details__c, CreatedBy.Name, CreatedDate, LastModifiedBy.Name, LastModifiedDate FROM agf__ADM_Work__c ORDER BY Name
