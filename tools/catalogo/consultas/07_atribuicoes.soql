SELECT vlocity_cmt__ObjectId__c, vlocity_cmt__AttributeId__r.vlocity_cmt__Code__c, vlocity_cmt__AttributeId__r.Name, vlocity_cmt__IsRequired__c, vlocity_cmt__IsConfigurable__c, vlocity_cmt__IsHidden__c, vlocity_cmt__IsReadOnly__c, vlocity_cmt__Value__c, vlocity_cmt__AttributeDisplaySequence__c FROM vlocity_cmt__AttributeAssignment__c WHERE vlocity_cmt__ObjectId__c != null ORDER BY vlocity_cmt__ObjectId__c, vlocity_cmt__AttributeDisplaySequence__c
