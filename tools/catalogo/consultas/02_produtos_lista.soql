SELECT Id, Name, ProductCode, vlocity_cmt__GlobalKey__c, vlocity_cmt__SpecificationType__c, vlocity_cmt__SpecificationSubType__c, vlocity_cmt__ObjectTypeId__r.Name, vlocity_cmt__IsOrderable__c, vlocity_cmt__IsConfigurable__c, vlocity_cmt__IsNotAssetizable__c, Family, IsActive, CreatedDate, LastModifiedDate, LastModifiedBy.Name FROM Product2 ORDER BY vlocity_cmt__SpecificationType__c, ProductCode
