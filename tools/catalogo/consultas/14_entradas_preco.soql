SELECT vlocity_cmt__ProductId__r.ProductCode, vlocity_cmt__ProductId__r.Name, vlocity_cmt__PriceListId__r.Name, vlocity_cmt__PricingElementId__r.Name, vlocity_cmt__PricingElementId__r.vlocity_cmt__Amount__c, vlocity_cmt__IsActive__c, vlocity_cmt__IsBasePrice__c, vlocity_cmt__EffectiveFromDate__c, vlocity_cmt__EffectiveUntilDate__c, vlocity_cmt__DisplayText__c FROM vlocity_cmt__PriceListEntry__c ORDER BY vlocity_cmt__PriceListId__r.Name, vlocity_cmt__ProductId__r.ProductCode
