SELECT Id, Name, vlocity_cmt__Code__c, vlocity_cmt__IsActive__c, vlocity_cmt__EffectiveStartTime__c, vlocity_cmt__EffectiveEndTime__c, vlocity_cmt__CommitmentPeriod__c, (SELECT vlocity_cmt__ProductId__r.ProductCode, vlocity_cmt__OfferId__r.ProductCode, vlocity_cmt__AdjustmentType__c, vlocity_cmt__AdjustmentValue__c, vlocity_cmt__TimePlanId__r.Name, vlocity_cmt__TimePolicyId__r.Name FROM vlocity_cmt__PromotionItems__r) FROM vlocity_cmt__Promotion__c ORDER BY Name
