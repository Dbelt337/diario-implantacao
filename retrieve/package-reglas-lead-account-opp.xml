<?xml version="1.0" encoding="UTF-8"?>
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- Validation rules: a API nao aceita curinga por objeto (ex.: Lead.*),
         entao o * traz as de todos os objetos; as de Lead, Account e
         Opportunity vem nos respectivos arquivos .object -->
    <types>
        <members>*</members>
        <name>ValidationRule</name>
    </types>
    <!-- Duplicate rules de Lead, Conta e Oportunidade -->
    <types>
        <members>*</members>
        <name>DuplicateRule</name>
    </types>
    <!-- Matching rules: necessarias para entender as duplicate rules -->
    <types>
        <members>Account</members>
        <members>Lead</members>
        <members>Opportunity</members>
        <name>MatchingRules</name>
    </types>
    <version>65.0</version>
</Package>
