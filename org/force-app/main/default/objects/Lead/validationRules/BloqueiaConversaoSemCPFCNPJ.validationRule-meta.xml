<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>BloqueiaConversaoSemCPFCNPJ</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
				ISBLANK(DocumentNumber__c),
				NOT(ISNEW()),
    IsConverted 				
)</errorConditionFormula>
    <errorMessage>Atenção: Antes de converter um Lead é necessário preencher o campo &apos;CPF/CNPJ&apos;.</errorMessage>
</ValidationRule>
