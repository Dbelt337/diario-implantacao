<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>BloqueiaEdicaoLeadPerdido</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
        NOT(ISNEW()),
								ISCHANGED(Status),
        ISPICKVAL(PRIORVALUE(Status), &apos;Unqualified&apos;)
    )</errorConditionFormula>
    <errorMessage>Atenção: Esse lead já está perdido, não é possível converte-lo. Necessário criar um novo!</errorMessage>
</ValidationRule>
