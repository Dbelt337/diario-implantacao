    <formulas>
        <name>isSuccess</name>
        <dataType>Boolean</dataType>
        <expression>AND({!Get_Address.responseCode} &gt;= 200, {!Get_Address.responseCode} &lt; 300)</expression>
    </formulas>
    <formulas>
        <name>Now</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>Payload</name>
        <dataType>String</dataType>
        <expression>{!GetLead.PostalCode} &amp; &quot; &quot; &amp; {!GetLead.AddressNumber__c}</expression>
    </formulas>
    <formulas>
        <name>Response</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        {!Get_Address.responseCode} &gt;= 200,
        {!Get_Address.responseCode} &lt; 300
    ),
    TEXT({!Get_Address.responseCode}) 
        &amp; &quot; &quot; &amp; {!Get_Address.2XX.neighborhood}
        &amp; &quot; &quot; &amp; TEXT({!Get_Address.2XX.lat})
        &amp; &quot; &quot; &amp; TEXT({!Get_Address.2XX.lng}),
    TEXT({!Get_Address.responseCode})
)</expression>
    </formulas>
