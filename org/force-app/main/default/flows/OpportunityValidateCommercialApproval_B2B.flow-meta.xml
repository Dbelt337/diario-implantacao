        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>OpportunityNextStage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetOpportunity.Send4Approval__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Opp_Stage</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
