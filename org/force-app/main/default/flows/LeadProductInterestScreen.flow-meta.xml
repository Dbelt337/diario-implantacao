    <formulas>
        <name>CalculatedDiscountPercent</name>
        <dataType>Number</dataType>
        <expression>IF(
    {!NegociatedPlanValue} = 0,
    0,
    IF(
        NOT(ISBLANK({!DiscountValue})),
        ({!DiscountValue} / {!NegociatedPlanValue}) * 100,
        0
    )
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CalculatedDiscountValue</name>
        <dataType>Number</dataType>
        <expression>IF(
    NOT(ISBLANK({!DiscountValue})),
    {!DiscountValue},
    IF(
        {!NegociatedPlanValue} = 0,
        0,
        ({!NegociatedPlanValue} * IF(ISBLANK({!DiscountPercent}), 0, {!DiscountPercent})) / 100
    )
)</expression>
        <scale>2</scale>
    </formulas>
