<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>QualFase</name>
        <label>Em qual fase o item foi concluído?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Sem item concluído neste ciclo</defaultConnectorLabel>
        <rules>
            <name>Viabilidade</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Viabilidade e desenho da solução</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetItem</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SLAViability__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetItem.LastModifiedDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.SLAViability__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GravarViabilidade</targetReference>
            </connector>
            <label>Viabilidade e desenho da solução</label>
        </rules>
        <rules>
            <name>ValidacaoTecnica</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Validação técnica</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetItem</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SLAArchitect__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetItem.LastModifiedDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.SLAArchitect__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GravarValidacaoTecnica</targetReference>
            </connector>
            <label>Validação técnica</label>
        </rules>
    </decisions>
    <description>Grava na oportunidade a conclusão do item de aprovação de Arquitetura (data/hora e arquiteto que concluiu), separada por fase, quando o envio para aprovação é encerrado em Viabilidade e desenho da solução ou em Validação técnica. Base dos relatórios de Performance de Arquitetura (TMEP). Os marcos de início já existem: SLAViability__c e SLAArchitect__c.</description>
    <environments>Default</environments>
    <interviewLabel>[Oportunidade] Marcos da fila de Arquitetura {!$Flow.CurrentDateTime}</interviewLabel>
    <label>[Oportunidade] Marcos da fila de Arquitetura</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetItem</name>
        <label>Último item de Arquitetura concluído</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>QualFase</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RelatedRecordId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Label</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Aprovação - Arquitetura</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>FlowOrchestrationWorkItem</object>
        <sortField>LastModifiedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>GravarViabilidade</name>
        <label>Gravar conclusão - Viabilidade</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ArchViabilityConcludedAt__c</field>
            <value>
                <elementReference>GetItem.LastModifiedDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Architect__c</field>
            <value>
                <elementReference>GetItem.LastModifiedById</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>GravarValidacaoTecnica</name>
        <label>Gravar conclusão - Validação técnica</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ArchTechValidConcludedAt__c</field>
            <value>
                <elementReference>GetItem.LastModifiedDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Architect__c</field>
            <value>
                <elementReference>GetItem.LastModifiedById</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetItem</targetReference>
        </connector>
        <filterFormula>AND(
    ISCHANGED({!$Record.Send4Approval__c}),
    NOT({!$Record.Send4Approval__c}),
    OR(
        ISPICKVAL({!$Record__Prior.StageName}, &quot;Viabilidade e desenho da solução&quot;),
        ISPICKVAL({!$Record__Prior.StageName}, &quot;Validação técnica&quot;)
    )
)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
