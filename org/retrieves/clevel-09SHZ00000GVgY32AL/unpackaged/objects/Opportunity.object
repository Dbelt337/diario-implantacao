            </values>
            <values>
                <fullName>Not yet run</fullName>
                <default>true</default>
            </values>
            <values>
                <fullName>Passed</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
    <searchLayouts>
        <customTabListAdditionalFields>OPPORTUNITY.NAME</customTabListAdditionalFields>
        <customTabListAdditionalFields>ACCOUNT.NAME</customTabListAdditionalFields>
        <customTabListAdditionalFields>OPPORTUNITY.CLOSE_DATE</customTabListAdditionalFields>
        <excludedStandardButtons>PrintableListView</excludedStandardButtons>
        <lookupDialogsAdditionalFields>OPPORTUNITY.NAME</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>ACCOUNT.NAME</lookupDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>OPPORTUNITY.NAME</lookupPhoneDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>ACCOUNT.NAME</lookupPhoneDialogsAdditionalFields>
        <searchResultsAdditionalFields>OPPORTUNITY.NAME</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>ACCOUNT.NAME</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>OPPORTUNITY.STAGE_NAME</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>OPPORTUNITY.CLOSE_DATE</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CORE.USERS.ALIAS</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>BloqueaEdicaoRelacionados</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
				NOT(ISNEW()),
				OR(
								ISPICKVAL(StageName, &apos;Viabilidade técnica&apos;),
								ISPICKVAL(StageName, &apos;Fechado/Ganho&apos;),
								ISPICKVAL(StageName, &apos;Fechado/Perdido&apos;)
				),
				OR(
								ISCHANGED(ProposalDescription__c),
								ISCHANGED(EconomicGroup__c),
								ISCHANGED(ContractId)  
				)
)</errorConditionFormula>
        <errorMessage>Atenção: não é possível editar os campos &apos;Observações da proposta&apos;, &apos;Grupo econômico&apos; e &apos;Contrato relacionado&apos; nesta fase da Oportunidade.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BloqueiaAlteracaoAguardandoContrato</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    RecordTypeName__c = &apos;B2B&apos;,
				TEXT(StageName) = &apos;Aguardando contrato&apos;,
				NOT(ISCHANGED(StageName)),
				NOT(ISCHANGED(AttachedTerm__c)),
				NOT(Bypass__c),
    NOT(ISCHANGED(Bypass__c)),
				OR(
								ISBLANK(TEXT(ContractStartType__c)),
				    ISBLANK(ContractStartDate__c),
				    ISBLANK(TEXT(ContractEndManual__c)),
								ISBLANK(TEXT(Stage__c)),
								NOT(
				        OR(
								        ISCHANGED(ContractStartType__c),
								        ISCHANGED(ContractStartDate__c),
								        ISCHANGED(ContractEndManual__c),
																ISCHANGED(ContractPendencies__c),
																ISCHANGED(Stage__c)
				        )
				    )
				)
)</errorConditionFormula>
        <errorMessage>Atenção: Durante a fase de &apos;Aguardando contrato&apos;, apenas é permitido editar as informações da seção &apos;Informações do Contrato&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BloqueiaAlteracaoAnaliseCliente</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
  RecordTypeName__c = &apos;B2B&apos;,
  NOT(ISNEW()),
  TEXT(StageName) = &apos;Análise cliente&apos;,
  Bypass__c = false,
  NOT(ISCHANGED(Bypass__c)),
  NOT(
    AND(
      NOT(ISCHANGED(StageName)),
      NOT(ISCHANGED(OverallApproval__c)),
      NOT(ISCHANGED(Bypass__c)),
      OR(
        ISCHANGED(CloseDate),
        ISCHANGED(Stage__c),
								ISCHANGED(ProposalSubmitted__c),
        ISCHANGED(Amount),
								ISCHANGED(ContractEndManual__c)
      )
    )
  )
)</errorConditionFormula>
        <errorMessage>Atenção: usuário não possui autorização para manipular o registro nesta fase.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BloqueiaAlteracaoAprovacaoComercial</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    RecordTypeName__c = &apos;B2B&apos;,
				TEXT(StageName) = &apos;Aprovação comercial&apos;,
				NOT(ISCHANGED(StageName)),
				NOT($Permission.SalesManager),
			 NOT(Bypass__c),
    NOT(ISCHANGED(Bypass__c))
)</errorConditionFormula>
        <errorMessage>Atenção: não é possível ao usuário &apos;Vendedor/GR&apos; editar uma Oportunidade/Cotação enquanto o registro está em aprovação.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BloqueiaAlteracaoAprovacaoTecnica</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
				RecordTypeName__c = &apos;B2B&apos;, 
				NOT(ISNEW()),
		  TEXT(StageName) = &apos;Viabilidade e desenho da solução&apos;,
				NOT(ISCHANGED(StageName)),
				NOT(ISCHANGED(SyncedQuoteId)),
				$Permission.Seller,
				NOT(Bypass__c),
				NOT(ISCHANGED(Bypass__c))
)</errorConditionFormula>
        <errorMessage>Atenção: usuário não possui autorização para editar este registro nesta fase</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BloqueiaAlteracaoCluster</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
TEXT($User.Cluster__c) != TEXT(Cluster__c),
TEXT(PRIORVALUE(Cluster__c)) != TEXT(Cluster__c),
NOT(ISBLANK(TEXT(PRIORVALUE(Cluster__c))))
)</errorConditionFormula>
        <errorMessage>Atenção: não é possível criar ou editar registros que não sejam do seu cluster. Contate o administrador para suporte</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BloqueiaAlteracaoContaVendedor</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    RecordTypeName__c = &apos;B2B&apos;,
				NOT(ISNEW()),
    ISCHANGED(AccountId),
				$Permission.SalesmanGR 
)</errorConditionFormula>
        <errorMessage>Atenção: não é possível realizar a alteração da Conta de uma Oportunidade.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BloqueiaAlteracaoManualFase</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
				RecordTypeName__c = &apos;B2B&apos;,
				ISCHANGED(StageName),
				NOT(Bypass__c)
)</errorConditionFormula>
        <errorMessage>Atenção: não é possível editar manualmente a fase do registro.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BloqueiaAlteracaoRevisaoDiretoria</fullName>
        <active>true</active>
        <description>W0382 - impede edicao da Oportunidade enquanto a aprovacao esta com C-Level ou Head.</description>
        <errorConditionFormula>AND(
    RecordTypeName__c = &apos;B2B&apos;,
    NOT(ISNEW()),
    OR(
        ISPICKVAL(ResponsibleTeam__c, &apos;C-Level&apos;),
        ISPICKVAL(ResponsibleTeam__c, &apos;Head&apos;)
    ),
    NOT(ISCHANGED(ResponsibleTeam__c)),
    NOT(Bypass__c),
    NOT(ISCHANGED(Bypass__c))
)</errorConditionFormula>
        <errorMessage>Atencao: a Oportunidade esta em revisao pela diretoria. Enquanto isso, atue apenas no item de aprovacao.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BloqueiaAlteracaoTermoAprovado</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
				RecordTypeName__c = &apos;B2B&apos;,
				TEXT(StageName) = &apos;Contrato assinado&apos;,
				TEXT(PRIORVALUE(StageName)) = &apos;Contrato assinado&apos;,
				NOT(Bypass__c),
    NOT(ISCHANGED(Bypass__c))
)</errorConditionFormula>
        <errorMessage>Atenção: não é possível realizar edições do registro após a Oportunidade ter um termo anexado.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BloqueiaAlteracaoTipoNegociacao</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
				RecordTypeName__c = &apos;B2B&apos;,
				NOT(ISPICKVAL(StageName, &apos;Em negociação&apos;)),
				ISCHANGED(NegotiationType__c)
)</errorConditionFormula>
        <errorDisplayField>NegotiationType__c</errorDisplayField>
        <errorMessage>Atenção: não é possível editar o &apos;Tipo de negociação&apos; de uma oportunidade em andamento.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BloqueiaAvancarAnaliseClienteCamposObrig</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
				RecordTypeName__c = &apos;B2B&apos;,
    NOT(ISNEW()),
    PRIORVALUE(StageName) = &apos;Análise cliente&apos;,
    NOT(BaseContractFilled__c),
				ISCHANGED(StageName),
				OR(
				    TEXT(StageName) = &apos;Análise financeira&apos;,
								Text(StageName) = &apos;Validação técnica&apos;
				)
)</errorConditionFormula>
        <errorMessage>Atenção: Necessário preencher os campos obrigatórios da fase &apos;Análise cliente&apos; para avançar a fase.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BloqueiaCamposViabilidadeFechado</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
				OR(
								ISPICKVAL(StageName, &apos;Viabilidade técnica&apos;),
        ISPICKVAL(StageName, &apos;Fechado/Ganho&apos;),
				    ISPICKVAL(StageName, &apos;Fechado/Perdido&apos;)
				),
				OR(
				    ISCHANGED(ProposalDescription__c),
								ISCHANGED(LinkEconomicGroup__c),
								ISCHANGED(RelatedContract__c)
    )
)</errorConditionFormula>
        <errorMessage>Atenção: Não é permitido alterar os campos &apos;Observações da Proposta&apos;, &apos;Vincular ao grupo econômico&apos; ou &apos;Contrato relacionado&apos; nesta fase da Oportunidade</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BloqueiaEdicaoFechadoPerdido</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
    AND(
        NOT(ISNEW()),
				    NOT(ISCHANGED(StageName)),
				    TEXT(StageName) = &apos;Fechado/Perdido&apos;,
				    NOT(Bypass__c),
        NOT(ISCHANGED(Bypass__c))
    ),
    AND(
        NOT(ISNEW()),
        TEXT(PRIORVALUE(StageName)) = &quot;Fechado/Perdido&quot;,
        ISCHANGED(StageName)
    )
)</errorConditionFormula>
        <errorMessage>Atenção: não é possível editar a Oportunidade após ter sido perdida.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BloqueiaEdicaoLeadSource</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    NOT(ISNEW()),
				LeadConverted__c,
				ISCHANGED(LeadSource)
)</errorConditionFormula>
        <errorDisplayField>LeadSource</errorDisplayField>
        <errorMessage>Atenção: o campo &apos;Origem do Lead&apos; não pode ser modificado na Oportunidade.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BloqueiaEdicaoOportunidadeGanha</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
				NOT(ISNEW()),
				NOT(Bypass__c),
				NOT(
        AND(
            ISCHANGED(Bypass__c),
            PRIORVALUE(Bypass__c) = true
        )
    ),
				OR(
								AND(
												TEXT(StageName) = &apos;Instalado&apos;,
												NOT(ISCHANGED(StageName))
								),
								AND(
												TEXT(PRIORVALUE(StageName)) = &quot;Instalado&quot;,
            ISCHANGED(StageName)
								)
				)
)</errorConditionFormula>
        <errorMessage>Atenção: não é possível manipular dados de uma Oportunidade que já está fechada</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ImpedeTrocaProprietario</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    NOT(ISNEW()),
    ISCHANGED(OwnerId),
    RecordTypeName__c = &apos;B2B&apos;,
    NOT(
        OR(
            $Profile.Name = &quot;Admin Acesso&quot;,
            $Profile.Name = &quot;Administrador do sistema&quot;,
            $Profile.Name = &quot;B2B - Backoffice&quot;
        )
    )
)</errorConditionFormula>
        <errorMessage>Atenção: Você não tem permissão para alterar o proprietário desta Oportunidade.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>LossReasonRequired</fullName>
        <active>true</active>
        <description>Regra de validação para preenchimento do motivo de perda quando alterar a fase da oportunidade para fechada/perdida</description>
        <errorConditionFormula>AND(
    ISPICKVAL(StageName, &quot;Fechado/Perdido&quot;),
    ISBLANK(TEXT( LossReason__c )),
    $RecordType.Name = &quot;B2C&quot;
)</errorConditionFormula>
        <errorMessage>É obrigatório preencher o campo &quot;Motivo de Perda&quot; quando a Fase for &quot;Fechado/Perdido&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ObrigaCamposAprovacaoTermo</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
				ISPICKVAL(StageName, &apos;Termo aprovado&apos;),
				OR(
				    ISBLANK(TEXT(ContractStartType__c)),
								ISBLANK(ContractStartDate__c),
								ISBLANK(TEXT(DeliveryTerm__c))
    )
)</errorConditionFormula>
        <errorMessage>Atenção: Necessário preencher os campos  &apos;Início do contrato&apos;, &apos;Data de início do contrato&apos;, &apos;Renovação automática&apos;, &apos;Prazo do contrato&apos; para seguir com a Oportunidade.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ObrigaCamposFechadoPerdido</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
				ISPICKVAL(StageName, &apos;Fechado/Perdido&apos;),
				NOT(Bypass__c),
				OR(
								ISBLANK(TEXT(CancellationType__c)),
								ISBLANK(CancellationDetails__c )
				)
)</errorConditionFormula>
        <errorMessage>Atenção: Necessário preencher o &apos;Motivo de cancelamento&apos; e &apos;Descrição do cancelamento&apos; para finalizar a Oportunidade.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ObrigaCamposViabilidadeTecnica</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
    ISPICKVAL(StageName, &apos;Viabilidade técnica&apos;),
				ISBLANK(TEXT(ViabilityType__c))
)</errorConditionFormula>
        <errorDisplayField>ViabilityType__c</errorDisplayField>
        <errorMessage>Atenção: Necessário preencher o &apos;Tipo de Viabilidade&apos; para seguir com a Oportunidade.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ObrigaTipoEmNegociacao</fullName>
        <active>false</active>
        <description>W0382 - exige o campo Tipo na fase Em negociacao. Ativar apos backfill.</description>
        <errorConditionFormula>AND(
    RecordTypeName__c = &apos;B2B&apos;,
    TEXT(StageName) = &apos;Em negociação&apos;,
    ISBLANK(TEXT(Type)),
    NOT(Bypass__c)
)</errorConditionFormula>
        <errorMessage>Atencao: informe o campo Tipo antes de prosseguir.</errorMessage>
    </validationRules>
