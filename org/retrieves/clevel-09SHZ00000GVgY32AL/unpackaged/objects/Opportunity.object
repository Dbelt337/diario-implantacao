    <fields>
        <fullName>RestartSale__c</fullName>
        <label>Retomar Venda</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Url</type>
    </fields>
    <fields>
        <fullName>SLAArchitect__c</fullName>
        <label>Início Arquitetura</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>SLAViabilityArch__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
  ISBLANK(SLAViability__c),
  &quot;&quot;,
  TEXT( FLOOR( MAX(0, (NOW() - SLAViability__c) * 86400) / 3600 ) ) &amp;
  &quot;:&quot; &amp;
  RIGHT(
    &quot;00&quot; &amp;
    TEXT( MOD( FLOOR( MAX(0, (NOW() - SLAViability__c) * 86400) / 60 ), 60 ) ),
    2
  ) &amp;
  &quot;:&quot; &amp;
  RIGHT(
    &quot;00&quot; &amp;
    TEXT( MOD( FLOOR( MAX(0, (NOW() - SLAViability__c) * 86400) ), 60 ) ),
    2
  )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>SLA Viabilidade arquitetura</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SLAViability__c</fullName>
        <label>Início Viabilidade</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
