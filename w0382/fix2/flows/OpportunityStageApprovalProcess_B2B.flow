    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>AssignFail</name>
        <label>Assign Fail</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>approvalStage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>reprovada</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>HasManagerAccount</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>AssignManager</name>
        <label>Assign Manager</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>RecipientId</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>GetOpportunity.ManagerAccount__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>GetNotifications</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>AssignOwner</name>
        <label>Assign Owner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>RecipientId</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>GetOpportunity.OwnerId</elementReference>
            </value>
        </assignmentItems>
        <connector>
