    </assignments>
    <constants>
        <name>Approved</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Approve</stringValue>
        </value>
    </constants>
    <constants>
        <name>Rejected</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Reject</stringValue>
        </value>
    </constants>
    <decisions>
        <name>ApprovalProcessPhases</name>
        <label>Approval Phases - Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Return approval step</defaultConnectorLabel>
        <rules>
            <name>SendStage_AprovacaoTecnica</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>oppStage</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Viabilidade e desenho da solução</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetOpportunity.ResponsibleTeam__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Arquitetura</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ValidateStage_AprovacaoTecnica</targetReference>
            </connector>
            <label>Aprovação técnica</label>
        </rules>
        <rules>
            <name>SendStage_AprovacaoTecnica_CLevel</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>oppStage</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Validação técnica</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetOpportunity.ResponsibleTeam__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>C-Level</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetOpportunity.ResponsibleTeam__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Head</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ValidateStage_AprovacaoTecnica_CLevel</targetReference>
            </connector>
            <label>Aprovação diretoria</label>
        </rules>
        <rules>
            <name>SendStage_AprovacaoComercial</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>oppStage</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Aprovação comercial</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ValidateStage_AprovacaoComercial</targetReference>
            </connector>
            <label>Aprovação comercial</label>
        </rules>
        <rules>
            <name>SendStage_AprovacaoCredito</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>oppStage</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Aprovação crédito</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ValidateStage_AprovacaoCredito</targetReference>
            </connector>
            <label>Aprovação crédito</label>
        </rules>
        <rules>
            <name>SendStage_ValidacaoTecnica</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>oppStage</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Validação técnica</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ValidateStage_ValidacaoTecnica</targetReference>
            </connector>
            <label>Validação técnica</label>
        </rules>
    </decisions>
    <decisions>
        <name>HasManagerAccount</name>
        <label>Has Manager Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>GetNotifications</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetOpportunity.ManagerAccount__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AssignManager</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
