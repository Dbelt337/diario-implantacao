<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>InApprovalPhase</name>
        <label>Approval Opportunity Stage</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Stage_AprovacaoTecnica</name>
            <conditionLogic>1 OR (2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Viabilidade e desenho da solução</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Validação técnica</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.BackofficeForm__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SendApproval_Arquitetura</targetReference>
            </connector>
            <label>Aprovação técnica</label>
        </rules>
        <rules>
            <name>Stage_AprovacaoComercial</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Aprovação comercial</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SendApproval_AprovacaoComercial</targetReference>
            </connector>
            <label>Aprovação comercial</label>
        </rules>
        <rules>
            <name>Stage_AprovacaoCredito</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Aprovação crédito</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SendApproval_AprovacaoCredito</targetReference>
            </connector>
            <label>Aprovação crédito</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>[Oportunidade] {!$Flow.CurrentDateTime}</interviewLabel>
    <label>[Oportunidade] Controle de filas aprovação</label>
    <orchestratedStages>
        <name>SendApproval_AprovacaoComercial</name>
        <label>Send Approval - Comercial</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>UpdateApproval_AprovacaoComercial</targetReference>
        </connector>
        <exitConditionLogic>and</exitConditionLogic>
        <stageSteps>
            <name>ApprovalStep_AprovacaoComercial</name>
            <actionName>standard_approvals__EvaluateApproval</actionName>
            <actionType>stepApproval</actionType>
            <assignees>
                <assignee>
                    <elementReference>$Record.ManagerAccount__r.Username</elementReference>
                </assignee>
                <assigneeType>Resource</assigneeType>
            </assignees>
            <canAssigneeEdit>true</canAssigneeEdit>
            <entryConditionLogic>and</entryConditionLogic>
            <exitConditionLogic>and</exitConditionLogic>
            <inputParameters>
                <name>ActionInput__RecordId</name>
                <value>
                    <elementReference>$Record.Id</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>ActionInput__CustomEmailSubject</name>
            </inputParameters>
            <inputParameters>
                <name>ActionInput__CustomEmailBody</name>
            </inputParameters>
            <label>Aprovação - Comercial</label>
            <requiresAsyncProcessing>false</requiresAsyncProcessing>
            <runAsUser>false</runAsUser>
            <shouldLock>true</shouldLock>
            <stepSubtype>ApprovalStep</stepSubtype>
        </stageSteps>
    </orchestratedStages>
