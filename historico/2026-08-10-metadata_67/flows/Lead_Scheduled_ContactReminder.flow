<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Intervalo</name>
        <label>Fijar intervalo de recordatorio</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varIntervaloHoras</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_CMT.ReminderIntervalHours__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Ultimo_Recordatorio</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Debe_Recordar</name>
        <label>¿Debe recibir recordatorio?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No aplica (contacto/recordatorio reciente u owner cola)</defaultConnectorLabel>
        <rules>
            <name>Si_Recordar</name>
            <conditionLogic>1 AND (2 OR 3) AND 4</conditionLogic>
            <conditions>
                <leftValueReference>ownerEsUsuario</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.LastContactAttemptDate__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.LastContactAttemptDate__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>umbralContacto</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Ultimo_Recordatorio</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Crear_Task_Recordatorio</targetReference>
            </connector>
            <label>Sí recordar</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tiene_CMT</name>
        <label>¿Encontró CMT?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Sin CMT — abortar</defaultConnectorLabel>
        <rules>
            <name>Si_CMT</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_CMT.ReminderIntervalHours__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Intervalo</targetReference>
            </connector>
            <label>Sí tiene CMT</label>
        </rules>
    </decisions>
    <description>Genera recordatorios automáticos al asesor cuando un Lead activo no ha recibido contacto ni recordatorio reciente (intervalo en Lead_SLA_Config__mdt.ReminderIntervalHours__c). V2: el &quot;último recordatorio&quot; se lee de la Task de recordatorio (IsReminder__c) en vez de actualizar el Lead — el flujo ya no ejecuta ningún update de Lead, eliminando los choques con validation rules y picklists restringidas sobre datos antiguos. Los logs de falla truncan el FaultMessage para no exceder el límite del campo.</description>
    <environments>Default</environments>
    <formulas>
        <name>fFallaTruncada</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Flow.FaultMessage}, 3000)</expression>
    </formulas>
    <formulas>
        <name>ownerEsUsuario</name>
        <dataType>Boolean</dataType>
        <expression>BEGINS({!$Record.OwnerId}, &quot;005&quot;)</expression>
    </formulas>
    <formulas>
        <name>umbralContacto</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.CurrentDateTime} - ({!varIntervaloHoras} / 24)</expression>
    </formulas>
    <interviewLabel>Lead_Scheduled_ContactReminder {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead_Scheduled_ContactReminder</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Crear_Task_Recordatorio</name>
        <label>Crear Task de recordatorio</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Log_Falla_Task</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>IsReminder__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Recordatorio: Volver a contactar al cliente</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>Log_Falla_CMT</name>
        <label>Log Falla CMT</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>fFallaTruncada</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Lead_Sched_RecordatorioContacto: error leyendo CMT Lead_SLA_Config__mdt</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>Log_Falla_Task</name>
        <label>Log Falla Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>fFallaTruncada</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Lead_Sched_RecordatorioContacto: error creando task de recordatorio</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_CMT</name>
        <label>Get CMT SLA Config</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Tiene_CMT</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falla_CMT</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Default_Bandeja</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead_SLA_Config__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Ultimo_Recordatorio</name>
        <label>Get Ultimo Recordatorio Reciente</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Debe_Recordar</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhoId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsReminder__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>CreatedDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>umbralContacto</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Task</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_CMT</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>No contactado</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <schedule>
            <dayOfMonthToRun>0</dayOfMonthToRun>
            <frequency>Daily</frequency>
            <frequencyNumber>0</frequencyNumber>
            <startDate>2026-07-05</startDate>
            <startTime>09:15:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varIntervaloHoras</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>24.0</numberValue>
        </value>
    </variables>
</Flow>
