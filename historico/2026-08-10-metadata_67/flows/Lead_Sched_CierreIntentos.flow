<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Preparar_Cierre</name>
        <label>Preparar campos de cierre</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Leads.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No calificado</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Leads.DiscardReason__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Sin respuesta del cliente</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varLeadsACerrar</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Leads</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCerrados</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Leads</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Hay_Leads</name>
        <label>¿Hay leads para cerrar?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Sin leads — fin</defaultConnectorLabel>
        <rules>
            <name>Si_Hay</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Leads_Con_Max_Intentos</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Leads</targetReference>
            </connector>
            <label>Sí hay leads</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tiene_CMT</name>
        <label>¿Encontró CMT?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Sin CMT — abortar</defaultConnectorLabel>
        <rules>
            <name>Si_CMT</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_CMT.MaxContactAttempts__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Leads_Con_Max_Intentos</targetReference>
            </connector>
            <label>Sí tiene CMT</label>
        </rules>
    </decisions>
    <description>Cierra automáticamente como &quot;No calificado&quot; (con Motivo de Descarte = &quot;Sin respuesta del cliente&quot;) los leads que superaron el máximo de intentos de contacto configurado en Lead_SLA_Config__mdt (Default: 7) Y cuyo último intento fue hace más de 24 horas.
El Motivo de Descarte solo aplica al estado No calificado, por eso se usa ese estado en vez de No contactado.
Corre diariamente a las 06:00 UTC. La transición En contacto → No calificado es válida y aporta el motivo, por lo que pasa la validación de Lead_BS_TransicionEstado.
Patrón bulk: acumula colección → un solo DML Update.</description>
    <environments>Default</environments>
    <formulas>
        <name>hace24h</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.CurrentDateTime} - (24 / 24)</expression>
    </formulas>
    <interviewLabel>Lead_Sched_CierreIntentos {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead_Sched_CierreIntentos</label>
    <loops>
        <name>Loop_Leads</name>
        <label>Loop Leads a cerrar</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Leads_Con_Max_Intentos</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Preparar_Cierre</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Cerrar_Leads_Bulk</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Log_Falla_CMT</name>
        <label>Log Falla CMT</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Lead_Sched_CierreIntentos: error leyendo CMT Lead_SLA_Config__mdt</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>Log_Falla_Query</name>
        <label>Log Falla Query</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Lead_Sched_CierreIntentos: error en query de leads con máx intentos</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>Log_Falla_Update</name>
        <label>Log Falla Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Lead_Sched_CierreIntentos: error en DML bulk cierre de leads</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_CMT</name>
        <label>Get CMT SLA Config</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Tiene_CMT</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falla_CMT</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Default_Bandeja</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead_SLA_Config__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Leads_Con_Max_Intentos</name>
        <label>Get Leads con máx intentos + 24h vencidas</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Hay_Leads</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falla_Query</targetReference>
        </faultConnector>
        <filterLogic>1 AND 2 AND 3 AND 4</filterLogic>
        <filters>
            <field>ContactAttempts__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>Get_CMT.MaxContactAttempts__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>LastContactAttemptDate__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>hace24h</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>En contacto</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Lead</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Cerrar_Leads_Bulk</name>
        <label>Cerrar Leads (bulk)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Log_Falla_Update</targetReference>
        </faultConnector>
        <inputReference>varLeadsACerrar</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_CMT</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-07-01</startDate>
            <startTime>06:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>varCerrados</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varLeadsACerrar</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
    <variables>
        <name>varLeadUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
</Flow>
