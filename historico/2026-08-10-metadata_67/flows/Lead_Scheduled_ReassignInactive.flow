    <recordCreates>
        <name>Log_Sem_Fila</name>
        <label>Log No Queue</label>
        <locationX>2426</locationX>
        <locationY>576</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>The inactivity sweep ran but the escalation queue (EscalationQueueDevName__c) is not configured in the Default_Bandeja CMDT. Nothing was reassigned. Configure the queue.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
