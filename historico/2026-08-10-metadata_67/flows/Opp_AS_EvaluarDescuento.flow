    <decisions>
        <name>Aprobador_Resuelto</name>
        <label>Aprobador Resuelto?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Default</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No resuelto</defaultConnectorLabel>
        <rules>
            <name>R_Resuelto</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_User.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Aprobador</targetReference>
            </connector>
            <label>Resuelto</label>
        </rules>
    </decisions>
    <decisions>
        <name>Es_Exonerada</name>
        <label>Venta Exonerada?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Evaluar_Nivel</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Normal</defaultConnectorLabel>
        <rules>
            <name>R_Exonerada</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.VentaExonerada__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>A_TopesExonerados</targetReference>
            </connector>
            <label>Exonerada</label>
        </rules>
    </decisions>
    <decisions>
        <name>Evaluar_Nivel</name>
        <label>Evaluar Nivel</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>A_NoPermitido</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Permitido</defaultConnectorLabel>
        <rules>
            <name>R_Aprobado</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.DiscountRequested__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>vMaxSinAprob</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>A_Aprobado</targetReference>
            </connector>
            <label>Aprobado</label>
        </rules>
        <rules>
            <name>R_N1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.DiscountRequested__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>vMaxGerVentas</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>A_N1</targetReference>
            </connector>
            <label>Requiere Nivel 1</label>
        </rules>
        <rules>
            <name>R_N2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.DiscountRequested__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>vMaxGerMarca</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>A_N2</targetReference>
            </connector>
            <label>Requiere Nivel 2</label>
        </rules>
    </decisions>
    <decisions>
        <name>Matrix_OK</name>
        <label>Matriz devolvió fila?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>A_FailSafe</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sin fila (fail-safe)</defaultConnectorLabel>
        <rules>
            <name>R_ConFila</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vMaxSinAprob</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Es_Exonerada</targetReference>
            </connector>
            <label>Con fila</label>
        </rules>
    </decisions>
    <decisions>
        <name>NotifType_OK</name>
        <label>NotifType existe?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Alert_Notif</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No existe</defaultConnectorLabel>
        <rules>
            <name>R_NotifOK</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_NotifType.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Recipient</targetReference>
            </connector>
            <label>Existe</label>
        </rules>
    </decisions>
    <decisions>
        <name>Requiere_Aprob</name>
        <label>Requiere Aprobacion?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No (Aprobado / No Permitido)</defaultConnectorLabel>
        <rules>
            <name>R_Requiere</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>vDecision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RequiereNivel1</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vDecision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RequiereNivel2</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Config</targetReference>
            </connector>
            <label>Requiere</label>
        </rules>
    </decisions>
    <description>HU-025 H6 v2. Re-evalua en cada cambio de DiscountRequested__c (ISNEW/ISCHANGED). Invoca Decision Matrix (runDecisionMatrix) con TipoVenta derivado del RecordType. Escalera Asesor-&gt;GerVentas-&gt;GerMarca (nivel VP eliminado; tokens VP_* huerfanos). Null-safe: sin fila en matriz =&gt; RequiereNivel1 fail-safe; sin CMDT/User =&gt; aprobador default + Task. Estampa Decision/Key y LIMPIA DiscountApprover__c antes de re-resolverlo, garantizando la transicion que relanza Opp_RT_Discount_Approval en cada solicitud. Set_Aprobador ocurre ANTES de la notificacion; notificacion con fault path.</description>
    <environments>Default</environments>
    <formulas>
        <name>fMarca</name>
        <dataType>String</dataType>
        <expression>UPPER(TEXT({!$Record.Brand__c}))</expression>
    </formulas>
    <formulas>
        <name>fNotifBody</name>
        <dataType>String</dataType>
        <expression>&quot;La oportunidad &quot; &amp; {!$Record.Name} &amp; &quot; requiere tu aprobación de descuento (&quot; &amp; {!$Record.DiscountApprovalDecision__c} &amp; &quot;).&quot;</expression>
    </formulas>
    <formulas>
        <name>fTipoVenta</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!$Record.RecordType.DeveloperName}, &quot;Motos&quot;), &quot;Motos&quot;,
IF(CONTAINS({!$Record.RecordType.DeveloperName}, &quot;Flotas&quot;), &quot;Flotas&quot;,
IF(CONTAINS({!$Record.RecordType.DeveloperName}, &quot;Mayorista&quot;), &quot;Mayorista&quot;,
IF(CONTAINS({!$Record.RecordType.DeveloperName}, &quot;Repuestos&quot;), &quot;Repuestos&quot;,
&quot;Autos&quot;))))</expression>
    </formulas>
    <interviewLabel>Opp_AS_EvaluarDescuento {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opp_AS_EvaluarDescuento</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Alert_Notif</name>
        <label>Alerta Notificacion Fallida</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Descuento: notificación al aprobador falló - revisar CustomNotificationType Opp_Discount_Approver</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>Alert_Task</name>
        <label>Alerta Aprobador No Resuelto</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Descuento: aprobador no resuelto - revisar Aprobador_Config</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Config</name>
        <label>Get Aprobador Config</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_User</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>vRol</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Aprobador_Config__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_NotifType</name>
        <label>Get Notif Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>NotifType_OK</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Opp_Discount_Approver</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_User</name>
        <label>Get Aprobador User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Aprobador_Resuelto</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Username</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Config.Username__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Estampar</name>
        <label>Estampar Resultado en Opp</label>
        <locationX>0</locationX>
