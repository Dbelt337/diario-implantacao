            <name>RolGerVentas</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>vRolGerMarca</assignToReference>
            <name>RolGerMarca</name>
        </outputParameters>
    </actionCalls>
    <actionCalls>
        <name>Notificar_Aprobador</name>
        <label>Notificar Aprobador</label>
        <locationX>0</locationX>
