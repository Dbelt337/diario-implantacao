    <recordUpdates>
        <name>Set_Default</name>
        <label>Set Aprobador Default</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Alert_Task</targetReference>
        </connector>
        <inputAssignments>
            <field>DiscountApprover__c</field>
            <value>
                <stringValue>005WK00000MzRGSYA3</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
