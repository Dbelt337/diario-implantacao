            </value>
        </inputAssignments>
        <inputAssignments>
            <name>activityDetails</name>
            <value>
                <stringValue>Cancelación de la asignación excepcional. Estado y ubicación sin cambios (Esc.11).</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>taskOwnerId</name>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>taskStatus</name>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>vehicleId</name>
            <value>
                <elementReference>GetVehicle.Id</elementReference>
            </value>
        </inputAssignments>
