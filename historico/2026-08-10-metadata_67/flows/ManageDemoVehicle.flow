    <status>Active</status>
    <subflows>
        <name>LogAssignment</name>
        <label>Subflow: Log Demo Activity (Assignment)</label>
        <locationX>842</locationX>
        <locationY>782</locationY>
        <connector>
            <targetReference>ConfirmationScreen</targetReference>
        </connector>
        <flowName>LogDemoActivity</flowName>
        <inputAssignments>
            <name>actionType</name>
            <value>
                <stringValue>Asignación</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>activityDetails</name>
            <value>
                <stringValue>Asignación excepcional de unidad demo a asesor (ventana de 8h hábiles). La Task abierta, cuyo dueño es el asesor, ES la asignación; ningún dueño de registro cambia (el vehículo es de GrupoQ).</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>taskOwnerId</name>
            <value>
                <elementReference>AdvisorId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>taskStatus</name>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>vehicleId</name>
            <value>
                <elementReference>GetVehicle.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>LogCancellation</name>
