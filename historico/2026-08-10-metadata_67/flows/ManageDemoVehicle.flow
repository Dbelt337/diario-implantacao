            </value>
        </inputAssignments>
        <inputAssignments>
            <name>designationType</name>
            <value>
                <elementReference>DesignationType</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>isQuotaAvailable</assignToReference>
            <name>isQuotaAvailable</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>resultMessage</assignToReference>
            <name>resultMessage</name>
        </outputAssignments>
    </subflows>
