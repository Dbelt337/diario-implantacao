    <decisions>
        <name>IsBrandSeen</name>
        <label>Decision: Brand Already Seen?</label>
        <locationX>358</locationX>
        <locationY>890</locationY>
        <defaultConnector>
            <targetReference>AddUniqueBrand</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>New brand</defaultConnectorLabel>
        <rules>
            <name>BrandSeen</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>seenBrands</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>BrandLoop.Brand__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>BrandLoop</targetReference>
            </connector>
            <label>Seen</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsQuotaOk</name>
        <label>Decision: Quota Available?</label>
        <locationX>182</locationX>
        <locationY>1814</locationY>
        <defaultConnector>
            <targetReference>QuotaFullScreen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Quota full</defaultConnectorLabel>
        <rules>
            <name>QuotaOk</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isQuotaAvailable</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>LogDesignationRequest</targetReference>
            </connector>
            <label>Available</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsUnitEligible</name>
        <label>Decision: Unit Eligible for Designation?</label>
        <locationX>380</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>NotEligibleScreen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not eligible</defaultConnectorLabel>
        <rules>
            <name>UnitEligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetVehicle.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>En ubicación de concesionario</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetQuotaBrands</targetReference>
            </connector>
            <label>Eligible (available at dealer)</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsUnitFound</name>
        <label>Decision: Unit Found?</label>
        <locationX>1254</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>UnitNotFoundScreen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not found</defaultConnectorLabel>
        <rules>
            <name>UnitFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetVehicle</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>WhichAction</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>WhichAction</name>
        <label>Decision: Which Action?</label>
        <locationX>875</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>CancelScreen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Cancel</defaultConnectorLabel>
        <rules>
            <name>DoRequest</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RequestedAction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>REQUEST</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IsUnitEligible</targetReference>
            </connector>
            <label>Request designation</label>
        </rules>
        <rules>
            <name>DoAssign</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RequestedAction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ASSIGN</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AssignScreen</targetReference>
            </connector>
            <label>Assign to advisor</label>
        </rules>
        <rules>
            <name>DoRelease</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RequestedAction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RELEASE</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>LogReleaseRequest</targetReference>
            </connector>
            <label>Release for sale</label>
        </rules>
    </decisions>
    <description>Management screen for the demo vehicle lifecycle (HU-046, RN-3/4/5/6/8/9). All countries. One screen with four branches: request designation (validates quota, creates floor manager Task + alert), assign/REASSIGN advisor (Esc.6: assigning first CLOSES any prior open assignment Task of the unit, then creates the new advisor-owned Task - single active assignment at a time; Task-based: the open [Demo] Asignacion Task owned by the ADVISOR is the assignment marker; NO record owner changes - the vehicle belongs to GrupoQ: Asset.AccountId = sociedad, Vehicle.CurrentOwnerId = dealer, both untouched), release for sale (request Task + alert), cancel exceptional assignment (closes the open assignment Task, nothing else changes). Entry restricted by the RequestDemoVehicle custom permission (component visibility). ELIGIBILITY v2 (07/08): the request branch only accepts units whose Vehicle.Status = &quot;En ubicación de concesionario&quot; (available at dealer - the SAP-load arrival state); any other status shows the Not Eligible screen with the current state. To widen the eligible set, add values to the IsUnitEligible decision. UX 07/08: brand/branch are now cascading dropdowns fed by the CR quota CMDT records (unique brands via dedupe loop; branches filtered by selected brand) - impossible to request a combination without a quota row. TODO-DAVI: (1) unit selected by typed VIN - evolve to CBSF search (T01); (2) brand/branch typed - derive from the Vehicle record; (3) GetUnitsInTargetStatus filters only by Status - add brand and branch filters; (4) RESOLVED 06/08: floor manager is now a required User dropdown (EncargadoPick) on the menu screen - evolve later to a per-branch GRP_Sucursal_* default; (5) RESOLVED 06/08: AdvisorId is a User dropdown (ActiveUserChoices, IsActive=true sorted by Name) - refine the filter later (e.g., sales profile/role or branch) if the user list grows. Picklist API values verbatim from the org: En demostración (accented), En exhibicion (NOT accented). DESIGN FIX 06/08: SerializedProduct leg REMOVED (legacy of the old HU premises) - unit identity is the Vehicle (VehicleIdentificationNumber), per the Automotive Cloud model; DESIGN FIX 2 (same day, Diego): NO owner write at all - the vehicle belongs to GrupoQ; the assignment lives in the advisor-owned open Task, closed on cancel/expiry. Search matches VIN OR Name (filterLogic or).</description>
    <dynamicChoiceSets>
        <name>ActiveUserChoices</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>User</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>BranchChoices</name>
        <dataType>String</dataType>
        <displayField>BranchName__c</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Country__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>CR</stringValue>
            </value>
        </filters>
        <filters>
            <field>Brand__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>BrandPick</elementReference>
            </value>
        </filters>
        <object>DemoCapacityConfig__mdt</object>
        <sortField>BranchName__c</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>BranchName__c</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>UniqueBrandChoices</name>
        <collectionReference>uniqueBrandRecs</collectionReference>
        <dataType>String</dataType>
        <displayField>Brand__c</displayField>
        <object>DemoCapacityConfig__mdt</object>
        <valueField>Brand__c</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>targetStatus</name>
        <dataType>String</dataType>
        <expression>IF({!DesignationType} = &apos;Demo&apos;, &apos;En demostración&apos;, &apos;En exhibicion&apos;)</expression>
    </formulas>
    <interviewLabel>Manage Demo Vehicle {!$Flow.CurrentDateTime}</interviewLabel>
    <isTemplate>true</isTemplate>
    <label>Screen Flow: Manage Demo Vehicle</label>
    <loops>
        <name>BrandLoop</name>
        <label>Loop: Unique Brands</label>
        <locationX>182</locationX>
        <locationY>782</locationY>
        <collectionReference>GetQuotaBrands</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
