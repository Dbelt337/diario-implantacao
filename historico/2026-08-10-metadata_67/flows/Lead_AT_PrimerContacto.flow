    <decisions>
        <name>Es_Lead_Sin_Contacto</name>
        <label>Es Lead sin primer contacto?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No (sai)</defaultConnectorLabel>
        <rules>
            <name>Aplica</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lead.FechaPrimerContacto__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead</targetReference>
            </connector>
            <label>Es lead sin primer contacto</label>
        </rules>
    </decisions>
    <environments>Default</environments>
