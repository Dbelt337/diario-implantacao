<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>A_Aprobado</name>
        <label>Set Aprobado</label>
        <locationX>50</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>vEstado</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Aprobado</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Actualizar_Opp</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>A_Rechazado</name>
        <label>Set Rechazado</label>
        <locationX>170</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>vEstado</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Rechazado</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Actualizar_Opp</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>A_Retirado</name>
        <label>Set Retirado</label>
        <locationX>290</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>vEstado</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Retirado</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Actualizar_Opp</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>D_Estado</name>
        <label>Mapear Decision a Estado</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Debug_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Desconocido (no actualiza)</defaultConnectorLabel>
        <rules>
            <name>R_Aprobado</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>decision</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>Approve</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>A_Aprobado</targetReference>
            </connector>
            <label>Approved</label>
        </rules>
        <rules>
            <name>R_Rechazado</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>decision</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>Reject</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>A_Rechazado</targetReference>
            </connector>
            <label>Rejected</label>
        </rules>
        <rules>
            <name>R_Retirado</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>decision</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>Recall</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>A_Retirado</targetReference>
            </connector>
            <label>Recalled</label>
        </rules>
    </decisions>
    <description>HU-025 H6: estampa DiscountApprovalStatus__c en la Opportunity segun la decision del Flow Approval Process (Approved-&gt;Aprobado, Rejected-&gt;Rechazado, Recalled-&gt;Retirado). Invocado como Background Step desde la orquestacion Opp_RT_Discount_Approval. Valor desconocido -&gt; no actualiza.</description>
    <environments>Default</environments>
    <formulas>
        <name>fDebugSubject</name>
        <dataType>String</dataType>
        <expression>&quot;H6DEBUG decision=[&quot; &amp; {!decision} &amp; &quot;]&quot;</expression>
    </formulas>
    <interviewLabel>Opp_AL_SetDiscountStatus {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opp_AL_SetDiscountStatus</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Debug_Task</name>
        <label>Debug Task (valor desconocido)</label>
        <locationX>410</locationX>
        <locationY>242</locationY>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>fDebugSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordUpdates>
        <name>Actualizar_Opp</name>
        <label>Actualizar Estado en Opp</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>DiscountApprovalStatus__c</field>
            <value>
                <elementReference>vEstado</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>D_Estado</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>decision</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>vEstado</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
