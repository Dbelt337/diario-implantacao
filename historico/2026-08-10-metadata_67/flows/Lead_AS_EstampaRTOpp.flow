<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Tiene_RT_Mapeado</name>
        <label>¿Industry mapea a un RecordType?</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>No mapea</defaultConnectorLabel>
        <rules>
            <name>Si_mapea</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RT_DevName</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>RT_DevName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_RecordType</targetReference>
            </connector>
            <label>Sí</label>
        </rules>
    </decisions>
    <description>HU-025 H2: al convertir un Lead, estampa en la Opportunity convertida el RecordType correspondiente a la línea del deal, leída directamente de Lead.Industry (Autos/Motos/Frotas/Repuestos/PA). Reemplaza a Opp_BS_EstampaRecordType: como Lead.Industry es estándar y no se puede mapear a un campo custom de Opp, el before-save no tenía forma de conocer la línea; este flow la lee del Lead directo. Usados no tiene RT y Mayorista está gated: no se tocan. Además setea la etapa inicial correcta de la línea (Autos/Motos=Negociación, Frotas=Sospechoso, Repuestos/PA=Nuevo), porque la conversión nace con el RT default del convertidor y su etapa no corresponde a la línea real. Copia además MotorcycleType__c/EngineCapacity__c del Lead a la Opp para que Motos pase la VR de tipo/cilindrada al abrir en Negociación.</description>
    <environments>Default</environments>
    <formulas>
        <name>Open_Stage</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!$Record.Industry}),
&quot;Autos&quot;, &quot;Negociación&quot;,
&quot;Usados&quot;, &quot;Negociación&quot;,
&quot;Motos&quot;, &quot;Negociación&quot;,
&quot;Frotas&quot;, &quot;Sospechoso&quot;,
&quot;Repuestos&quot;, &quot;Nuevo&quot;,
&quot;PA&quot;, &quot;Nuevo&quot;,
&quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>RT_DevName</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!$Record.Industry}),
&quot;Autos&quot;, &quot;GQOpportunitiesAutos&quot;,
&quot;Usados&quot;, &quot;GQOpportunitiesUsados&quot;,
&quot;Motos&quot;, &quot;GQOpportunitiesMotos&quot;,
&quot;Frotas&quot;, &quot;GQOpportunitiesFlotas&quot;,
&quot;Repuestos&quot;, &quot;GQOpportunitiesRepuestosPA&quot;,
&quot;PA&quot;, &quot;GQOpportunitiesRepuestosPA&quot;,
&quot;&quot;)</expression>
    </formulas>
    <interviewLabel>Lead_AS_EstampaRTOpp {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead_AS_EstampaRTOpp</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Log_Failure_RT</name>
        <label>Log de fallo de estampa</label>
        <locationX>400</locationX>
        <locationY>492</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Fallo estampando RecordType en la conversion (HU-025)</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.ConvertedOpportunityId</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_RecordType</name>
        <label>Obtener RecordType destino</label>
        <locationX>176</locationX>
        <locationY>384</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Opp_RT</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Failure_RT</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Opportunity</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>RT_DevName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Opp_RT</name>
        <label>Estampar RecordType en la Opp convertida</label>
        <locationX>176</locationX>
        <locationY>492</locationY>
        <faultConnector>
            <targetReference>Log_Failure_RT</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ConvertedOpportunityId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>EngineCapacity__c</field>
            <value>
                <elementReference>$Record.EngineCapacity__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>MotorcycleType__c</field>
            <value>
                <elementReference>$Record.MotorcycleType__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>Get_RecordType.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <elementReference>Open_Stage</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Tiene_RT_Mapeado</targetReference>
        </connector>
        <filterFormula>AND(
  ISCHANGED({!$Record.IsConverted}),
  {!$Record.IsConverted},
  NOT(ISBLANK({!$Record.ConvertedOpportunityId}))
)</filterFormula>
        <object>Lead</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>60</triggerOrder>
</Flow>
