    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Look_for_Repuestos_PA_or_Autos_Motos_Usados</targetReference>
        </connector>
        <filterFormula>AND(
    NOT({!$Record.IsConverted}),
    NOT(CONTAINS(LOWER({!$User.Username}), &quot;integration&quot;)),
    OR(
        TEXT({!$Record.Industry}) = &quot;Autos&quot;,
        TEXT({!$Record.Industry}) = &quot;Motos&quot;,
        TEXT({!$Record.Industry}) = &quot;Usados&quot;,
        TEXT({!$Record.Industry}) = &quot;Repuestos&quot;,
        TEXT({!$Record.Industry}) = &quot;PA&quot;
    ),
    OR(
        ISNEW(),
        ISCHANGED({!$Record.Email}),
        ISCHANGED({!$Record.SecondaryEmail__c}),
        ISCHANGED({!$Record.Phone}),
        ISCHANGED({!$Record.SecondaryPhone__c})
    )
)</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
