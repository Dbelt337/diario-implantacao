        <defaultConnectorLabel>Owner Is Queue</defaultConnectorLabel>
        <rules>
            <name>Owner_Is_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ownerEsUsuario</leftValueReference>
