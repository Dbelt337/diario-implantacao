    <decisions>
        <name>Avalia_FA</name>
        <label>Avalia FA</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_FAccounts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Outro/Ignora</defaultConnectorLabel>
        <rules>
            <name>EhCrediQ</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_FA.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_FA.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CrediQ</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_CrediQ</targetReference>
            </connector>
            <label>Eh CrediQ ativo</label>
        </rules>
        <rules>
            <name>EhContaCorr</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_FA.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ContaCorriente</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_ContaCorr</targetReference>
            </connector>
            <label>Eh Conta Corrente</label>
        </rules>
    </decisions>
    <decisions>
        <name>Classificar_Cenario</name>
        <label>Classificar Cenario</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Scenario_SinCredito</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sin Credito</defaultConnectorLabel>
        <rules>
            <name>TemCrediQ</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTieneCrediQ</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Scenario_CrediQ</targetReference>
            </connector>
            <label>Tem CrediQ</label>
        </rules>
        <rules>
            <name>TemContaCorr</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTieneContaCorr</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Scenario_ContaCorr</targetReference>
            </connector>
            <label>Tem Conta Corrente</label>
        </rules>
    </decisions>
    <decisions>
        <name>Houve_Mudanca_Sensivel</name>
        <label>Houve Mudanca Sensivel</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Sem mudanca sensivel</defaultConnectorLabel>
        <rules>
            <name>Sim</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>houveMudancaSensivel</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>esCierreGovernanca</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_FAParty</targetReference>
            </connector>
            <label>Sim</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>esCierreGovernanca</name>
        <dataType>Boolean</dataType>
        <expression>AND(
TEXT({!$Record.SensitiveChangeStatus__c}) = &quot;Completed&quot;,
TEXT({!$Record__Prior.SensitiveChangeStatus__c}) &lt;&gt; &quot;Completed&quot;)</expression>
    </formulas>
    <formulas>
        <name>houveMudancaSensivel</name>
        <dataType>Boolean</dataType>
        <expression>IF({!$Record.IsPersonAccount},
NOT(BLANKVALUE({!$Record.PersonEmail},&quot;&quot;) = BLANKVALUE({!$Record__Prior.PersonEmail},&quot;&quot;))
|| NOT(BLANKVALUE({!$Record.PersonMobilePhone},&quot;&quot;) = BLANKVALUE({!$Record__Prior.PersonMobilePhone},&quot;&quot;))
|| NOT(BLANKVALUE({!$Record.DocumentNumber__c},&quot;&quot;) = BLANKVALUE({!$Record__Prior.DocumentNumber__c},&quot;&quot;))
|| NOT(BLANKVALUE({!$Record.PersonMailingStreet},&quot;&quot;) = BLANKVALUE({!$Record__Prior.PersonMailingStreet},&quot;&quot;))
|| NOT(BLANKVALUE({!$Record.PersonMailingCity},&quot;&quot;) = BLANKVALUE({!$Record__Prior.PersonMailingCity},&quot;&quot;)),
NOT(BLANKVALUE({!$Record.DocumentNumber__c},&quot;&quot;) = BLANKVALUE({!$Record__Prior.DocumentNumber__c},&quot;&quot;))
|| NOT(BLANKVALUE({!$Record.Phone},&quot;&quot;) = BLANKVALUE({!$Record__Prior.Phone},&quot;&quot;))
|| NOT(BLANKVALUE({!$Record.BillingStreet},&quot;&quot;) = BLANKVALUE({!$Record__Prior.BillingStreet},&quot;&quot;))
|| NOT(BLANKVALUE({!$Record.BillingCity},&quot;&quot;) = BLANKVALUE({!$Record__Prior.BillingCity},&quot;&quot;)))</expression>
    </formulas>
    <interviewLabel>Account_MDM_DadosSensiveis {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account_MDM_DadosSensiveis</label>
    <loops>
        <name>Loop_FAccounts</name>
        <label>Loop FAccounts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_FAParty</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_FA</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Classificar_Cenario</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Log_Falha</name>
        <label>Log Falha</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Falha no MDM de conta (classificacao/aprovacao)</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_FA</name>
        <label>Get FA</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Avalia_FA</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_FAccounts.FinancialAccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>FinancialAccount</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_FAParty</name>
        <label>Get FAParty</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_FAccounts</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsRoleActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>FinancialAccountParty</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Cenario</name>
        <label>Update Cenario</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Submit_Aprovacao</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Falha</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>CreditScenario__c</field>
            <value>
                <elementReference>varScenario</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Houve_Mudanca_Sensivel</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ApprovalInProgress__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varScenario</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
