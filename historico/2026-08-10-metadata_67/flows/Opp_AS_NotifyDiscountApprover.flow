<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Notificar_Aprobador</name>
        <label>Notificar Aprobador</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <elementReference>Get_NotifType.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>colRecipients</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <stringValue>Descuento pendiente de aprobación</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <elementReference>fNotifBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Recipient</name>
        <label>Add Recipient</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>colRecipients</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.DiscountApprover__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Notificar_Aprobador</targetReference>
        </connector>
    </assignments>
    <description>HU-025 H6: envia Custom Notification (in-app) al aprobador cuando se somete la aprobacion de descuento (DiscountApprovalDecision__c empieza con Requiere y DiscountApprover__c poblado). Separado de Opp_AS_EvaluarDescuento para no interferir con el trigger de la orquestacion Opp_RT_Discount_Approval.</description>
    <environments>Default</environments>
    <formulas>
        <name>fNotifBody</name>
        <dataType>String</dataType>
        <expression>&quot;La oportunidad &quot; &amp; {!$Record.Name} &amp; &quot; requiere tu aprobación de descuento (&quot; &amp; {!$Record.DiscountApprovalDecision__c} &amp; &quot;).&quot;</expression>
    </formulas>
    <interviewLabel>Opp_AS_NotifyDiscountApprover {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opp_AS_NotifyDiscountApprover</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_NotifType</name>
        <label>Get Notif Type</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Add_Recipient</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Opp_Discount_Approver</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_NotifType</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DiscountApprovalDecision__c</field>
            <operator>StartsWith</operator>
            <value>
                <stringValue>Requiere</stringValue>
            </value>
        </filters>
        <filters>
            <field>DiscountApprover__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>colRecipients</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
