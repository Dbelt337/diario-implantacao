            </value>
        </inputParameters>
        <inputParameters>
            <name>processDefinitionNameOrId</name>
            <value>
                <stringValue>Aprobacion_Datos_Sensibles_Cuenta</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>skipEntryCriteria</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <nameSegment>submit</nameSegment>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Asig_Grupo_Default</name>
        <label>Asig grupo default</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varGrupo</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Regla_Default.GrupoAprobador__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Group</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asig_Grupo_Keyed</name>
        <label>Asig grupo keyed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varGrupo</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Regla_Keyed.GrupoAprobador__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Group</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Dec_Regla_Found</name>
        <label>Regla encontrada?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Regla_Default</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No (Default)</defaultConnectorLabel>
        <rules>
            <name>Regla_Si</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Regla_Keyed.GrupoAprobador__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asig_Grupo_Keyed</targetReference>
            </connector>
            <label>Si</label>
        </rules>
    </decisions>
    <description>Subflow SYSTEM CONTEXT: grava staging + resuelve aprobador + submete a aprovacao. Chamado pelo screen flow. Permite que o vendedor NAO tenha edit em nenhum campo (governanca).</description>
    <environments>Default</environments>
    <interviewLabel>Account_SensitiveData_Submit {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - Submit Datos Sensibles (System)</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Cuenta</name>
        <label>Get Cuenta</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Staging</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Group</name>
        <label>Get Public Group</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_GroupMember</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varGrupo</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
