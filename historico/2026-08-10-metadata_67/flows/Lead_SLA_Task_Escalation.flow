    <decisions>
        <name>Verifica_Atendido</name>
        <label>Verifica Atendido</label>
        <locationX>2030</locationX>
        <locationY>276</locationY>
        <defaultConnector>
            <targetReference>Completar_Marcador</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Ja atendido ou convertido (sai)</defaultConnectorLabel>
        <rules>
            <name>Ainda_New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead</leftValueReference>
