                <stringValue>Lead reasignado por SLA</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <stringValue>Un lead supero el numero maximo de reasignaciones por SLA sin recibir primera atencion. Revise el detalle.</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
